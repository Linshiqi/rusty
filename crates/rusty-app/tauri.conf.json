{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rusty",
  "version": "0.6.0",
  "identifier": "dev.rusty.workbench",
  "build": {
    "frontendDist": "../rusty-ui/dist",
    "devUrl": "http://localhost:17425",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../rusty-ui"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../rusty-ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rusty",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGQTY5NkI1QUI2MzlEMDYKUldRR25XT3J0WmFtWDFYTW9EUjh6NGYxYkEzK1JlYmVVbUdnbnB3Y0xJbHZDZ1Nla0ZmL1Z3WHUK",
      "endpoints": [
        "https://github.com/Linshiqi/rusty-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
