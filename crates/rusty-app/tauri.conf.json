{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rusty",
  "version": "0.1.3",
  "identifier": "dev.rusty.workbench",
  "build": {
    "frontendDist": "../rusty-ui/dist",
    "devUrl": "http://localhost:1425",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../rusty-ui"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../rusty-ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rusty",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
