{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rusty",
  "version": "0.1.0",
  "identifier": "dev.rusty.workbench",
  "build": {
    "frontendDist": "../rusty-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../rusty-ui" },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../rusty-ui" }
  },
  "app": {
    "windows": [
      {
        "title": "rusty",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
