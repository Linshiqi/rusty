// What the window shows and what it can be asked to do, as one global the
// Rust side fills (`src/shell.rs`). The parts of the window read it directly
// rather than having every value threaded through every layer between.

export struct PanelTab {
    id: string,
    title: string,
    icon: string,
}

export struct DocTab {
    id: string,
    title: string,
    // The directories that tell two tabs of one name apart.
    hint: string,
    dirty: bool,
    // `file`, or the page it is: `welcome`, `settings`, …
    kind: string,
}

// A row of the project tree: an entry, or the box a name is typed in
// (`naming`) where a new entry will be or an entry is being renamed.
export struct TreeRow {
    depth: int,
    name: string,
    dir: bool,
    open: bool,
    selected: bool,
    naming: bool,
    // Cut, to be pasted somewhere: drawn faint, as VS Code draws it.
    cut: bool,
    // Inside the folder a drag would drop into.
    drop: bool,
}

export struct PickRow {
    title: string,
    detail: string,
    chord: string,
}

export struct Note {
    id: int,
    // 0 information, 1 warning, 2 error.
    level: int,
    text: string,
    action: string,
}

// A row of the Problems panel: a file (0), then its errors (1), warnings
// (2) and the rest (3); where it is, for a click to go to.
export struct ProblemRow {
    kind: int,
    text: string,
    detail: string,
    path: string,
    line: int,
    col: int,
    // A file's row: how many problems are under it.
    count: int,
}

// A line of the Output dock, and how it is drawn: as printed (0), the
// command run (1), an error (2), a warning (3), a run that ended well (4).
export struct OutputLine {
    text: string,
    kind: int,
    // The place it names, which a click goes to: a path (empty for none),
    // a line and a column counted from zero.
    path: string,
    line: int,
    col: int,
}

// A row of the Environment page: a group's heading, or a tool — its
// purpose, its version or that it is missing, whether this project needs
// it, and whether rusty can install it.
export struct EnvRow {
    header: bool,
    name: string,
    purpose: string,
    state: string,
    installed: bool,
    needed: bool,
    installable: bool,
    // What installs it: a target as `target:<triple>`, else the tool's
    // own command, shown.
    command: string,
}

// A row of a wizard step's list: a part, a runtime, an option (`check`).
export struct WizRow {
    id: string,
    title: string,
    aside: string,
    on: bool,
    check: bool,
}

export struct WizFact {
    label: string,
    value: string,
}

// What a choice commits the project to.
export struct WizNote {
    topic: string,
    detail: string,
    consequence: string,
}

// A playground the welcome page offers: the part's name and what it takes.
export struct PlaygroundCard {
    id: string,
    name: string,
    detail: string,
    // The drawing playground, which is no part's.
    drawing: bool,
}

// The board's live layer, in the sheet's own units.
export struct BoardWire {
    commands: string,
    // 0 unknown, 1 low, 2 high, 3 switching under PWM.
    tone: int,
    selected: bool,
}

// One part's drawing, placed: its picture covers this box in the sheet's
// units, and moving the part moves the picture.
export struct BoardPart {
    x: float,
    y: float,
    w: float,
    h: float,
    image: image,
    selected: bool,
}

// A property of the part the inspector shows: `max`, `addr`, a reading's
// start.
export struct BoardProp {
    key: string,
    value: string,
}

// A symbol the library offers: its id, its name and its library's.
export struct LibraryRow {
    id: string,
    name: string,
    detail: string,
}

export struct BoardWord {
    x: float,
    y: float,
    // 0 start, 1 middle, 2 end — where the text hangs off its point.
    anchor: int,
    text: string,
    size: float,
    // 0 a lead's name, 1 a reference, 2 a value; over the parts while a
    // run goes on, 3 what a screen shows, 4 a reading, 5 a reading of
    // nothing.
    kind: int,
}

export struct BoardLamp {
    x: float,
    y: float,
    r: float,
    lit: color,
    dark: color,
    // 0 dark to 1 at full current.
    light: float,
    // A strip's pixel, square rather than round.
    square: bool,
}

// Something pressed with the pointer: a switch's cap, or one key of a
// keypad. A box in the sheet's units, its corners rounded by `radius`.
export struct BoardSwitch {
    x: float,
    y: float,
    w: float,
    h: float,
    radius: float,
    held: bool,
    // The part, as the board numbers them.
    index: int,
    // A keypad's key, row by row; -1 for a switch.
    key: int,
}

// A shape drawn over the parts in the sheet's units: a digit's segment,
// a servo's horn, a sounder's ring.
export struct BoardShape {
    commands: string,
    fill: color,
    stroke: color,
    width: float,
}

// A screen's glass, in the sheet's units, and what the firmware's driver
// lit on it in the screen's own pixels.
export struct BoardScreen {
    x: float,
    y: float,
    w: float,
    h: float,
    commands: string,
    columns: float,
    rows: float,
    on: bool,
}

// A motor's rotor: turning `speed` turns a second, backwards when negative.
export struct BoardRotor {
    x: float,
    y: float,
    r: float,
    speed: float,
}

// A line of the bench under the board: a slider and what it holds — a
// knob, a source, a sensor's reading — or, without a slider, the part the
// lines after it belong to.
export struct BoardControl {
    index: int,
    key: string,
    label: string,
    slider: bool,
    min: float,
    max: float,
    value: float,
    text: string,
    tip: string,
    // Moving it reaches the firmware: a run is going.
    live: bool,
}

// The Signals tab: a source on the sheet, what it plays, and why the text
// would not read.
export struct LabSource {
    label: string,
    text: string,
    picked: bool,
    error: string,
}

// A preset signal: its id, and its name in the window's language.
export struct LabPreset {
    id: string,
    name: string,
}

// A console channel's heading (`axis` -1) or one of its axes.
export struct LabConsole {
    name: string,
    unit: string,
    axis: int,
    text: string,
}

// A lane of the Time view: what it is, its colour, its path across a
// thousand units by a hundred, and the range it is drawn over.
export struct LabLane {
    label: string,
    ink: color,
    commands: string,
    scale: string,
}

// A record offered to an instrument, or a choice of kind.
export struct LabRecord {
    label: string,
    ink: color,
    on: bool,
}

// A frequency marked on an axis, `at` of its width.
export struct LabTick {
    at: float,
    text: string,
}

// A measured point, in a chart's thousand by a hundred.
export struct LabDot {
    x: float,
    y: float,
}

// A field of the sweep's plan or the design's parameters.
export struct LabParam {
    label: string,
    text: string,
}

export struct CodeSpan {
    text: string,
    kind: int,
}

export struct CodeLine {
    spans: [CodeSpan],
}

export struct MdCell {
    text: styled-text,
    header: bool,
}

export struct MdRow {
    cells: [MdCell],
}

// A block: 0 text (a paragraph, or a list item with its marker and depth),
// 1 a heading of `level`, 2 code (`marker` its language), 3 a rule, 4 a
// table.
export struct MdBlock {
    kind: int,
    text: styled-text,
    level: int,
    quote: int,
    depth: int,
    marker: string,
    lines: [CodeLine],
    rows: [MdRow],
    // A picture (kind 5), when it could be read; `marker` says what it is.
    image: image,
    shown: bool,
}

// A row of the math sheet: its field, its colour in the view, what it came
// to or why it came to nothing, and a slider for a row that is one number.
export struct MathRow {
    text: string,
    colour: color,
    hidden: bool,
    selected: bool,
    value: string,
    problem: string,
    notes: string,
    live: bool,
    slider: bool,
    min: float,
    max: float,
    at: float,
    shown: string,
}

// A step of the selected row's working.
export struct MathStep {
    index: int,
    title: string,
    lines: string,
    remarks: string,
    chosen: bool,
}

// A labelled line: of a value's readout, or of the reference.
export struct MathLine {
    label: string,
    value: string,
}

// A line of the assistant's transcript: 0 a question (with what was
// attached), 1 an answer's blocks, 2 reasoning (unfolded when `open`), 3 a
// tool call (state 0 running, 1 done, 2 failed; `attached` its input), 4 a
// note under the answer.
export struct AiEntry {
    kind: int,
    index: int,
    text: string,
    attached: string,
    blocks: [MdBlock],
    state: int,
    open: bool,
}

// A figure about the workspace.
export struct CrateVital {
    label: string,
    value: string,
    hint: string,
}

// A direct dependency against crates.io.
export struct CrateDep {
    name: string,
    current: string,
    latest: string,
    note: string,
    behind: bool,
}

// A crate resolved at more than one version, a line per version saying who
// pulled it in.
export struct CrateDup {
    name: string,
    versions: string,
    unifiable: bool,
}

export struct FeatPackage {
    name: string,
    count: int,
    chosen: bool,
}

// A feature's switch, and what flipping it alone changes (tone 0 nothing,
// 1 fewer crates, 2 more).
export struct FeatRow {
    name: string,
    enabled: bool,
    in-default: bool,
    enables: string,
    delta: string,
    tone: int,
}

// A build tree: its size, what of it is stale and why, and its verbs.
export struct DiskTree {
    index: int,
    label: string,
    size: string,
    stale: string,
    has-stale: bool,
    reasons: string,
    locked: bool,
    incremental: string,
}

export struct DiskItemRow {
    index: int,
    name: string,
    size: string,
    removable: bool,
    cache: bool,
}

export struct DiskIdle {
    days: int,
    label: string,
}

// A build the Memory page can measure.
export struct MemBuild {
    path: string,
    name: string,
    profile: string,
    size: string,
    age: string,
    stale: bool,
    target: string,
    chosen: bool,
}

// A crate's share, its bar against the largest crate's.
export struct MemCrate {
    name: string,
    code: string,
    rodata: string,
    ram: string,
    total: string,
    bar: float,
}

// A section: 0 code, 1 read-only, 2 data, 3 bss.
export struct MemSection {
    name: string,
    kind: string,
    tone: int,
    costs: string,
    address: string,
    size: string,
}

// A file in one of the Git panel's two lists: its letter and colour (0 grey,
// 1 green, 2 amber, 3 crimson, 4 slate) and what they mean.
export struct GitChange {
    path: string,
    name: string,
    dir: string,
    letter: string,
    tone: int,
    tip: string,
    staged: bool,
    untracked: bool,
    nested: bool,
    selected: bool,
}

export struct GitStash {
    index: int,
    label: string,
    message: string,
    when: string,
}

// A row of the History page's refs: 0 a heading, 1 a local branch, 2 a
// remote, 3 a remote's branch, 4 a tag.
export struct GitRef {
    index: int,
    kind: int,
    label: string,
    detail: string,
    tip: string,
    current: bool,
    gone: bool,
    filtered: bool,
}

// One line of the graph between a row's centre and the next row's, in the
// pixels of a box two rows tall.
export struct GitLane {
    commands: string,
    color: color,
}

// A ref on a commit: 0 checked out, 1 a branch, 2 a remote's, 3 a tag.
export struct GitLabel {
    text: string,
    color: color,
    kind: int,
}

export struct GitCommitRow {
    index: int,
    short: string,
    summary: string,
    author: string,
    when: string,
    lane: int,
    dot: color,
    merge: bool,
    // The lines leaving this row, and those leaving the row above, which
    // reach into this one.
    edges: [GitLane],
    above: [GitLane],
    labels: [GitLabel],
    more: int,
    selected: bool,
    dim: bool,
}

// A file of an opened commit.
export struct GitFile {
    index: int,
    path: string,
    letter: string,
    tone: int,
    tip: string,
    added: string,
    removed: string,
    selected: bool,
}

// A row of a patch: 0 context, 1 added, 2 removed, 3 a hunk's header, 4 a
// note, 5 nothing on that side. One column uses the left half and both
// numbers; two columns use both halves.
export struct DiffRow {
    kind: int,
    old: string,
    new: string,
    text: string,
    right-kind: int,
    right-text: string,
}

// A row of a right-click menu; an empty id is a divider. An action's row
// carries its key, as the palette's does.
export struct MenuItem {
    id: string,
    label: string,
    danger: bool,
    chord: string,
}

// A run of a terminal's row in one style: its colours where the program
// chose them (the theme's otherwise), and how it is drawn.
export struct TermSpan {
    text: string,
    // Where it starts and how many cells it covers: a wide character is
    // two, whatever the font's fallback draws it as.
    col: int,
    cells: int,
    fg: color,
    own-fg: bool,
    bg: color,
    own-bg: bool,
    bold: bool,
    italic: bool,
    underline: bool,
}

export struct TermRow {
    spans: [TermSpan],
}

// A row of the Search panel: a file and how many hits it holds, or a hit —
// its line, and the line's text around the match.
export struct SearchRow {
    file: bool,
    path: string,
    count: int,
    line: int,
    before: string,
    matched: string,
    after: string,
    index: int,
}

// A field of a register: its bits, its name, its value in the word read.
export struct RegField {
    bits: string,
    name: string,
    value: string,
    description: string,
}

// A register of the picked peripheral, as read at the last stop.
export struct RegRow {
    offset: string,
    name: string,
    value: string,
    description: string,
    open: bool,
    fields: [RegField],
}

// A frame of the debugger's call stack: where it is, and whether it is the
// one whose variables are shown.
export struct DebugFrame {
    level: int,
    function: string,
    place: string,
    on: bool,
}

// A function in the call hierarchy: how deep, whether its own calls are
// shown (0 no, 1 asked for, 2 yes, 3 asked for and there are none), its
// name and what the server says of
// it, where a click goes (the file and line, and the whole path), whether
// it is the function above it on its branch again, how many calls brought
// it there and what listing them is called, and whether it is the first.
export struct CallLine {
    id: int,
    depth: int,
    open: int,
    name: string,
    detail: string,
    place: string,
    whole: string,
    recursive: bool,
    count: int,
    count-tip: string,
    first: bool,
}

// A local or an argument of the frame.
export struct DebugVariable {
    name: string,
    value: string,
    kind: string,
}

// One axis of the Flight tab: what it is, the channel the firmware names
// for it, and its newest value.
export struct FlightAxis {
    label: string,
    channel: string,
    value: string,
    known: bool,
}

// A motor's duty, by its pin.
export struct FlightMotor {
    pin: int,
    duty: float,
    text: string,
}

// A row of the Draw tab's list: 0 a scene, 1 a note, 2 a mark, 3 the
// angles' heading, 4 an angle, 5 the hand three arrows make.
export struct DrawRow {
    kind: int,
    text: string,
    detail: string,
    numbers: string,
    flaw: string,
    colour: color,
    // A mark's place in its scene, a scene's title.
    index: int,
    key: string,
    // The scene on the page, a right angle, a left hand.
    on: bool,
}

// A piece of the Draw tab's view, in its pixels: 0 a path, 1 a polygon,
// 2 a name, 3 a dot. Its colour is the theme's by number, or `rgb`.
export struct DrawPiece {
    kind: int,
    commands: string,
    x: float,
    y: float,
    r: float,
    text: string,
    ink: int,
    rgb: color,
    width: float,
    opacity: float,
    fill: float,
}

// A lane of the Waves panel: the pin's name and its steps, a thousand
// units across the window in time.
export struct WaveLane {
    name: string,
    commands: string,
}

// A time on the Waves panel's axis: where, as a fraction of the lanes'
// width, and what it reads.
export struct WaveTick {
    at: float,
    text: string,
}

// A channel of the Plot panel: its curve in the chart's units, and the
// legend's row.
export struct PlotCurve {
    name: string,
    ink: color,
    commands: string,
    value: string,
    swing: string,
    shown: bool,
}

// A tunable the firmware announced, and the range it gave if it gave one.
export struct PlotTunable {
    name: string,
    value: float,
    text: string,
    min: float,
    max: float,
    ranged: bool,
}

export struct Recent {
    name: string,
    path: string,
}

export global Shell {
    // The project.
    in property <bool> has-project;
    in property <string> project;
    in property <string> branch;

    // The run loop: where it runs, and what is happening.
    in property <string> target;
    // What kind of place the target is: "simulator", "board", or empty for
    // none — the icon the run control shows, its name in the tooltip.
    in property <string> target-kind;
    in property <string> activity;
    // What kind of run, as an icon's name, and its clock while it runs.
    in property <string> activity-kind;
    in property <string> activity-clock;
    // 0 nothing has run, 1 running, 2 ended well, 3 ended badly.
    in property <int> activity-state;
    in property <bool> running;

    // The docks: open, their size, their panels and which is in front.
    in-out property <bool> left-open: true;
    in-out property <length> left-size: 260px;
    in-out property <bool> bottom-open;
    in-out property <length> bottom-size: 240px;
    in-out property <bool> right-open;
    in-out property <length> right-size: 420px;
    in property <[PanelTab]> left-panels;
    in property <string> left-front;
    in property <[PanelTab]> bottom-panels;
    in property <string> bottom-front;
    in property <[PanelTab]> right-panels;
    in property <string> right-front;

    // The documents, files and pages alike.
    in property <[DocTab]> tabs;
    in property <string> active-tab;
    in property <string> active-kind;
    // Two editor groups: whether the window is split, which side has the
    // keys (0 left, 1 right) — `tabs` is that group's — and the other
    // group's strip and what its front tab is.
    in property <bool> split;
    in property <int> focus-group;
    in property <[DocTab]> shade-tabs;
    in property <string> shade-active;
    in property <string> shade-kind;
    in property <string> shade-title;
    in property <string> active-title;
    // The share of the editor area the left group takes while split, as
    // dragged; kept in `workbench.toml` with the docks' sizes.
    in-out property <float> split-share: 0.5;

    // The status bar.
    in property <int> errors;
    in property <int> warnings;
    in property <string> server;
    // Running (0), busy (1), degraded (2), down (3); and what it said.
    in property <int> server-state;
    in property <string> server-tip;
    in property <string> caret;
    in property <string> language;
    in property <string> encoding;
    in property <string> eol;
    in property <string> chip;
    // Who makes it, what builds the project, and where the chip was read.
    in property <string> chip-tip;

    // The Environment page: the answer (ready 0, missing 1, cannot start
    // 2), what it means, and every tool.
    in property <bool> env-probing;
    in property <int> env-kind;
    in property <string> env-verdict;
    in property <string> env-detail;
    in property <bool> env-can-install;
    in property <string> env-installing;
    in property <[EnvRow]> env-rows;
    callback env-install(string /* name */, string /* command */);

    // New project: the step (0 the part .. 3 create), its list and what the
    // selected row means; the name, its problem, what the choices commit
    // to and the command that makes it.
    in property <int> wiz-step;
    in property <[WizRow]> wiz-rows;
    in property <string> wiz-list-note;
    in property <bool> wiz-layouts;
    in property <string> wiz-layout;
    in property <string> wiz-detail-title;
    in property <[string]> wiz-pills;
    in property <string> wiz-detail;
    in property <[WizFact]> wiz-facts;
    in property <string> wiz-detail-foot;
    in property <string> wiz-name;
    in property <string> wiz-name-problem;
    in property <[string]> wiz-summary;
    in property <[WizNote]> wiz-notes;
    in property <string> wiz-command;
    in property <string> wiz-refusal;
    in property <string> wiz-missing;
    in property <bool> wiz-creating;
    in property <bool> wiz-can-create;
    callback wiz-go(int);
    callback wiz-filter(string);
    callback wiz-pick(string);
    callback wiz-hover(string);
    callback wiz-name-edited(string);
    callback wiz-set-layout(string);

    // The playgrounds, and the one that is open — empty for any other
    // project.
    in property <[PlaygroundCard]> playgrounds;
    in property <string> playground;
    callback open-playground(string);

    // The board beside the code: its picture, where on the sheet it sits,
    // and what moves over it.
    in property <bool> board-shown;
    in property <[BoardPart]> board-parts;
    // Changes when a board loads: the view fits it.
    in property <int> board-fit;
    // Nothing runs: the sheet is a drawing, and a press edits it.
    in property <bool> board-editing;
    // The wire being drawn, in the sheet's units, and the pin it would land
    // on.
    in property <string> board-ghost;
    in property <bool> board-target-shown;
    in property <float> board-target-x;
    in property <float> board-target-y;
    // The inspector: "part", "wire" or nothing, and what it says.
    in property <string> board-inspect;
    in property <string> board-ref;
    in property <string> board-value;
    in property <string> board-symbol;
    in property <[BoardProp]> board-props;
    in property <string> board-ref-problem;
    callback board-rename(string);
    callback board-revalue(string);
    callback board-reprop(string, string);
    // The library: which symbols match what is typed.
    in-out property <bool> board-library-open;
    in property <[LibraryRow]> board-library;
    callback board-library-query(string);
    callback board-add(string);
    // The pointer on the sheet, in its units: a press the editor took (or
    // the view pans), the drag after it, the release, and hovering.
    callback board-down(float, float, bool) -> bool;
    callback board-drag(float, float);
    callback board-up(float, float);
    callback board-hover(float, float);
    callback board-key(KeyEvent) -> bool;
    in property <float> board-x;
    in property <float> board-y;
    in property <float> board-width;
    in property <float> board-height;
    in property <[BoardWire]> board-wires;
    in property <[BoardWord]> board-words;
    in property <[BoardLamp]> board-lamps;
    in property <[BoardSwitch]> board-switches;
    in property <[BoardShape]> board-shapes;
    in property <[BoardScreen]> board-screens;
    in property <[BoardRotor]> board-rotors;
    in property <[BoardControl]> board-controls;
    // Words that change while a run goes on: a screen's text, a motor's.
    in property <[BoardWord]> board-texts;
    in property <string> board-caption;
    // A part pressed or let go, and which key of it; a slider moved.
    callback board-press(int, int, bool);
    callback board-control(int, string, float);

    // The debugger: a session live, running or stopped, what it says, its
    // stack and the frame's variables.
    in property <bool> debug-live;
    in property <bool> debug-running;
    in property <bool> debug-stopped;
    in property <string> debug-status;
    in property <string> debug-error;
    in property <[DebugFrame]> debug-frames;
    in property <[DebugVariable]> debug-variables;
    callback debug-frame(int);

    // The call hierarchy (`src/app/calls.rs`): which way it reads, a
    // sentence in place of a tree — how to ask, asking, nothing there —
    // the rows, and what the first row says when nothing came back.
    in property <bool> calls-incoming: true;
    in property <string> calls-said;
    in property <[CallLine]> calls-rows;
    in property <string> calls-empty;
    // A row's chevron; a row clicked (true: its function, false: where its
    // call is made); its calls listed; the other way round.
    callback calls-toggle(int);
    callback calls-go(int, bool);
    callback calls-sites(int);
    callback calls-direction(bool);

    // The math toolbox.
    // A face with the mathematical operators a formula uses — ⊗, ∠, √ —
    // which the monospace face and the fallback do not all carry.
    in property <string> symbols-font;
    in property <[MathRow]> math-rows;
    in property <int> math-focus: -1;
    in property <int> math-focus-tick;
    in property <bool> math-frame-up: true;
    in property <bool> math-help;
    in property <string> math-saved;
    in property <string> math-unreadable;
    in property <[string]> math-examples;
    in property <[MathLine]> math-help-rows;
    in property <[MathStep]> math-steps;
    in property <string> math-steps-note;
    in property <int> math-turns;
    in property <bool> math-playing;
    in property <float> math-progress;
    in property <int> math-value-kind;
    in property <[MathLine]> math-value-lines;
    in property <[string]> math-matrix;
    in property <string> math-value-extra;
    in property <float> math-nose;
    in property <float> math-bank;
    in property <bool> math-copyable;
    in property <bool> math-flat;
    in property <[DrawPiece]> math-pieces;
    in property <float> math-view-w;
    in property <float> math-view-h;
    callback math-select(int);
    callback math-toggle(int);
    callback math-row(int, string);
    callback math-row-key(int, string) -> bool;
    callback math-remove(int);
    callback math-example(int);
    callback math-slider(int, float);
    callback math-step(int);
    callback math-scrub(float);
    callback math-resized(float, float);
    callback math-orbit(float, float);
    callback math-zoom(float);

    // A Markdown file in front: read as a page, or its source.
    in property <bool> md-file;
    in property <bool> md-page;
    in property <[MdBlock]> md-blocks;

    // The assistant.
    in property <bool> ai-ready;
    in property <string> ai-title;
    in property <[AiEntry]> ai-entries;
    in property <bool> ai-running;
    in property <string> ai-spend;
    in property <string> ai-spend-tip;
    in property <string> ai-attach;
    in property <bool> ai-detached;
    in property <int> ai-tick;
    in-out property <string> ai-draft;
    callback ai-fold(int);
    // Settings ▸ Assistant.
    in property <string> ai-current;
    in property <[string]> ai-presets;
    in-out property <string> ai-profile;
    in-out property <int> ai-kind;
    in-out property <string> ai-base-url;
    in-out property <string> ai-model;
    in-out property <string> ai-max-tokens;
    in-out property <string> ai-key;
    in property <bool> ai-key-stored;
    in property <[string]> ai-models;
    in property <string> ai-check;
    in property <bool> ai-check-ok;
    callback ai-preset(int);
    callback ai-pick-model(string);
    // A link clicked on a page.
    callback open-link(string);

    // The Crates page.
    in property <int> crates-state;
    in property <string> crates-problem;
    in property <string> crates-title;
    in property <[CrateVital]> crates-vitals;
    in property <bool> crates-asking;
    in property <bool> crates-asked;
    in property <[CrateDep]> crates-deps;
    in property <[CrateDup]> crates-dups;
    in property <[FeatPackage]> feat-packages;
    in property <bool> feat-defaults;
    in property <string> feat-none;
    in property <[FeatRow]> feat-rows;
    in property <bool> feat-ready;
    in property <string> feat-resolved;
    in property <string> feat-baseline;
    in property <string> feat-delta;
    in property <string> feat-units;
    in property <string> feat-added;
    in property <string> feat-removed;
    in property <bool> disk-ready;
    in property <bool> disk-busy;
    in property <bool> disk-low;
    in property <string> disk-volume;
    in property <string> disk-dir;
    in property <string> disk-total;
    in property <string> disk-stale;
    in property <bool> disk-locked;
    in property <[DiskTree]> disk-trees;
    in property <[DiskItemRow]> disk-extras;
    in property <[DiskItemRow]> disk-caches;
    in property <int> disk-idle;
    in property <[DiskIdle]> disk-idle-options;
    in property <bool> disk-auto;
    in property <string> disk-share;
    in property <string> disk-share-where;
    in property <string> disk-debuginfo;
    in property <[string]> disk-warnings;
    callback crates-upgrade(string, string);
    callback feat-pick(string);
    callback feat-toggle(string);
    callback disk-tree(string, int);
    callback disk-item(int, bool);
    callback disk-idle-set(int);
    callback disk-auto-set(bool);
    // Text onto the clipboard, from anywhere.
    callback copy-text(string);

    // The Memory page.
    in property <int> mem-state;
    in property <[MemBuild]> mem-builds;
    in property <string> mem-problem;
    in property <bool> mem-ready;
    in property <string> mem-flash-value;
    in property <string> mem-flash-unit;
    in property <string> mem-flash-hint;
    in property <int> mem-flash-tone;
    in property <string> mem-ram-value;
    in property <string> mem-ram-unit;
    in property <string> mem-ram-hint;
    in property <int> mem-ram-tone;
    in property <string> mem-unattributed;
    in property <string> mem-unattributed-unit;
    in property <[MemCrate]> mem-crates;
    in property <string> mem-more;
    in property <string> mem-attributed;
    in property <[MemSection]> mem-sections;
    in property <string> mem-elf;
    callback mem-pick(string);

    // The Git panel.
    in property <int> git-state;
    in property <string> git-problem;
    in property <string> git-head;
    in property <string> git-upstream;
    in property <int> git-ahead;
    in property <int> git-behind;
    in property <string> git-pull-tip;
    in property <string> git-push-tip;
    in property <string> git-operation;
    in property <string> git-operation-detail;
    in property <int> git-conflicts;
    in property <bool> git-identity-needed;
    in-out property <string> git-message;
    in-out property <string> git-stash-note;
    in property <bool> git-amend;
    in property <bool> git-clean;
    in property <[GitChange]> git-staged;
    in property <[GitChange]> git-unstaged;
    in property <[GitStash]> git-stashes;
    callback git-file(string, string, bool);
    callback git-file-menu(string, bool, length, length);
    callback git-identity-save(string, string, bool);
    callback git-stash(string, int);

    // The Changes page: a working-tree file's diff.
    in property <string> git-diff-title;
    in property <bool> git-diff-staged;
    in property <[DiffRow]> git-diff-rows;
    in property <string> git-diff-note;
    in property <bool> git-split;

    // The History page.
    in property <[GitRef]> git-refs;
    in property <string> git-filter;
    in property <[GitCommitRow]> git-log;
    in property <int> git-lanes: 1;
    in property <bool> git-truncated;
    in property <int> git-selected: -1;
    in property <int> git-reveal;
    in property <string> git-search-count;
    callback git-search(string);
    callback git-search-step(bool);
    callback git-ref-filter(string);
    callback git-ref(int, bool);
    callback git-ref-menu(int, length, length);
    callback git-pick(int);
    callback git-step(int);
    callback git-commit-menu(int, length, length);
    in property <bool> git-detail-open;
    in property <string> git-detail-summary;
    in property <string> git-detail-body;
    in property <string> git-detail-meta;
    in property <[GitFile]> git-detail-files;
    in property <[DiffRow]> git-detail-rows;
    in property <string> git-detail-note;
    callback git-detail-file(int);
    callback git-detail-file-menu(int, length, length);

    // The name field for a branch, a tag or a remote.
    in property <bool> git-prompt-open;
    in property <string> git-prompt-title;
    in-out property <string> git-prompt-value;
    in-out property <string> git-prompt-url;
    in property <bool> git-prompt-has-url;
    in property <string> git-prompt-problem;
    in property <bool> git-prompt-ok;
    callback git-prompt-edited();
    callback git-prompt-done(bool);

    // Clone: a URL, a folder, and the directory it will make.
    in property <bool> clone-open;
    in-out property <string> clone-url;
    in-out property <string> clone-into;
    in property <string> clone-creates;
    in property <bool> clone-ready;
    callback clone-edited();

    // A right-click menu, anywhere.
    in property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <[MenuItem]> menu-items;
    callback menu-picked(string);
    callback menu-dismissed();

    // The Terminal.
    in property <[TermRow]> term-rows;
    in property <bool> term-cursor-shown;
    in property <int> term-cursor-row;
    in property <int> term-cursor-col;
    in property <string> term-exited;
    callback term-key(KeyEvent) -> bool;
    callback term-resized(int, int);
    callback term-scroll(int);

    // The Search panel.
    in property <bool> search-case;
    in property <bool> search-word;
    in property <bool> search-regex;
    in property <bool> search-trouble;
    in property <string> search-summary;
    in property <[SearchRow]> search-rows;
    callback search-edited(string, string);
    callback search-open(int);

    // The Registers tab.
    in property <bool> registers-loaded;
    in property <bool> registers-svd;
    in property <[string]> registers-names;
    in property <string> registers-picked;
    in property <string> registers-dropped;
    in property <string> registers-heading;
    in property <[RegRow]> registers-rows;
    callback registers-pick(string);
    callback registers-toggle(string);

    // The Signals tab.
    in property <[LabSource]> lab-sources;
    in property <[LabPreset]> lab-presets;
    in property <[string]> lab-preset-names;
    in property <[LabConsole]> lab-console;
    in property <bool> lab-live;
    in-out property <int> lab-view;
    in property <string> lab-refused;
    in property <int> lab-window;
    in property <[LabLane]> lab-lanes;
    in property <bool> lab-host-clock;
    in property <[LabRecord]> lab-records;
    in property <int> lab-span;
    in property <int> lab-window-kind;
    in property <bool> lab-log;
    in property <bool> lab-spectrum-empty: true;
    in property <string> lab-spectrum-path;
    in property <string> lab-spectrum-grid;
    in property <string> lab-spectrum-tones;
    in property <[LabTick]> lab-spectrum-ticks;
    in property <string> lab-spectrum-range;
    in property <string> lab-spectrum-caption;
    in property <[LabParam]> lab-sweep-fields;
    in property <[string]> lab-input-names;
    in property <int> lab-input-index;
    in property <[string]> lab-output-names;
    in property <int> lab-output-index;
    in property <bool> lab-sweeping;
    in property <bool> lab-sweep-ready;
    in property <bool> lab-measure-ready;
    in property <string> lab-status;
    in property <string> lab-gain-curve;
    in property <string> lab-gain-measured;
    in property <string> lab-phase-curve;
    in property <string> lab-phase-measured;
    in property <[LabDot]> lab-gain-dots;
    in property <[LabDot]> lab-phase-dots;
    in property <string> lab-response-grid;
    in property <[LabTick]> lab-response-ticks;
    in property <string> lab-gain-range;
    in property <bool> lab-response-empty: true;
    in property <[string]> lab-kind-names;
    in property <int> lab-kind-index;
    in property <[LabParam]> lab-params;
    in property <int> lab-fir-window: -1;
    in property <string> lab-design-rate;
    in property <string> lab-design-rate-hint;
    in property <bool> lab-design-ok;
    in property <string> lab-design-note;
    in property <string> lab-design-response;
    in property <string> lab-design-spectrum;
    in property <string> lab-design-grid;
    in property <[LabTick]> lab-design-ticks;
    in property <string> lab-design-before;
    in property <string> lab-design-after;
    in property <string> lab-design-time;
    in property <string> lab-code-name;
    in property <string> lab-code;
    in property <string> lab-code-refusal;
    callback lab-pick-source(int);
    callback lab-source-text(int, string);
    callback lab-preset(int, int);
    callback lab-console-text(string, int, string);
    callback lab-set(string, int);
    callback lab-pick-record(string, int);
    callback lab-field(string, int, string);

    // The Flight tab.
    in property <bool> flight-nothing: true;
    in property <[FlightAxis]> flight-axes;
    in property <bool> flight-horizon-known;
    in property <float> flight-horizon-roll;
    in property <float> flight-horizon-shift;
    in property <[FlightMotor]> flight-motors;
    in property <[DrawPiece]> flight-craft;
    in property <bool> flight-craft-known;
    in property <string> flight-craft-text;
    in property <string> flight-craft-source;
    in property <bool> flight-closed;
    in property <bool> flight-ready;
    in property <string> flight-feeds;
    in property <string> flight-help;

    // The Draw tab.
    in property <bool> draw-empty: true;
    in property <string> draw-heading;
    in property <string> draw-title;
    in property <[DrawRow]> draw-rows;
    in property <[DrawPiece]> draw-pieces;
    in property <float> draw-width;
    in property <float> draw-height;
    callback draw-resized(float, float);
    callback draw-orbit(float, float);
    callback draw-zoom(float);
    callback draw-pick(string);
    callback draw-hover(int);

    // The Waves panel.
    in property <[WaveLane]> waves-lanes;
    in property <[WaveTick]> waves-ticks;
    in property <string> waves-clock;
    in property <string> waves-edges;
    in property <bool> waves-capped;
    in property <bool> waves-follow;
    callback waves-resized(float);
    callback waves-grab();
    callback waves-drag(float);
    callback waves-zoom(float, float);
    pure callback waves-time-at(float) -> string;

    // The Plot panel.
    in property <[PlotCurve]> plot-curves;
    in property <[PlotTunable]> plot-tunables;
    in property <string> plot-note;
    in property <bool> plot-writable;
    callback plot-solo(string);
    callback plot-set(string, float);

    // What the window ran, line by line.
    in property <[OutputLine]> output;
    callback output-click(int);
    // Whether what runs reads what is typed in the dock — rusty's serial
    // link — and a line typed there.
    in property <bool> output-input;
    callback output-send(string);

    // What the language servers found, file by file.
    in property <[ProblemRow]> problems;

    // The project's files.
    in property <[TreeRow]> tree;
    // Moves when the tree is to take the keys, and when its selected row
    // (`tree-reveal-row`) is to be brought into view.
    in property <int> tree-focus;
    in property <int> tree-reveal;
    in property <int> tree-reveal-row;
    // The name typed in the box, how many bytes of it to select as it
    // opens, and what is wrong with it — empty when nothing is.
    in-out property <string> tree-name;
    in property <int> tree-name-select;
    // The box's row, for what is wrong with the name to be said under it.
    in property <int> tree-name-row;
    in property <string> tree-name-problem;
    // A drag would drop into the project's root.
    in property <bool> tree-drop-root;
    callback tree-double-click(int);
    // A right-click on a row, or below the rows (-1), and where it was.
    callback tree-menu(int, length, length);
    callback tree-key(KeyEvent) -> bool;
    callback tree-name-edited(string);
    // Enter (true) or Escape (false) in the box, and the box losing the keys.
    callback tree-name-done(bool);
    callback tree-name-left();
    // A row carried over another — the row count past the last is the
    // space below the rows — and let go there.
    callback tree-drag(int, int);
    callback tree-drop(int, int);

    // The welcome page.
    in property <[Recent]> recents;

    // The picker: the command palette and the file finder are one list.
    in-out property <bool> picker-open;
    // What the field holds: empty, or what it was opened with (`:` for a
    // line), with the caret after it.
    in-out property <string> picker-text;
    // The text it opened with selected, to be typed over: a rename's name.
    in property <bool> picker-select-all;
    // Counts every opening: one opened while another is up is the same
    // element, which `init` does not see, so the field is given the keys
    // whenever this moves.
    in property <int> picker-opened;
    in property <string> picker-hint;
    in property <[PickRow]> picker-rows;
    in-out property <int> picker-selected;

    // Notifications, newest last.
    in property <[Note]> notes;

    // Settings.
    in property <string> theme-choice;
    in property <string> language-choice;
    in property <float> zoom: 1;

    // An action by its id (`src/actions.rs`), from a button, a menu or a key.
    callback act(string);
    // A key nothing focused took: the window's bindings get it.
    callback key(KeyEvent) -> bool;
    callback show-panel(string /* dock */, string /* panel */);
    callback dock-resized(string /* dock */, length);
    callback pick-tab(string);
    callback close-tab(string);
    // The other group's strip: its group to front, and the tab.
    callback shade-pick(string);
    callback shade-close(string);
    // A right-click on a tab: its id, whether it is the other group's, and
    // where in the window.
    callback tab-menu(string, bool, length, length);
    // The divider between the two groups let go of, or put back at half.
    callback split-resized(float);
    callback tree-click(int);
    callback open-recent(string);
    callback picker-query(string);
    callback picker-pick(int);
    callback dismiss-note(int);
    callback problem-click(int);
    callback note-action(int);
    callback set-theme(string);
    callback set-language(string);
    callback set-zoom(float);
    // Settings ▸ Editor: what is drawn around the code, by name — `hints`,
    // `minimap`, `sticky`, `guides`.
    in property <bool> view-hints: true;
    in property <bool> view-minimap: true;
    in property <bool> view-sticky: true;
    in property <bool> view-guides: true;
    callback set-view(string, bool);
    // Vim's keys: on or off, and the mode of the document on screen with
    // what is pending or refused — empty while off.
    in property <bool> vim-on;
    // Updating rusty itself: nothing asked yet (0), checking (1), the
    // newest (2), a newer one offered (3), downloading (4), downloaded and
    // verified (5), the feed unreachable (6), the download failed (7); what
    // to say about it, how far a download is (-1 unsized), the version
    // running, and the release's notes.
    in property <int> update-state;
    in property <string> update-title;
    in property <string> update-detail;
    in property <float> update-progress;
    in property <string> update-version;
    in property <[MdBlock]> update-notes;
    in property <string> vim-mode;
    in property <string> vim-hint;
    callback set-vim(bool);
}
