// The three docks. Each holds panels, one in front, picked from a row of
// tabs at its top — Zed's docks, with VS Code's names for what is in them.

import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { IconButton, RowButton, Caption, Field } from "widgets.slint";
import { ListView } from "std-widgets.slint";
import { Shell, PanelTab, TreeRow, ProblemRow } from "shell.slint";
import { BoardPanel } from "board.slint";
import { PlotPanel } from "plot.slint";
import { WavesPanel } from "waves.slint";
import { DrawPanel } from "draw.slint";
import { FlightPanel } from "flight.slint";
import { SignalsPanel } from "signals.slint";
import { DebugPanel } from "debug.slint";
import { RegistersPanel } from "registers.slint";
import { SearchPanel } from "search.slint";
import { TerminalPanel } from "terminal.slint";
import { GitPanel } from "git.slint";
import { AssistantPanel } from "assistant.slint";
import { CallsPanel } from "calls.slint";

// The row of a dock's panels. A tab is its icon and, in front, its name.
component DockHeader inherits Rectangle {
    in property <string> dock;
    in property <[PanelTab]> panels;
    in property <string> front;
    height: 34px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 2px;
        alignment: start;
        for panel in root.panels: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 26px;
            width: row.preferred-width;
            border-radius: Theme.radius;
            background: panel.id == root.front ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
            row := HorizontalLayout {
                padding-left: 7px;
                padding-right: 8px;
                spacing: 6px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    path: panel.icon;
                    size: 15px;
                    color: panel.id == root.front ? Theme.rust : Theme.label-2;
                }
                if panel.id == root.front: Text {
                    text: panel.title;
                    color: Theme.label;
                    font-size: Theme.small;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                clicked => {
                    Shell.show-panel(root.dock, panel.id);
                }
                // The strip's menu: this panel taken off it, or one taken
                // off put back.
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                        Shell.surface-menu("dock", root.dock + ":" + panel.id, -1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }
    }
}

// A panel that has not moved to this window yet says so, plainly.
export component NotYet inherits Rectangle {
    in property <string> name;
    VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 6px;
        Text {
            text: root.name;
            color: Theme.label-2;
            font-size: Theme.body;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("desk.not-yet");
            color: Theme.label-3;
            font-size: Theme.small;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// One row of the tree: an entry, or the box a name is typed in. A press
// pulled more than four pixels carries the entry; the row it is let go
// over is where it is dropped, counted from this row in rows, since the
// pointer stays this row's until it is let go.
component TreeItem inherits Rectangle {
    in property <TreeRow> entry;
    in property <int> index;
    in property <length> row-height;
    // The tree has the keys: the selection is drawn as the list's focus.
    in property <bool> keys;
    // Where a row starts: VS Code's eight pixels a level, so a new entry's
    // box is drawn where the entry will be.
    property <length> indent: 10px + root.entry.depth * 8px;
    property <length> press-x;
    property <length> press-y;
    property <bool> held;
    property <bool> carried;

    height: root.row-height;
    background: root.entry.drop ? Theme.slate-fill : root.entry.naming ? transparent : root.entry.selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    border-width: root.entry.selected && root.keys && !root.entry.naming ? 1px : 0px;
    border-color: Theme.rust.with-alpha(0.6);
    if !root.entry.naming: HorizontalLayout {
        padding-left: root.indent;
        padding-right: 8px;
        spacing: 4px;
        Rectangle {
            width: 12px;
            if root.entry.dir: Icon {
                path: Icons.chevron;
                size: 11px;
                color: Theme.label-3;
                transform-rotation: root.entry.open ? 0deg : -90deg;
            }
        }
        Text {
            text: root.entry.name;
            color: root.entry.cut ? Theme.label-4 : root.entry.dir ? Theme.label : Theme.label-2;
            font-size: Theme.body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // The box: what is typed is judged once an input method has committed
    // it, never while it composes (`f'l'y` is not a name anybody typed).
    if root.entry.naming: HorizontalLayout {
        padding-left: root.indent;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 1px;
        spacing: 4px;
        Rectangle {
            width: 12px;
            if root.entry.dir: Icon {
                path: Icons.chevron;
                size: 11px;
                color: Theme.label-3;
                transform-rotation: -90deg;
            }
        }
        Rectangle {
            background: Theme.sunken;
            border-width: 1px;
            border-color: Shell.tree-name-problem != "" ? Theme.crimson : Theme.rust;
            clip: true;
            name := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: parent.height;
                text <=> Shell.tree-name;
                color: Theme.label;
                font-size: Theme.body;
                vertical-alignment: center;
                single-line: true;
                init => {
                    self.focus();
                    self.set-selection-offsets(0, Shell.tree-name-select);
                }
                edited => {
                    if (self.preedit-text == "") {
                        Shell.tree-name-edited(self.text);
                    }
                }
                accepted => {
                    if (self.preedit-text == "") {
                        Shell.tree-name-done(true);
                    }
                }
                key-pressed(event) => {
                    if (self.preedit-text != "") {
                        return reject;
                    }
                    if (event.text == Key.Escape) {
                        Shell.tree-name-done(false);
                        return accept;
                    }
                    reject
                }
                changed has-focus => {
                    if (!self.has-focus) {
                        Shell.tree-name-left();
                    }
                }
            }
        }
    }
    touch := TouchArea {
        enabled: !root.entry.naming;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.carried = false;
                root.held = event.button == PointerEventButton.left;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                if (event.button == PointerEventButton.right) {
                    Shell.tree-menu(root.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.held = false;
                if (root.carried) {
                    Shell.tree-drop(root.index, root.index + floor(self.mouse-y / root.row-height));
                }
            }
        }
        moved => {
            if (root.held && !root.carried && (abs(self.mouse-x - root.press-x) > 4px || abs(self.mouse-y - root.press-y) > 4px)) {
                root.carried = true;
            }
            if (root.held && root.carried) {
                Shell.tree-drag(root.index, root.index + floor(self.mouse-y / root.row-height));
            }
        }
        clicked => {
            if (!root.carried) {
                Shell.tree-click(root.index);
            }
        }
        double-clicked => {
            if (!root.carried) {
                Shell.tree-double-click(root.index);
            }
        }
    }
}

// The project's files: a flat list of rows with depths, made by the Rust
// side from the folders that are open, so only what is shown exists. It
// takes the keys when a row is clicked — VS Code's explorer: the arrows,
// Enter, F2, Delete, and cut, copy and paste — and the space below the
// rows is the project's root, for a right-click, a paste and a drop.
component ProjectTree inherits Rectangle {
    property <length> row-height: 22px;
    property <int> focus-asked: Shell.tree-focus;
    changed focus-asked => {
        keys.focus();
    }
    if !Shell.has-project: VerticalLayout {
        alignment: center;
        padding: 20px;
        Text {
            text: @tr("chrome.no-project-title");
            color: Theme.label-3;
            font-size: Theme.small;
            horizontal-alignment: center;
        }
    }
    keys := FocusScope {
        key-pressed(event) => {
            if (Shell.tree-key(event)) {
                return accept;
            }
            reject
        }
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    Shell.tree-menu(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            clicked => {
                Shell.tree-click(-1);
            }
        }
        // The root lit for a drop: a frame round the whole list, in the
        // drop's colour rather than the selection's.
        if Shell.tree-drop-root: Rectangle {
            border-width: 1px;
            border-color: Theme.slate;
            background: Theme.slate-fill;
        }
        list := ListView {
            y: 0;
            // Only as tall as its rows, so the space below them is the
            // root's.
            height: min(parent.height, Shell.tree.length * root.row-height);
            property <int> reveal: Shell.tree-reveal;
            changed reveal => {
                // The row brought into view: above, to the top; below, to
                // the bottom; already in view, left where it is.
                if (Shell.tree-reveal-row >= 0) {
                    if (Shell.tree-reveal-row * root.row-height < -self.content-y) {
                        self.content-y = -Shell.tree-reveal-row * root.row-height;
                    } else if ((Shell.tree-reveal-row + 1) * root.row-height > -self.content-y + self.visible-height) {
                        self.content-y = min(0px, self.visible-height - (Shell.tree-reveal-row + 1) * root.row-height);
                    }
                }
            }
            for row[index] in Shell.tree: TreeItem {
                entry: row;
                index: index;
                row-height: root.row-height;
                keys: keys.has-focus;
            }
        }
        // What is wrong with the name typed, under the box, over the rows
        // below it.
        if Shell.tree-name-problem != "": Rectangle {
            x: 10px;
            y: min(parent.height - self.height, (Shell.tree-name-row + 1) * root.row-height + list.content-y);
            width: parent.width - 20px;
            height: problem.preferred-height + 12px;
            background: Theme.overlay;
            border-width: 1px;
            border-color: Theme.crimson;
            problem := Text {
                x: 7px;
                width: parent.width - 14px;
                text: Shell.tree-name-problem;
                color: Theme.label;
                font-size: Theme.small;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }
}

// What the window ran, as it printed it: the command first, errors in
// red and warnings in amber. It follows the end while the end is in
// view, and stays where it was put while somebody reads back.
component OutputPanel inherits Rectangle {
    property <int> count: Shell.output.length;
    property <bool> follow: true;
    changed count => {
        if (self.follow) {
            list.content-y = min(0px, list.visible-height - list.content-height);
        }
    }
    if Shell.output.length == 0: Text {
        text: @tr("desk.output-none");
        color: Theme.label-3;
        font-size: Theme.small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // A right-click where no line is.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                Shell.surface-menu("output", "", -1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    list := ListView {
        y: 0;
        height: Shell.output-input ? parent.height - 40px : parent.height;
        scrolled => {
            root.follow = self.content-y <= self.visible-height - self.content-height + 4px;
        }
        for line[index] in Shell.output: Rectangle {
            height: 18px;
            background: link.has-hover && line.path != "" ? Theme.hover : transparent;
            Text {
                x: 10px;
                text: line.text;
                color: line.kind == 2 ? Theme.crimson : line.kind == 3 ? Theme.amber : line.kind == 4 ? Theme.patina : line.kind == 1 ? Theme.label-2 : Theme.label;
                font-weight: line.kind == 1 ? 600 : 400;
                font-family: Theme.mono;
                font-size: Theme.small;
                vertical-alignment: center;
            }
            // A line that names a place goes there; any line has the menu.
            link := TouchArea {
                mouse-cursor: line.path != "" ? pointer : default;
                clicked => {
                    if (line.path != "") {
                        Shell.output-click(index);
                    }
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                        Shell.surface-menu("output", "", index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }
    }
    // A line to send, for a run that reads one.
    if Shell.output-input: send := Field {
        x: 8px;
        y: parent.height - self.height - 6px;
        width: parent.width - 16px;
        placeholder: @tr("desk.output-send");
        mono: true;
        accepted(text) => {
            Shell.output-send(text);
            self.text = "";
        }
    }
}

// What the language servers found: each file, then its problems, worst
// first. A click goes to the problem.
component ProblemsPanel inherits Rectangle {
    if Shell.problems.length == 0: Text {
        text: @tr("desk.problems-none");
        color: Theme.label-3;
        font-size: Theme.small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ListView {
        for row[index] in Shell.problems: Rectangle {
            height: 24px;
            border-radius: 5px;
            background: problem-touch.has-hover ? Theme.hover : transparent;
            // A click goes to the problem; the right button has its menu.
            problem-touch := TouchArea {
                clicked => {
                    Shell.problem-click(index);
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                        Shell.surface-menu("problems", "", index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
            HorizontalLayout {
                padding-left: row.kind == 0 ? 10px : 30px;
                padding-right: 10px;
                spacing: 7px;
                if row.kind == 0: Icon {
                    y: (parent.height - self.height) / 2;
                    path: Icons.files;
                    size: 13px;
                    color: Theme.label-3;
                }
                if row.kind != 0: Icon {
                    y: (parent.height - self.height) / 2;
                    path: row.kind == 1 ? Icons.close : row.kind == 2 ? Icons.warn : Icons.check;
                    size: 13px;
                    color: row.kind == 1 ? Theme.crimson : row.kind == 2 ? Theme.amber : Theme.slate;
                }
                Text {
                    text: row.text;
                    color: Theme.label;
                    font-size: Theme.small;
                    font-weight: row.kind == 0 ? 600 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.detail;
                    color: Theme.label-3;
                    font-size: Theme.caption;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if row.kind == 0: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: count.preferred-width + 12px;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.hover;
                    count := Text {
                        text: row.count;
                        color: Theme.label-2;
                        font-size: Theme.caption;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component LeftDock inherits Rectangle {
    background: Theme.sidebar;
    VerticalLayout {
        HorizontalLayout {
            DockHeader {
                dock: "left";
                panels: Shell.left-panels;
                front: Shell.left-front;
            }
            // The explorer's own buttons, where VS Code's title bar has
            // them: a new file or folder in the folder selected, and the
            // tree read again.
            if Shell.left-front == "project" && Shell.has-project: IconButton {
                y: 3px;
                icon: Icons.file-plus;
                tip: @tr("context.tree-new-file");
                clicked => {
                    Shell.act("tree.new-file");
                }
            }
            if Shell.left-front == "project" && Shell.has-project: IconButton {
                y: 3px;
                icon: Icons.folder-plus;
                tip: @tr("context.tree-new-folder");
                clicked => {
                    Shell.act("tree.new-folder");
                }
            }
            if Shell.left-front == "project" && Shell.has-project: IconButton {
                y: 3px;
                icon: Icons.refresh;
                tip: @tr("context.tree-refresh");
                clicked => {
                    Shell.act("tree.refresh");
                }
            }
            Rectangle {
                width: 4px;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        Rectangle {
            if Shell.left-front == "project": ProjectTree { }
            if Shell.left-front == "search": SearchPanel { }
            if Shell.left-front == "git": GitPanel { }
        }
    }
}

export component BottomDock inherits Rectangle {
    background: Theme.content;
    VerticalLayout {
        HorizontalLayout {
            DockHeader {
                dock: "bottom";
                panels: Shell.bottom-panels;
                front: Shell.bottom-front;
            }
            if Shell.bottom-front == "output" && Shell.running: IconButton {
                y: 3px;
                icon: Icons.stop;
                tint: Theme.crimson;
                tip: @tr("toolbar.stop");
                clicked => {
                    Shell.act("run.stop");
                }
            }
            // Which way the call hierarchy reads: who calls the function,
            // or what it calls.
            if Shell.bottom-front == "calls": IconButton {
                y: 3px;
                icon: Icons.calls-in;
                active: Shell.calls-incoming;
                tip: @tr("calls.incoming");
                clicked => {
                    Shell.calls-direction(true);
                }
            }
            if Shell.bottom-front == "calls": IconButton {
                y: 3px;
                icon: Icons.calls-out;
                active: !Shell.calls-incoming;
                tip: @tr("calls.outgoing");
                clicked => {
                    Shell.calls-direction(false);
                }
            }
            if Shell.bottom-front == "output": IconButton {
                y: 3px;
                icon: Icons.minus;
                tip: @tr("desk.output-clear");
                clicked => {
                    Shell.act("output.clear");
                }
            }
            IconButton {
                y: 3px;
                icon: Icons.close;
                tip: @tr("desk.hide-dock");
                clicked => {
                    Shell.act("dock.bottom");
                }
            }
            Rectangle {
                width: 6px;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        Rectangle {
            if Shell.bottom-front == "output": OutputPanel { }
            if Shell.bottom-front == "problems": ProblemsPanel { }
            if Shell.bottom-front == "plot": PlotPanel { }
            if Shell.bottom-front == "waves": WavesPanel { }
            if Shell.bottom-front == "draw": DrawPanel { }
            if Shell.bottom-front == "flight": FlightPanel { }
            if Shell.bottom-front == "signals": SignalsPanel { }
            if Shell.bottom-front == "debug": DebugPanel { }
            if Shell.bottom-front == "registers": RegistersPanel { }
            if Shell.bottom-front == "terminal": TerminalPanel { }
            if Shell.bottom-front == "calls": CallsPanel { }
        }
    }
}

export component RightDock inherits Rectangle {
    background: Theme.sidebar;
    VerticalLayout {
        DockHeader {
            dock: "right";
            panels: Shell.right-panels;
            front: Shell.right-front;
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        Rectangle {
            if Shell.right-front == "board": BoardPanel { }
            if Shell.right-front == "assistant": AssistantPanel { }
        }
    }
}
