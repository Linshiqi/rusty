// The three docks. Each holds panels, one in front, picked from a row of
// tabs at its top — Zed's docks, with VS Code's names for what is in them.

import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { IconButton, RowButton, Caption, Field } from "widgets.slint";
import { ListView } from "std-widgets.slint";
import { Shell, PanelTab, TreeRow, ProblemRow } from "shell.slint";
import { BoardPanel } from "board.slint";
import { PlotPanel } from "plot.slint";

// The row of a dock's panels. A tab is its icon and, in front, its name.
component DockHeader inherits Rectangle {
    in property <string> dock;
    in property <[PanelTab]> panels;
    in property <string> front;
    height: 34px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 2px;
        alignment: start;
        for panel in root.panels: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 26px;
            width: row.preferred-width;
            border-radius: Theme.radius;
            background: panel.id == root.front ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
            row := HorizontalLayout {
                padding-left: 7px;
                padding-right: 8px;
                spacing: 6px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    path: panel.icon;
                    size: 15px;
                    color: panel.id == root.front ? Theme.rust : Theme.label-2;
                }
                if panel.id == root.front: Text {
                    text: panel.title;
                    color: Theme.label;
                    font-size: Theme.small;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                clicked => {
                    Shell.show-panel(root.dock, panel.id);
                }
            }
        }
    }
}

// A panel that has not moved to this window yet says so, plainly.
export component NotYet inherits Rectangle {
    in property <string> name;
    VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 6px;
        Text {
            text: root.name;
            color: Theme.label-2;
            font-size: Theme.body;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("desk.not-yet");
            color: Theme.label-3;
            font-size: Theme.small;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// The project's files: a flat list of rows with depths, made by the Rust
// side from the folders that are open, so only what is shown exists.
component ProjectTree inherits Rectangle {
    if !Shell.has-project: VerticalLayout {
        alignment: center;
        padding: 20px;
        Text {
            text: @tr("chrome.no-project-title");
            color: Theme.label-3;
            font-size: Theme.small;
            horizontal-alignment: center;
        }
    }
    if Shell.has-project: ListView {
        for row[index] in Shell.tree: RowButton {
            height: 24px;
            selected: row.selected;
            clicked => {
                Shell.tree-click(index);
            }
            HorizontalLayout {
                padding-left: 8px + row.depth * 12px;
                padding-right: 8px;
                spacing: 4px;
                Rectangle {
                    width: 12px;
                    if row.dir: Icon {
                        path: Icons.chevron;
                        size: 11px;
                        color: Theme.label-3;
                        transform-rotation: row.open ? 0deg : -90deg;
                    }
                }
                Text {
                    text: row.name;
                    color: row.dir ? Theme.label : Theme.label-2;
                    font-size: Theme.body;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// What the window ran, as it printed it: the command first, errors in
// red and warnings in amber. It follows the end while the end is in
// view, and stays where it was put while somebody reads back.
component OutputPanel inherits Rectangle {
    property <int> count: Shell.output.length;
    property <bool> follow: true;
    changed count => {
        if (self.follow) {
            list.content-y = min(0px, list.visible-height - list.content-height);
        }
    }
    if Shell.output.length == 0: Text {
        text: @tr("desk.output-none");
        color: Theme.label-3;
        font-size: Theme.small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    list := ListView {
        y: 0;
        height: Shell.output-input ? parent.height - 40px : parent.height;
        scrolled => {
            root.follow = self.content-y <= self.visible-height - self.content-height + 4px;
        }
        for line[index] in Shell.output: Rectangle {
            height: 18px;
            background: link.has-hover ? Theme.hover : transparent;
            Text {
                x: 10px;
                text: line.text;
                color: line.kind == 2 ? Theme.crimson : line.kind == 3 ? Theme.amber : line.kind == 4 ? Theme.patina : line.kind == 1 ? Theme.label-2 : Theme.label;
                font-weight: line.kind == 1 ? 600 : 400;
                font-family: Theme.mono;
                font-size: Theme.small;
                vertical-alignment: center;
            }
            // A line that names a place goes there.
            link := TouchArea {
                enabled: line.path != "";
                mouse-cursor: line.path != "" ? pointer : default;
                clicked => {
                    Shell.output-click(index);
                }
            }
        }
    }
    // A line to send, for a run that reads one.
    if Shell.output-input: send := Field {
        x: 8px;
        y: parent.height - self.height - 6px;
        width: parent.width - 16px;
        placeholder: @tr("desk.output-send");
        mono: true;
        accepted(text) => {
            Shell.output-send(text);
            self.text = "";
        }
    }
}

// What the language servers found: each file, then its problems, worst
// first. A click goes to the problem.
component ProblemsPanel inherits Rectangle {
    if Shell.problems.length == 0: Text {
        text: @tr("desk.problems-none");
        color: Theme.label-3;
        font-size: Theme.small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ListView {
        for row[index] in Shell.problems: RowButton {
            height: 24px;
            clicked => {
                Shell.problem-click(index);
            }
            HorizontalLayout {
                padding-left: row.kind == 0 ? 10px : 30px;
                padding-right: 10px;
                spacing: 7px;
                if row.kind == 0: Icon {
                    y: (parent.height - self.height) / 2;
                    path: Icons.files;
                    size: 13px;
                    color: Theme.label-3;
                }
                if row.kind != 0: Icon {
                    y: (parent.height - self.height) / 2;
                    path: row.kind == 1 ? Icons.close : row.kind == 2 ? Icons.warn : Icons.check;
                    size: 13px;
                    color: row.kind == 1 ? Theme.crimson : row.kind == 2 ? Theme.amber : Theme.slate;
                }
                Text {
                    text: row.text;
                    color: Theme.label;
                    font-size: Theme.small;
                    font-weight: row.kind == 0 ? 600 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.detail;
                    color: Theme.label-3;
                    font-size: Theme.caption;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if row.kind == 0: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: count.preferred-width + 12px;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.hover;
                    count := Text {
                        text: row.count;
                        color: Theme.label-2;
                        font-size: Theme.caption;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component LeftDock inherits Rectangle {
    background: Theme.sidebar;
    VerticalLayout {
        DockHeader {
            dock: "left";
            panels: Shell.left-panels;
            front: Shell.left-front;
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        Rectangle {
            if Shell.left-front == "project": ProjectTree { }
            if Shell.left-front == "search": NotYet {
                name: @tr("panel.search");
            }
            if Shell.left-front == "git": NotYet {
                name: @tr("panel.git");
            }
        }
    }
}

export component BottomDock inherits Rectangle {
    background: Theme.content;
    VerticalLayout {
        HorizontalLayout {
            DockHeader {
                dock: "bottom";
                panels: Shell.bottom-panels;
                front: Shell.bottom-front;
            }
            if Shell.bottom-front == "output" && Shell.running: IconButton {
                y: 3px;
                icon: Icons.stop;
                tint: Theme.crimson;
                tip: @tr("toolbar.stop");
                clicked => {
                    Shell.act("run.stop");
                }
            }
            if Shell.bottom-front == "output": IconButton {
                y: 3px;
                icon: Icons.minus;
                tip: @tr("desk.output-clear");
                clicked => {
                    Shell.act("output.clear");
                }
            }
            IconButton {
                y: 3px;
                icon: Icons.close;
                tip: @tr("desk.hide-dock");
                clicked => {
                    Shell.act("dock.bottom");
                }
            }
            Rectangle {
                width: 6px;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        Rectangle {
            if Shell.bottom-front == "output": OutputPanel { }
            if Shell.bottom-front == "problems": ProblemsPanel { }
            if Shell.bottom-front == "plot": PlotPanel { }
            if Shell.bottom-front == "terminal": NotYet {
                name: @tr("dock.tab.terminal");
            }
        }
    }
}

export component RightDock inherits Rectangle {
    background: Theme.sidebar;
    VerticalLayout {
        DockHeader {
            dock: "right";
            panels: Shell.right-panels;
            front: Shell.right-front;
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        Rectangle {
            if Shell.right-front == "board": BoardPanel { }
            if Shell.right-front == "assistant": NotYet {
                name: @tr("panel.assistant");
            }
        }
    }
}
