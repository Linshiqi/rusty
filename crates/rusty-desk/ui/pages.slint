// The editor area: a strip of tabs, and the document in front — a file or
// a page. Pages are documents: what is read or edited at length opens here,
// beside the files, and is moved and closed the way a file is.

import { GitPage, GitDiffPage } from "git.slint";
import { MemoryPage } from "memory.slint";
import { CratesPage } from "crates.slint";
import { AssistantSettings } from "assistant.slint";
import { MarkdownView } from "markdown.slint";
import { MathPage } from "math.slint";
import { Transport } from "debug.slint";
import { ScrollView, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { Button, IconButton, RowButton, Caption, Segments } from "widgets.slint";
import { WizardPage } from "wizard.slint";
import { Shell, DocTab } from "shell.slint";
import { CodeView } from "editor.slint";
import { EnvironmentPage } from "environment.slint";
import { NotYet } from "docks.slint";

component TabStrip inherits Rectangle {
    height: 36px;
    background: Theme.window;
    HorizontalLayout {
        alignment: start;
        for tab in Shell.tabs: Rectangle {
            width: min(row.preferred-width, 240px);
            background: tab.id == Shell.active-tab ? Theme.content : touch.has-hover ? Theme.hover : transparent;
            row := HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 6px;
                Text {
                    text: tab.title;
                    color: tab.id == Shell.active-tab ? Theme.label : Theme.label-2;
                    font-size: Theme.small;
                    vertical-alignment: center;
                }
                if tab.hint != "": Text {
                    text: tab.hint;
                    color: Theme.label-3;
                    font-size: Theme.caption;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 20px;
                    if tab.dirty && !close-touch.has-hover: Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: Theme.label-2;
                    }
                    if !tab.dirty || close-touch.has-hover: Icon {
                        path: Icons.close;
                        size: 12px;
                        color: close-touch.has-hover ? Theme.label : touch.has-hover || tab.id == Shell.active-tab ? Theme.label-3 : transparent;
                    }
                    close-touch := TouchArea {
                        clicked => {
                            Shell.close-tab(tab.id);
                        }
                    }
                }
            }
            // The tab in front has the rust line on top, as VS Code's does.
            if tab.id == Shell.active-tab: Rectangle {
                y: 0;
                height: 2px;
                background: Theme.rust;
            }
            touch := TouchArea {
                z: -1;
                clicked => {
                    Shell.pick-tab(tab.id);
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                        Shell.close-tab(tab.id);
                    }
                }
            }
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.line;
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

// The page a window opens on, and the one with no project: what rusty is,
// the three ways to have a project, the playgrounds, and the recent ones.
component Welcome inherits Rectangle {
    background: Theme.content;
    // Centred while it fits, scrolled when the window is shorter than it.
    scroll := ScrollView {
      VerticalLayout {
        alignment: center;
        min-height: scroll.visible-height;
        width: scroll.visible-width;
        padding-top: 24px;
        padding-bottom: 24px;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: 18px;
                width: min(560px, root.width - 48px);
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Icon {
                        path: Icons.settings;
                        size: 34px;
                        color: Theme.rust;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "rusty";
                            color: Theme.label;
                            font-size: 26px;
                            font-weight: 700;
                        }
                        Text {
                            text: @tr("desk.tagline");
                            color: Theme.label-2;
                            font-size: Theme.body;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        primary: true;
                        text: @tr("menu.file.open-project");
                        clicked => {
                            Shell.act("project.open");
                        }
                    }
                    Button {
                        text: @tr("menu.file.new-project");
                        clicked => {
                            Shell.act("project.new");
                        }
                    }
                    Button {
                        text: @tr("menu.file.clone");
                        clicked => {
                            Shell.act("project.clone");
                        }
                    }
                }
                Text {
                    text: @tr("chrome.no-project-detail");
                    color: Theme.label-3;
                    font-size: Theme.small;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    spacing: 2px;
                    Caption {
                        text: @tr("chrome.playground");
                    }
                    Text {
                        text: @tr("chrome.playground-detail");
                        color: Theme.label-3;
                        font-size: Theme.small;
                        wrap: word-wrap;
                    }
                    for card in Shell.playgrounds: RowButton {
                        height: 28px;
                        clicked => {
                            Shell.open-playground(card.id);
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: card.drawing ? Icons.math : Icons.simulate;
                                size: 14px;
                                color: Theme.rust;
                            }
                            Text {
                                text: card.name;
                                color: Theme.label;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: card.detail;
                                color: Theme.label-3;
                                font-size: Theme.small;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                if Shell.recents.length > 0: VerticalLayout {
                    spacing: 2px;
                    Caption {
                        text: @tr("chrome.recent");
                    }
                    for recent in Shell.recents: RowButton {
                        height: 28px;
                        clicked => {
                            Shell.open-recent(recent.path);
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: Icons.folder;
                                size: 14px;
                                color: Theme.label-3;
                            }
                            Text {
                                text: recent.name;
                                color: Theme.label;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: recent.path;
                                color: Theme.label-3;
                                font-size: Theme.small;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                Text {
                    text: @tr("desk.keys-hint");
                    color: Theme.label-4;
                    font-size: Theme.small;
                }
            }
        }
      }
    }
}

// One setting: its name on the left, its control on the right.
component Setting inherits Rectangle {
    in property <string> label;
    min-height: 44px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: Theme.label;
            font-size: Theme.body;
            vertical-alignment: center;
        }
        HorizontalLayout {
            alignment: end;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

// A group of settings: a rounded box of rows divided by hairlines, macOS
// System Settings' shape.
component Group inherits Rectangle {
    in property <string> title;
    VerticalLayout {
        spacing: 6px;
        Caption {
            text: root.title;
        }
        Rectangle {
            border-radius: 9px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                @children
            }
        }
    }
}

component SettingsPage inherits Rectangle {
    background: Theme.content;
    Flickable {
        VerticalLayout {
            padding: 32px;
            spacing: 22px;
            alignment: start;
            Text {
                text: @tr("desk.settings");
                color: Theme.label;
                font-size: Theme.title;
                font-weight: 700;
            }
            Group {
                title: @tr("menu.view.appearance");
                Setting {
                    label: @tr("desk.theme");
                    Segments {
                        labels: [@tr("desk.theme-system"), @tr("desk.theme-dark"), @tr("desk.theme-light")];
                        values: ["system", "dark", "light"];
                        value: Shell.theme-choice;
                        picked(value) => {
                            Shell.set-theme(value);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Setting {
                    label: @tr("desk.language");
                    Segments {
                        labels: ["English", "简体中文"];
                        values: ["en", "zh-CN"];
                        value: Shell.language-choice;
                        picked(value) => {
                            Shell.set-language(value);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Setting {
                    label: @tr("desk.zoom");
                    Segments {
                        labels: ["90%", "100%", "110%", "125%"];
                        values: ["0.9", "1", "1.1", "1.25"];
                        value: Shell.zoom == 0.9 ? "0.9" : Shell.zoom == 1.1 ? "1.1" : Shell.zoom == 1.25 ? "1.25" : "1";
                        picked(value) => {
                            Shell.set-zoom(value.to-float());
                        }
                    }
                }
            }
            Group {
                title: @tr("settings.editor.view");
                Setting {
                    label: @tr("settings.editor.minimap");
                    Switch {
                        checked: Shell.view-minimap;
                        toggled => {
                            Shell.set-view("minimap", self.checked);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Setting {
                    label: @tr("settings.editor.sticky-scroll");
                    Switch {
                        checked: Shell.view-sticky;
                        toggled => {
                            Shell.set-view("sticky", self.checked);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Setting {
                    label: @tr("settings.editor.indent-guides");
                    Switch {
                        checked: Shell.view-guides;
                        toggled => {
                            Shell.set-view("guides", self.checked);
                        }
                    }
                }
            }
            Group {
                title: @tr("panel.assistant");
                VerticalLayout {
                    padding: 14px;
                    init => {
                        Shell.act("ai.shown");
                    }
                    AssistantSettings { }
                }
            }
        }
    }
}

// Across the top of a playground: that it is one, for which part, and the
// two things only a playground can do.
component PlaygroundBar inherits Rectangle {
    height: 34px;
    background: Theme.rust-fill;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        Icon {
            y: (parent.height - self.height) / 2;
            path: Icons.simulate;
            size: 14px;
            color: Theme.rust;
        }
        Text {
            text: @tr("playground.title");
            color: Theme.rust;
            font-size: Theme.small;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: Shell.playground;
            color: Theme.label;
            font-size: Theme.small;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: @tr("playground.reset");
                clicked => {
                    Shell.act("playground.reset");
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: @tr("playground.keep");
                clicked => {
                    Shell.act("playground.keep");
                }
            }
        }
    }
}

export component EditorArea inherits Rectangle {
    background: Theme.content;

    public function focus-code() {
        code.focus-input();
    }

    public function focus-find(replace: bool) {
        code.focus-find(replace);
    }

    VerticalLayout {
        if Shell.playground != "": PlaygroundBar { }
        TabStrip { }
        Rectangle {
            code := CodeView {
                visible: Shell.active-kind == "file";
            }
            // A Markdown file read as a page, over its source.
            if Shell.active-kind == "file" && Shell.md-page: md-area := Rectangle {
                background: Theme.content;
                ScrollView {
                    // A reading column, centred: margins from the page's own
                    // width, never the column's, which is what it decides.
                    VerticalLayout {
                        padding-top: 28px;
                        padding-bottom: 28px;
                        padding-left: max(32px, (md-area.width - 820px) / 2);
                        padding-right: max(32px, (md-area.width - 820px) / 2);
                        MarkdownView {
                            blocks: Shell.md-blocks;
                            font-size: Theme.body;
                        }
                    }
                }
            }
            if Shell.active-kind == "file" && Shell.md-file: IconButton {
                x: parent.width - self.width - 22px;
                y: 8px;
                icon: Shell.md-page ? Icons.code : Icons.files;
                tip: Shell.md-page ? @tr("markdown.show-source") : @tr("markdown.show-preview");
                clicked => {
                    Shell.act("markdown.toggle");
                }
            }
            if Shell.active-kind == "welcome": Welcome { }
            if Shell.active-kind == "settings": SettingsPage { }
            if Shell.active-kind == "environment": EnvironmentPage { }
            if Shell.active-kind == "wizard": WizardPage { }
            if Shell.active-kind == "git": GitPage { }
            if Shell.active-kind == "gitdiff": GitDiffPage { }
            if Shell.active-kind == "memory": MemoryPage { }
            if Shell.active-kind == "crates": CratesPage { }
            if Shell.active-kind == "math": MathPage { }
            if Shell.active-kind != "file" && Shell.active-kind != "welcome" && Shell.active-kind != "settings" && Shell.active-kind != "environment" && Shell.active-kind != "wizard" && Shell.active-kind != "git" && Shell.active-kind != "gitdiff" && Shell.active-kind != "memory" && Shell.active-kind != "crates" && Shell.active-kind != "math" && Shell.active-kind != "": NotYet {
                name: Shell.active-title;
            }
            if Shell.active-kind == "": Welcome { }
            // The debugger's transport, over the code while a session is
            // live: an overlay, so its arrival moves nothing.
            if Shell.debug-live: Transport {
                x: (parent.width - self.width) / 2;
                y: 8px;
            }
        }
    }
}
