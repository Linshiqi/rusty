// The editor area: a strip of tabs, and the document in front — a file or
// a page. Pages are documents: what is read or edited at length opens here,
// beside the files, and is moved and closed the way a file is.

import { GitPage, GitDiffPage } from "git.slint";
import { MemoryPage } from "memory.slint";
import { CratesPage } from "crates.slint";
import { AssistantSettings } from "assistant.slint";
import { MarkdownView, PagePointer } from "markdown.slint";
import { PictureView } from "picture.slint";
import { MathPage } from "math.slint";
import { Transport } from "debug.slint";
import { ScrollView, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { Button, IconButton, RowButton, Caption, Segments, Splitter, Tip } from "widgets.slint";
import { WizardPage } from "wizard.slint";
import { Shell, DocTab } from "shell.slint";
import { CodeView, ShadeView } from "editor.slint";
import { EnvironmentPage } from "environment.slint";
import { KeysPage } from "keys.slint";
import { NotYet } from "docks.slint";

// A group's tabs: the one in front lit, the rust line over it while the
// group has the keys, as VS Code marks the active group's. VS Code's shape:
// the tabs sit in a lane that ends where the strip's own buttons begin, so
// no tab is ever under one, and when there are more than fit the lane
// scrolls sideways under the wheel; the tab in front is brought into view
// whenever it changes, or the lane is resized.
component TabStrip inherits Rectangle {
    in property <[DocTab]> tabs;
    in property <string> active;
    in property <bool> focused: true;
    // The split button, on the strip of the group being edited.
    in property <bool> splits;
    callback pick(string);
    callback close(string);
    // A right-click on a tab, at a point of the window.
    callback menu(string, length, length);
    // A tab let go of, where in the window: beyond its edge is a window of
    // its own (`src/app/torn.rs`).
    callback dropped(string, length, length);
    height: 36px;
    background: Theme.window;

    // How far the lane is scrolled, as last set; what is drawn is that kept
    // inside how far the tabs can travel, so closing tabs never leaves the
    // lane scrolled past its end.
    property <length> scroll;
    property <length> travel: max(0px, lane.preferred-width - view.width);
    property <length> offset: clamp(root.scroll, 0px, root.travel);

    changed travel => {
        root.scroll = root.offset;
    }

    // A tab at `x` of the lane, `w` wide: scrolled just far enough to show
    // it whole, and not at all when it is.
    function reveal(x: length, w: length) {
        if (x < root.offset) {
            root.scroll = x;
        } else if (x + w > root.offset + view.width) {
            root.scroll = min(x, x + w - view.width);
        } else {
            root.scroll = root.offset;
        }
    }

    HorizontalLayout {
        view := Rectangle {
            horizontal-stretch: 1;
            clip: true;
            // Under the tabs, which leave the wheel alone: either way of
            // turning it moves the lane sideways, as VS Code's does.
            TouchArea {
                scroll-event(event) => {
                    if (root.travel <= 0px) {
                        return reject;
                    }
                    root.scroll = clamp(root.offset - (abs(event.delta-x) > abs(event.delta-y) ? event.delta-x : event.delta-y), 0px, root.travel);
                    accept
                }
            }
            lane := HorizontalLayout {
                x: -root.offset;
                width: self.preferred-width;
                height: parent.height;
                alignment: start;
                for tab in root.tabs: tab-box := Rectangle {
                    // In front, and where it is: either changing brings it
                    // into view, once the lane has been laid out again.
                    property <bool> front: tab.id == root.active;
                    property <length> at: self.x;
                    property <length> room: view.width;
                    changed front => {
                        if (self.front) {
                            show.running = true;
                        }
                    }
                    changed at => {
                        if (self.front) {
                            show.running = true;
                        }
                    }
                    changed room => {
                        if (self.front) {
                            show.running = true;
                        }
                    }
                    init => {
                        if (self.front) {
                            show.running = true;
                        }
                    }
                    show := Timer {
                        interval: 1ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            root.reveal(tab-box.x, tab-box.width);
                        }
                    }
                    width: min(row.preferred-width, 240px);
                    background: tab.id == root.active ? Theme.content : touch.has-hover ? Theme.hover : transparent;
                    row := HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 6px;
                        // A Rust file no `mod` declares is greyed, as its
                        // row in the tree is.
                        Text {
                            text: tab.title;
                            color: tab.unlinked ? Theme.left-out : tab.id == root.active ? Theme.label : Theme.label-2;
                            font-size: Theme.small;
                            vertical-alignment: center;
                        }
                        if tab.hint != "": Text {
                            text: tab.hint;
                            color: Theme.label-3;
                            font-size: Theme.caption;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 20px;
                            if tab.dirty && !close-touch.has-hover: Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: Theme.label-2;
                            }
                            if !tab.dirty || close-touch.has-hover: Icon {
                                path: Icons.close;
                                size: 12px;
                                color: close-touch.has-hover ? Theme.label : touch.has-hover || tab.id == root.active ? Theme.label-3 : transparent;
                            }
                            close-touch := TouchArea {
                                clicked => {
                                    root.close(tab.id);
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                        root.menu(tab.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                        }
                    }
                    // Why its name is grey, once the pointer rests on it.
                    Timer {
                        interval: 600ms;
                        running: touch.has-hover && tab.unlinked && !Tip.shown;
                        triggered => {
                            Tip.text = @tr("files.unlinked");
                            Tip.x = tab-box.absolute-position.x;
                            Tip.y = tab-box.absolute-position.y + tab-box.height + 4px;
                            Tip.shown = true;
                        }
                    }
                    // The tab in front has the rust line on top, as VS Code's does.
                    if tab.id == root.active && root.focused: Rectangle {
                        y: 0;
                        height: 2px;
                        background: Theme.rust;
                    }
                    touch := TouchArea {
                        z: -1;
                        clicked => {
                            root.pick(tab.id);
                        }
                        changed has-hover => {
                            if (!self.has-hover && tab.unlinked) {
                                Tip.shown = false;
                            }
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                Tip.shown = false;
                            }
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle) {
                                root.close(tab.id);
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                root.menu(tab.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                root.dropped(tab.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.line;
                    }
                }
            }
        }
        // The strip's own buttons, after the lane rather than over it.
        // Ctrl+\: the file in front, beside itself.
        if root.splits && root.tabs.length > 0: HorizontalLayout {
            // As wide as its buttons: the lane takes the rest.
            horizontal-stretch: 0;
            padding-left: 4px;
            padding-right: 6px;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.columns;
                tip: @tr("desk.split");
                clicked => {
                    Shell.act("editor.split");
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

// The page a window opens on, and the one with no project: what rusty is,
// the three ways to have a project, the playgrounds, and the recent ones.
component Welcome inherits Rectangle {
    background: Theme.content;
    // Centred while it fits, scrolled when the window is shorter than it.
    scroll := ScrollView {
      VerticalLayout {
        alignment: center;
        min-height: scroll.visible-height;
        width: scroll.visible-width;
        padding-top: 24px;
        padding-bottom: 24px;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                spacing: 18px;
                width: min(560px, root.width - 48px);
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Image {
                        source: @image-url("../icons/rusty.png");
                        width: 40px;
                        height: 40px;
                        image-rendering: smooth;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "rusty";
                            color: Theme.label;
                            font-size: 26px;
                            font-weight: 700;
                        }
                        Text {
                            text: @tr("desk.tagline");
                            color: Theme.label-2;
                            font-size: Theme.body;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        primary: true;
                        text: @tr("menu.file.open-project");
                        clicked => {
                            Shell.act("project.open");
                        }
                    }
                    Button {
                        text: @tr("menu.file.new-project");
                        clicked => {
                            Shell.act("project.new");
                        }
                    }
                    Button {
                        text: @tr("menu.file.clone");
                        clicked => {
                            Shell.act("project.clone");
                        }
                    }
                }
                Text {
                    text: @tr("chrome.no-project-detail");
                    color: Theme.label-3;
                    font-size: Theme.small;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    spacing: 2px;
                    Caption {
                        text: @tr("chrome.playground");
                    }
                    Text {
                        text: @tr("chrome.playground-detail");
                        color: Theme.label-3;
                        font-size: Theme.small;
                        wrap: word-wrap;
                    }
                    for card in Shell.playgrounds: RowButton {
                        height: 28px;
                        clicked => {
                            Shell.open-playground(card.id);
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: card.drawing ? Icons.math : Icons.simulate;
                                size: 14px;
                                color: Theme.rust;
                            }
                            Text {
                                text: card.name;
                                color: Theme.label;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: card.detail;
                                color: Theme.label-3;
                                font-size: Theme.small;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                if Shell.recents.length > 0: VerticalLayout {
                    spacing: 2px;
                    Caption {
                        text: @tr("chrome.recent");
                    }
                    // Here, or with Ctrl held or by the row's button in a
                    // window of its own, as VS Code's recents open.
                    for recent in Shell.recents: recent-row := RowButton {
                        height: 28px;
                        clicked => {
                            if (self.ctrl) {
                                Shell.open-recent-new-window(recent.path);
                            } else {
                                Shell.open-recent(recent.path);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 30px;
                            spacing: 10px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: Icons.folder;
                                size: 14px;
                                color: Theme.label-3;
                            }
                            Text {
                                text: recent.name;
                                color: Theme.label;
                                font-size: Theme.body;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            Text {
                                text: recent.path;
                                color: Theme.label-3;
                                font-size: Theme.small;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                        IconButton {
                            x: parent.width - self.width - 2px;
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            glyph: 14px;
                            visible: recent-row.hovered || self.hovered;
                            icon: Icons.window;
                            tip: @tr("windows.open-new");
                            clicked => {
                                Shell.open-recent-new-window(recent.path);
                            }
                        }
                    }
                }
                // The keys in force, not the table's: a rebound key is the
                // key shown.
                if Shell.keys-hint != "": Text {
                    text: Shell.keys-hint;
                    color: Theme.label-4;
                    font-size: Theme.small;
                }
            }
        }
      }
    }
}

// One setting: its name on the left, its control on the right.
component Setting inherits Rectangle {
    in property <string> label;
    min-height: 44px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: Theme.label;
            font-size: Theme.body;
            vertical-alignment: center;
        }
        HorizontalLayout {
            alignment: end;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

// A group of settings: a rounded box of rows divided by hairlines, macOS
// System Settings' shape.
component Group inherits Rectangle {
    in property <string> title;
    VerticalLayout {
        spacing: 6px;
        Caption {
            text: root.title;
        }
        Rectangle {
            border-radius: 9px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                @children
            }
        }
    }
}

component SettingsPage inherits Rectangle {
    background: Theme.content;
    Flickable {
        VerticalLayout {
            padding: 32px;
            spacing: 22px;
            alignment: start;
            Text {
                text: @tr("desk.settings");
                color: Theme.label;
                font-size: Theme.title;
                font-weight: 700;
            }
            Group {
                title: @tr("menu.view.appearance");
                Setting {
                    label: @tr("desk.theme");
                    Segments {
                        labels: [@tr("desk.theme-system"), @tr("desk.theme-dark"), @tr("desk.theme-light")];
                        values: ["system", "dark", "light"];
                        value: Shell.theme-choice;
                        picked(value) => {
                            Shell.set-theme(value);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Setting {
                    label: @tr("desk.language");
                    Segments {
                        labels: ["English", "简体中文"];
                        values: ["en", "zh-CN"];
                        value: Shell.language-choice;
                        picked(value) => {
                            Shell.set-language(value);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Setting {
                    label: @tr("desk.zoom");
                    Segments {
                        labels: ["90%", "100%", "110%", "125%"];
                        values: ["0.9", "1", "1.1", "1.25"];
                        value: Shell.zoom == 0.9 ? "0.9" : Shell.zoom == 1.1 ? "1.1" : Shell.zoom == 1.25 ? "1.25" : "1";
                        picked(value) => {
                            Shell.set-zoom(value.to-float());
                        }
                    }
                }
            }
            Group {
                title: @tr("shortcuts.settings-group");
                Setting {
                    label: @tr("shortcuts.title");
                    Button {
                        text: @tr("shortcuts.open");
                        clicked => {
                            Shell.act("keys.open");
                        }
                    }
                }
            }
            Group {
                title: @tr("settings.editor.vim");
                Setting {
                    label: @tr("settings.editor.vim-detail");
                    Switch {
                        checked: Shell.vim-on;
                        toggled => {
                            Shell.set-vim(self.checked);
                        }
                    }
                }
            }
            Group {
                title: @tr("settings.editor.view");
                Setting {
                    label: @tr("settings.editor.inlay-hints");
                    Switch {
                        checked: Shell.view-hints;
                        toggled => {
                            Shell.set-view("hints", self.checked);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Setting {
                    label: @tr("settings.editor.minimap");
                    Switch {
                        checked: Shell.view-minimap;
                        toggled => {
                            Shell.set-view("minimap", self.checked);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Setting {
                    label: @tr("settings.editor.sticky-scroll");
                    Switch {
                        checked: Shell.view-sticky;
                        toggled => {
                            Shell.set-view("sticky", self.checked);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                Setting {
                    label: @tr("settings.editor.indent-guides");
                    Switch {
                        checked: Shell.view-guides;
                        toggled => {
                            Shell.set-view("guides", self.checked);
                        }
                    }
                }
            }
            Group {
                title: @tr("desk.updates");
                Setting {
                    label: "rusty " + Shell.update-version;
                    HorizontalLayout {
                        spacing: 8px;
                        if Shell.update-state == 3 || Shell.update-state == 7: Button {
                            text: @tr("update.skip");
                            clicked => {
                                Shell.act("update.skip");
                            }
                        }
                        if Shell.update-state == 3 || Shell.update-state == 7: Button {
                            text: @tr("update.download");
                            clicked => {
                                Shell.act("update.download");
                            }
                        }
                        if Shell.update-state == 5: Button {
                            text: @tr("update.restart");
                            clicked => {
                                Shell.act("update.restart");
                            }
                        }
                        if Shell.update-state == 0 || Shell.update-state == 2 || Shell.update-state == 6: Button {
                            text: @tr("menu.help.check-updates");
                            clicked => {
                                Shell.act("update.check");
                            }
                        }
                    }
                }
                if Shell.update-state != 0: VerticalLayout {
                    padding: 14px;
                    padding-top: 4px;
                    spacing: 6px;
                    Text {
                        text: Shell.update-title;
                        color: Theme.label;
                        font-size: Theme.body;
                        font-weight: 600;
                    }
                    Text {
                        text: Shell.update-detail;
                        color: Theme.label-2;
                        font-size: Theme.small;
                        wrap: word-wrap;
                    }
                    if Shell.update-state == 4: Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.sunken;
                        Rectangle {
                            x: 0;
                            width: Shell.update-progress < 0 ? parent.width : parent.width * Shell.update-progress;
                            border-radius: 2px;
                            background: Theme.rust;
                        }
                    }
                    if Shell.update-notes.length > 0: MarkdownView {
                        blocks: Shell.update-notes;
                        font-size: Theme.small;
                    }
                    if Shell.update-state >= 3: HorizontalLayout {
                        alignment: start;
                        Button {
                            text: @tr("update.releases");
                            clicked => {
                                Shell.act("update.releases");
                            }
                        }
                    }
                }
            }
            Group {
                title: @tr("panel.assistant");
                VerticalLayout {
                    padding: 14px;
                    init => {
                        Shell.act("ai.shown");
                    }
                    AssistantSettings { }
                }
            }
        }
    }
}

// Across the top of a playground: that it is one, for which part, and the
// two things only a playground can do.
component PlaygroundBar inherits Rectangle {
    height: 34px;
    background: Theme.rust-fill;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        Icon {
            y: (parent.height - self.height) / 2;
            path: Icons.simulate;
            size: 14px;
            color: Theme.rust;
        }
        Text {
            text: @tr("playground.title");
            color: Theme.rust;
            font-size: Theme.small;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: Shell.playground;
            color: Theme.label;
            font-size: Theme.small;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: @tr("playground.reset");
                clicked => {
                    Shell.act("playground.reset");
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: @tr("playground.keep");
                clicked => {
                    Shell.act("playground.keep");
                }
            }
        }
    }
}

// What a group shows when its tab is not a file: the page it is.
component PageBody inherits Rectangle {
    in property <string> kind;
    in property <string> title;
    if root.kind == "welcome": Welcome { }
    if root.kind == "settings": SettingsPage { }
    if root.kind == "environment": EnvironmentPage { }
    if root.kind == "wizard": WizardPage { }
    if root.kind == "git": GitPage { }
    if root.kind == "gitdiff": GitDiffPage { }
    if root.kind == "memory": MemoryPage { }
    if root.kind == "crates": CratesPage { }
    if root.kind == "math": MathPage { }
    if root.kind == "keys": KeysPage { }
    if root.kind == "picture": PictureView {
        checker: Theme.dark ? Shell.picture-checker-dark : Shell.picture-checker;
    }
    if root.kind != "file" && root.kind != "welcome" && root.kind != "settings" && root.kind != "environment" && root.kind != "wizard" && root.kind != "git" && root.kind != "gitdiff" && root.kind != "memory" && root.kind != "crates" && root.kind != "math" && root.kind != "keys" && root.kind != "picture" && root.kind != "": NotYet {
        name: root.title;
    }
    if root.kind == "": Welcome { }
}

// The editor groups: the one with the keys — its strip, the code view or
// its page — and, split, the other beside it, drawn from `Shade`. Which
// side the one with the keys is on is `Shell.focus-group`; it moves there,
// so the code view is one component however the groups are arranged.
export component EditorArea inherits Rectangle {
    background: Theme.content;

    public function focus-code() {
        code.focus-input();
    }

    public function focus-find(replace: bool) {
        code.focus-find(replace);
    }

    VerticalLayout {
        if Shell.playground != "": PlaygroundBar { }
        panes := Rectangle {
            // Where the groups part: the share the divider was left at,
            // each side kept at least VS Code's minimum while there is
            // room for two.
            property <length> least: min(220px, (self.width - 1px) / 2);
            property <length> left: Shell.split ? clamp(round(self.width * Shell.split-share / 1px) * 1px, self.least, self.width - 1px - self.least) : self.width;
            property <length> right: self.width - self.left - 1px;
            property <bool> on-right: Shell.split && Shell.focus-group == 1;
            live := Rectangle {
                x: panes.on-right ? panes.left + 1px : 0;
                width: panes.on-right ? panes.right : panes.left;
                VerticalLayout {
                    TabStrip {
                        tabs: Shell.tabs;
                        active: Shell.active-tab;
                        splits: true;
                        pick(id) => {
                            Shell.pick-tab(id);
                        }
                        close(id) => {
                            Shell.close-tab(id);
                        }
                        menu(id, x, y) => {
                            Shell.tab-menu(id, false, x, y);
                        }
                        dropped(id, x, y) => {
                            Shell.tab-dropped(id, false, x, y);
                        }
                    }
                    Rectangle {
                        code := CodeView {
                            visible: Shell.active-kind == "file";
                        }
                        // An SVG's picture, over its source.
                        if Shell.active-kind == "file" && Shell.md-page && Shell.picture-page: PictureView {
                            checker: Theme.dark ? Shell.picture-checker-dark : Shell.picture-checker;
                        }
                        // A Markdown file read as a page, over its source.
                        if Shell.active-kind == "file" && Shell.md-page && !Shell.picture-page: md-area := Rectangle {
                            background: Theme.content;
                            ScrollView {
                                // A reading column, centred: margins from the page's own
                                // width, never the column's, which is what it decides. It
                                // widens with the text, so a line holds the same words. Its
                                // blocks keep their own heights: a page shorter than the view
                                // spread the room left over between them, which read as gaps
                                // that grew and shrank with the text's size.
                                VerticalLayout {
                                    alignment: start;
                                    padding-top: 28px;
                                    padding-bottom: 28px;
                                    padding-left: max(32px, (md-area.width - 820px * Shell.page-zoom) / 2);
                                    padding-right: max(32px, (md-area.width - 820px * Shell.page-zoom) / 2);
                                    MarkdownView {
                                        blocks: Shell.md-blocks;
                                        font-size: Theme.body * Shell.page-zoom;
                                    }
                                }
                            }
                            // Over the page, short of its scrollbar: Ctrl and the wheel
                            // size its text, and a right-click opens its menu — the text
                            // takes every press itself, so nothing under it would hear the
                            // right button. A click is made again underneath, with this
                            // stepped aside, so a link still answers; and where the pointer
                            // is goes to `PagePointer`, so a tip under it still shows.
                            TouchArea {
                                x: 0;
                                width: parent.width - 14px;
                                enabled: !Shell.page-through;
                                changed has-hover => {
                                    PagePointer.inside = self.has-hover;
                                }
                                scroll-event(event) => {
                                    if (event.modifiers.control) {
                                        Shell.content-zoom("page", event.delta-y);
                                        return accept;
                                    }
                                    reject
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.move) {
                                        PagePointer.x = self.absolute-position.x + self.mouse-x;
                                        PagePointer.y = self.absolute-position.y + self.mouse-y;
                                    }
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                        Shell.surface-menu("page", "", -1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                                clicked => {
                                    Shell.page-click(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        if Shell.active-kind == "file" && Shell.md-file: IconButton {
                            x: parent.width - self.width - 22px;
                            y: 8px;
                            icon: Shell.md-page ? Icons.code : Icons.files;
                            tip: Shell.md-page ? @tr("markdown.show-source") : @tr("markdown.show-preview");
                            clicked => {
                                Shell.act("markdown.toggle");
                            }
                        }
                        if Shell.active-kind != "file": PageBody {
                            kind: Shell.active-kind;
                            title: Shell.active-title;
                        }
                        // The debugger's transport, over the code while a session is
                        // live: an overlay, so its arrival moves nothing.
                        if Shell.debug-live: Transport {
                            x: (parent.width - self.width) / 2;
                            y: 8px;
                        }
                    }
                }
            }
            if Shell.split: Rectangle {
                x: panes.on-right ? 0 : panes.left + 1px;
                width: panes.on-right ? panes.left : panes.right;
                VerticalLayout {
                    TabStrip {
                        tabs: Shell.shade-tabs;
                        active: Shell.shade-active;
                        focused: false;
                        pick(id) => {
                            Shell.shade-pick(id);
                        }
                        close(id) => {
                            Shell.shade-close(id);
                        }
                        menu(id, x, y) => {
                            Shell.tab-menu(id, true, x, y);
                        }
                        dropped(id, x, y) => {
                            Shell.tab-dropped(id, true, x, y);
                        }
                    }
                    Rectangle {
                        if Shell.shade-kind == "file": ShadeView { }
                        if Shell.shade-kind != "file": PageBody {
                            kind: Shell.shade-kind;
                            title: Shell.shade-title;
                        }
                    }
                }
            }
            // The divider: dragged, the groups part elsewhere, and the share
            // is kept when it is let go; a double-click puts it at half.
            if Shell.split: Splitter {
                property <float> start;
                x: panes.left;
                width: 1px;
                height: parent.height;
                pressed => {
                    self.start = panes.left / panes.width;
                }
                dragged(travel) => {
                    Shell.split-share = clamp(self.start + travel / panes.width, panes.least / panes.width, 1 - (panes.least + 1px) / panes.width);
                }
                released => {
                    Shell.split-resized(Shell.split-share);
                }
                reset => {
                    Shell.split-share = 0.5;
                    Shell.split-resized(0.5);
                }
            }
        }
    }
}
