// The code surface: rows of coloured pieces and marks placed by the Rust
// side, the primary caret, and one TextInput that only ever holds what an
// input method is composing.
//
// Rust measures and places everything (`src/editor/`); this file draws what
// it is handed. The rows are a ListView, so only the rows on screen exist.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { IconButton, Tip } from "widgets.slint";

export struct Piece {
    text: string,
    x: length,
    // What it is (`Theme.token`), so a theme change recolours it.
    kind: int,
}

// Something drawn on a row behind or under its text: a selection (0), a
// caret that is not the primary one (1), a match of the find bar's query
// (2), the match the selection is (3), the scope find searches (4).
export struct Mark {
    x: length,
    width: length,
    kind: int,
}

export struct Row {
    number: int,
    pieces: [Piece],
    marks: [Mark],
}

// The document on screen, filled by `src/editor/`.
export global Code {
    in property <[Row]> rows;
    in property <int> caret-line;
    in property <length> caret-x;
    in property <bool> has-document;
    in property <length> content-width: 2000px;
    in property <length> row-height: 19px;
    in property <length> font-size: 12.5px;
    in-out property <length> scroll-y;
    in-out property <length> scroll-x;
    in-out property <length> view-height;
    in-out property <length> view-width;
    // True when the key was taken.
    callback key(KeyEvent) -> bool;
    callback typed(string);
    // A press (0), a move while pressed (1), a release (2), on a row, at a
    // point in it, with the modifiers held.
    callback pointer(int /* kind */, int /* row */, length /* x */, length /* y */, KeyboardModifiers);
}

// The find bar, filled by `src/editor/` (`find.rs` is its arithmetic).
export global Find {
    in-out property <bool> open;
    in-out property <bool> replacing;
    in-out property <string> query;
    in-out property <string> replacement;
    in property <bool> case;
    in property <bool> word;
    in property <bool> regex;
    in property <bool> scoped;
    // "3 of 12", "No results", or what is wrong with the expression.
    in property <string> count;
    // Nothing found, or a query that does not read: the field says so.
    in property <bool> trouble;
    callback edited(string);
    callback replacement-edited(string);
    // `case`, `word`, `regex` or `scope`.
    callback toggle(string);
    callback step(bool /* forward */);
    callback replace(bool /* all */);
    callback select-all();
    callback close();
}

// An option of the query: a word or two of type, lit while it is on.
component Toggle inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> on;
    callback clicked;
    width: 22px;
    height: 20px;
    border-radius: 4px;
    background: root.on ? Theme.rust-fill : touch.has-hover ? Theme.hover : transparent;
    border-width: root.on ? 1px : 0;
    border-color: Theme.rust;
    Text {
        text: root.text;
        color: root.on ? Theme.rust : Theme.label-2;
        font-size: Theme.caption;
        font-family: Theme.mono;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            Tip.shown = false;
            root.clicked();
        }
        changed has-hover => {
            if (!self.has-hover) {
                Tip.shown = false;
            }
        }
    }
    Timer {
        interval: 600ms;
        running: touch.has-hover && !Tip.shown;
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
}

// What the bar does with a key in either of its fields: Escape closes, F3
// steps, Alt and a letter turns an option, as VS Code's widget does.
component FindField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> trouble;
    in property <length> inset;
    in-out property <string> text;
    callback edited(string);
    callback enter(KeyEvent) -> bool;

    public function focus-all() {
        input.focus();
        input.select-all();
    }

    height: 26px;
    border-radius: 5px;
    background: Theme.sunken;
    border-width: 1px;
    border-color: root.trouble ? Theme.crimson : input.has-focus ? Theme.rust : transparent;
    clip: true;
    input := TextInput {
        x: 8px;
        width: parent.width - 16px - root.inset;
        height: parent.height;
        text <=> root.text;
        color: Theme.label;
        font-size: Theme.small;
        font-family: Theme.mono;
        vertical-alignment: center;
        single-line: true;
        edited => {
            root.edited(self.text);
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                Find.close();
                return accept;
            }
            if (event.text == Key.F3) {
                Find.step(!event.modifiers.shift);
                return accept;
            }
            if (event.modifiers.alt && !event.modifiers.control) {
                if (event.text == "c" || event.text == "C") {
                    Find.toggle("case");
                    return accept;
                }
                if (event.text == "w" || event.text == "W") {
                    Find.toggle("word");
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    Find.toggle("regex");
                    return accept;
                }
                if (event.text == "l" || event.text == "L") {
                    Find.toggle("scope");
                    return accept;
                }
            }
            if (event.text == Key.Return && root.enter(event)) {
                return accept;
            }
            reject
        }
    }
    if root.text == "": Text {
        x: 8px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.label-3;
        font-size: Theme.small;
        vertical-alignment: center;
    }
}

// The bar itself, in the editor's top-right corner: the query and its
// options, where the selection is among the matches, the steps, the scope;
// and under it, while replacing, what a match becomes.
component FindBar inherits Rectangle {
    public function focus-query() {
        query.focus-all();
    }

    public function focus-replacement() {
        replacement.focus-all();
    }

    width: 470px;
    height: column.preferred-height;
    background: Theme.overlay;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 3px;
    TouchArea { }
    column := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        IconButton {
            width: 18px;
            height: Find.replacing ? 56px : 26px;
            glyph: 13px;
            icon: Find.replacing ? Icons.chevron : Icons.chevron-right;
            tip: @tr("desk.find-toggle-replace");
            clicked => {
                Find.replacing = !Find.replacing;
                if (Find.replacing) {
                    replacement.focus-all();
                } else {
                    query.focus-all();
                }
            }
        }
        VerticalLayout {
            spacing: Find.replacing ? 4px : 0px;
            HorizontalLayout {
                spacing: 3px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 26px;
                    query := FindField {
                        width: parent.width;
                        placeholder: @tr("desk.find");
                        trouble: Find.trouble;
                        inset: 72px;
                        text <=> Find.query;
                        edited(text) => {
                            Find.edited(text);
                        }
                        enter(event) => {
                            if (event.modifiers.alt) {
                                Find.select-all();
                            } else {
                                Find.step(!event.modifiers.shift);
                            }
                            true
                        }
                    }
                    HorizontalLayout {
                        x: parent.width - self.preferred-width - 3px;
                        y: 3px;
                        spacing: 1px;
                        Toggle {
                            text: "Aa";
                            tip: @tr("desk.find-case");
                            on: Find.case;
                            clicked => {
                                Find.toggle("case");
                            }
                        }
                        Toggle {
                            text: "ab";
                            tip: @tr("desk.find-word");
                            on: Find.word;
                            clicked => {
                                Find.toggle("word");
                            }
                        }
                        Toggle {
                            text: ".*";
                            tip: @tr("desk.find-regex");
                            on: Find.regex;
                            clicked => {
                                Find.toggle("regex");
                            }
                        }
                    }
                }
                Text {
                    width: 96px;
                    text: Find.count;
                    color: Find.trouble ? Theme.crimson : Theme.label-2;
                    font-size: Theme.caption;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                IconButton {
                    width: 24px;
                    height: 26px;
                    glyph: 14px;
                    icon: Icons.arrow-up;
                    tip: @tr("desk.find-previous");
                    clicked => {
                        Find.step(false);
                    }
                }
                IconButton {
                    width: 24px;
                    height: 26px;
                    glyph: 14px;
                    icon: Icons.arrow-down;
                    tip: @tr("desk.find-next");
                    clicked => {
                        Find.step(true);
                    }
                }
                IconButton {
                    width: 24px;
                    height: 26px;
                    glyph: 14px;
                    icon: Icons.in-selection;
                    active: Find.scoped;
                    tip: @tr("desk.find-scope");
                    clicked => {
                        Find.toggle("scope");
                    }
                }
                IconButton {
                    width: 24px;
                    height: 26px;
                    glyph: 13px;
                    icon: Icons.close;
                    tip: @tr("desk.find-close");
                    clicked => {
                        Find.close();
                    }
                }
            }
            // Always there, so the corner's chevron can put the keys in it.
            HorizontalLayout {
                height: Find.replacing ? 26px : 0px;
                visible: Find.replacing;
                spacing: 3px;
                replacement := FindField {
                    horizontal-stretch: 1;
                    placeholder: @tr("desk.find-replace-with");
                    text <=> Find.replacement;
                    edited(text) => {
                        Find.replacement-edited(text);
                    }
                    enter(event) => {
                        Find.replace(event.modifiers.control && event.modifiers.alt);
                        true
                    }
                }
                IconButton {
                    width: 26px;
                    height: 26px;
                    glyph: 15px;
                    icon: Icons.replace;
                    tip: @tr("desk.find-replace-one");
                    clicked => {
                        Find.replace(false);
                    }
                }
                IconButton {
                    width: 26px;
                    height: 26px;
                    glyph: 15px;
                    icon: Icons.replace-all;
                    tip: @tr("desk.find-replace-all");
                    clicked => {
                        Find.replace(true);
                    }
                }
                Rectangle {
                    width: 48px;
                }
            }
        }
    }
}

export component CodeView inherits Rectangle {
    in property <length> gutter: 64px;

    background: Theme.content;

    public function focus-input() {
        sink.focus();
    }

    public function focus-find(replace: bool) {
        if (replace) {
            bar.focus-replacement();
        } else {
            bar.focus-query();
        }
    }

    list := ListView {
        width: parent.width;
        height: parent.height;
        content-width: max(self.visible-width, Code.content-width);
        content-y <=> Code.scroll-y;
        content-x <=> Code.scroll-x;
        changed visible-height => {
            Code.view-height = self.visible-height;
        }
        changed visible-width => {
            Code.view-width = self.visible-width;
        }
        for row[index] in Code.rows: Rectangle {
            height: Code.row-height;
            width: max(list.visible-width, Code.content-width);
            for mark in row.marks: Rectangle {
                x: root.gutter + mark.x;
                y: mark.kind == 1 ? 2px : 0;
                // A caret, and a match of nothing (`^`), are a bar.
                width: mark.kind == 1 ? 2px : max(mark.width, 2px);
                height: mark.kind == 1 ? parent.height - 4px : parent.height;
                background: mark.kind == 1 ? Theme.rust : mark.kind == 2 ? Theme.find-match : mark.kind == 3 ? Theme.find-current : mark.kind == 4 ? Theme.find-scope : Theme.text-selection;
            }
            Text {
                x: 0;
                width: root.gutter - 20px;
                height: parent.height;
                text: row.number;
                color: index == Code.caret-line ? Theme.label : Theme.label-4;
                font-family: Theme.mono;
                font-size: Code.font-size;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            for piece in row.pieces: Text {
                x: root.gutter + piece.x;
                height: parent.height;
                text: piece.text;
                color: Theme.token(piece.kind);
                font-italic: piece.kind == 4;
                font-family: Theme.mono;
                font-size: Code.font-size;
                vertical-alignment: center;
            }
            touch := TouchArea {
                mouse-cursor: text;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            Code.pointer(0, index, self.mouse-x - root.gutter, self.mouse-y, event.modifiers);
                            sink.focus();
                        } else if (event.kind == PointerEventKind.up) {
                            Code.pointer(2, index, self.mouse-x - root.gutter, self.mouse-y, event.modifiers);
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        Code.pointer(1, index, self.mouse-x - root.gutter, self.mouse-y, {});
                    }
                }
            }
        }
    }

    // Where the next key lands. Drawn here rather than by the TextInput, whose
    // own caret sits after whatever it is composing.
    Rectangle {
        x: root.gutter + Code.caret-x + list.content-x - 1px;
        y: Code.caret-line * Code.row-height + list.content-y + 2px;
        width: 2px;
        height: Code.row-height - 4px;
        background: Theme.rust;
        visible: Code.has-document && sink.preedit-text == "" && sink.has-focus;
    }

    // Every character arrives here, typed or composed: an input method shows
    // its composition in place, at the caret, and commits it as an edit.
    // Keys that are not text go to `key` first and never reach it.
    sink := TextInput {
        x: root.gutter + Code.caret-x + list.content-x;
        y: Code.caret-line * Code.row-height + list.content-y;
        width: max(2px, self.preferred-width);
        height: Code.row-height;
        font-family: Theme.mono;
        font-size: Code.font-size;
        color: Theme.label;
        vertical-alignment: center;
        single-line: true;
        text-cursor-width: 0px;
        key-pressed(event) => {
            if (self.preedit-text != "") {
                return reject;
            }
            if (Code.key(event)) {
                return accept;
            }
            reject
        }
        edited => {
            if (self.preedit-text == "" && self.text != "") {
                Code.typed(self.text);
                self.text = "";
            }
        }
    }

    bar := FindBar {
        x: parent.width - self.width - 22px;
        y: 0;
        visible: Find.open;
    }
}
