// The code surface: rows of coloured pieces and marks placed by the Rust
// side, the primary caret, and one TextInput that only ever holds what an
// input method is composing.
//
// Rust measures and places everything (`src/editor/`); this file draws what
// it is handed. The rows are a ListView, so only the rows on screen exist.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct Piece {
    text: string,
    x: length,
    // What it is (`Theme.token`), so a theme change recolours it.
    kind: int,
}

// Something drawn on a row behind or under its text: a selection (0), a
// caret that is not the primary one (1).
export struct Mark {
    x: length,
    width: length,
    kind: int,
}

export struct Row {
    number: int,
    pieces: [Piece],
    marks: [Mark],
}

// The document on screen, filled by `src/editor/`.
export global Code {
    in property <[Row]> rows;
    in property <int> caret-line;
    in property <length> caret-x;
    in property <bool> has-document;
    in property <length> content-width: 2000px;
    in property <length> row-height: 19px;
    in property <length> font-size: 12.5px;
    in-out property <length> scroll-y;
    in-out property <length> scroll-x;
    in-out property <length> view-height;
    in-out property <length> view-width;
    // True when the key was taken.
    callback key(KeyEvent) -> bool;
    callback typed(string);
    // A press (0), a move while pressed (1), a release (2), on a row, at a
    // point in it, with the modifiers held.
    callback pointer(int /* kind */, int /* row */, length /* x */, length /* y */, KeyboardModifiers);
}

export component CodeView inherits Rectangle {
    in property <length> gutter: 64px;

    background: Theme.content;

    public function focus-input() {
        sink.focus();
    }

    list := ListView {
        width: parent.width;
        height: parent.height;
        content-width: max(self.visible-width, Code.content-width);
        content-y <=> Code.scroll-y;
        content-x <=> Code.scroll-x;
        changed visible-height => {
            Code.view-height = self.visible-height;
        }
        changed visible-width => {
            Code.view-width = self.visible-width;
        }
        for row[index] in Code.rows: Rectangle {
            height: Code.row-height;
            width: max(list.visible-width, Code.content-width);
            for mark in row.marks: Rectangle {
                x: root.gutter + mark.x;
                y: mark.kind == 1 ? 2px : 0;
                width: mark.kind == 1 ? 2px : mark.width;
                height: mark.kind == 1 ? parent.height - 4px : parent.height;
                background: mark.kind == 1 ? Theme.rust : Theme.text-selection;
            }
            Text {
                x: 0;
                width: root.gutter - 20px;
                height: parent.height;
                text: row.number;
                color: index == Code.caret-line ? Theme.label : Theme.label-4;
                font-family: Theme.mono;
                font-size: Code.font-size;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            for piece in row.pieces: Text {
                x: root.gutter + piece.x;
                height: parent.height;
                text: piece.text;
                color: Theme.token(piece.kind);
                font-italic: piece.kind == 4;
                font-family: Theme.mono;
                font-size: Code.font-size;
                vertical-alignment: center;
            }
            touch := TouchArea {
                mouse-cursor: text;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            Code.pointer(0, index, self.mouse-x - root.gutter, self.mouse-y, event.modifiers);
                            sink.focus();
                        } else if (event.kind == PointerEventKind.up) {
                            Code.pointer(2, index, self.mouse-x - root.gutter, self.mouse-y, event.modifiers);
                        }
                    }
                }
                moved => {
                    if (self.pressed) {
                        Code.pointer(1, index, self.mouse-x - root.gutter, self.mouse-y, {});
                    }
                }
            }
        }
    }

    // Where the next key lands. Drawn here rather than by the TextInput, whose
    // own caret sits after whatever it is composing.
    Rectangle {
        x: root.gutter + Code.caret-x + list.content-x - 1px;
        y: Code.caret-line * Code.row-height + list.content-y + 2px;
        width: 2px;
        height: Code.row-height - 4px;
        background: Theme.rust;
        visible: Code.has-document && sink.preedit-text == "" && sink.has-focus;
    }

    // Every character arrives here, typed or composed: an input method shows
    // its composition in place, at the caret, and commits it as an edit.
    // Keys that are not text go to `key` first and never reach it.
    sink := TextInput {
        x: root.gutter + Code.caret-x + list.content-x;
        y: Code.caret-line * Code.row-height + list.content-y;
        width: max(2px, self.preferred-width);
        height: Code.row-height;
        font-family: Theme.mono;
        font-size: Code.font-size;
        color: Theme.label;
        vertical-alignment: center;
        single-line: true;
        text-cursor-width: 0px;
        key-pressed(event) => {
            if (self.preedit-text != "") {
                return reject;
            }
            if (Code.key(event)) {
                return accept;
            }
            reject
        }
        edited => {
            if (self.preedit-text == "" && self.text != "") {
                Code.typed(self.text);
                self.text = "";
            }
        }
    }
}
