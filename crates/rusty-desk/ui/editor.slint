// The code surface: rows of coloured pieces and marks placed by the Rust
// side, the primary caret, and one TextInput that only ever holds what an
// input method is composing.
//
// Rust measures and places everything (`src/editor/`); this file draws what
// it is handed. The rows are a ListView, so only the rows on screen exist.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { IconButton, Tip } from "widgets.slint";

export struct Piece {
    text: string,
    x: length,
    // What it is (`Theme.token`), so a theme change recolours it.
    kind: int,
}

// Something drawn on a row behind or under its text: a selection (0), a
// caret that is not the primary one (1), a match of the find bar's query
// (2), the match the selection is (3), the scope find searches (4), a
// squiggle under what a server found: an error (5), a warning (6),
// something to know (7), whose line is `path`; an indent guide (8); the
// bracket beside the caret or its partner, outlined (9); another place
// the name under the caret occurs, washed (10); and the line under a name
// drawn as a link while Ctrl is held (11), whose characters are drawn in
// the link colour too (a piece of kind 11).
export struct Mark {
    x: length,
    width: length,
    kind: int,
    path: string,
}

// An inlay hint drawn in the line: its label in a pill, where the pill
// starts and how wide it is.
export struct Hint {
    text: string,
    x: length,
    width: length,
}

export struct Row {
    number: int,
    hints: [Hint],
    // A block opens on the line (1), collapsed (2); and where the line's
    // text ends, for the ellipsis a collapsed one carries.
    fold: int,
    fold-x: length,
    pieces: [Piece],
    marks: [Mark],
    // A breakpoint on the line: 0 none, 1 placed, 2 asked for and not
    // placed (no code there), drawn hollow.
    breakpoint: int,
    // The debugger stopped here.
    stopped: bool,
    // A lens on the line: 1 a test, 3 a module of them (Run | Debug), 2 an
    // example's main (Run); where it starts; and the last run's
    // verdict, 1 passed, 2 failed.
    lens: int,
    lens-x: length,
    verdict: int,
}

// A row of the completion popup: what it inserts, the note beside it, its
// type at the right, and the glyph of its kind coloured as that kind is.
export struct CompletionRow {
    label: string,
    extra: string,
    detail: string,
    glyph: string,
    kind: int,
}

// A problem on the hover card: an error (1), a warning (2), the rest (3),
// what it says, and who said it.
export struct HoverProblem {
    kind: int,
    text: string,
    detail: string,
}

// A fix on the hover card: what it does, and the other files it changes.
export struct HoverFix {
    title: string,
    detail: string,
}

// The document on screen, filled by `src/editor/`.
export global Code {
    in property <[Row]> rows;
    in property <int> caret-line;
    in property <length> caret-x;
    // Vim's command modes: the caret is a block over the character the
    // cursor stands on, this wide.
    in property <bool> block-caret;
    in property <length> caret-width: 2px;
    in property <bool> has-document;
    in property <length> content-width: 2000px;
    in property <length> row-height: 19px;
    in property <length> font-size: 12.5px;
    in-out property <length> scroll-y;
    in-out property <length> scroll-x;
    in-out property <length> view-height;
    in-out property <length> view-width;
    // True when the key was taken.
    callback key(KeyEvent) -> bool;
    callback typed(string);
    // A press (0), a move while pressed (1), a release (2), on a row, at a
    // point in it, with the modifiers held.
    callback pointer(int /* kind */, int /* row */, length /* x */, length /* y */, KeyboardModifiers);
    // A right-click on a row, at a point in it, and where that is in the
    // window, for the menu.
    callback context-menu(int /* row */, length /* x */, length /* y */, length /* window x */, length /* window y */);
    // A key let go, which Ctrl coming up is; the keys gone from the code,
    // to another panel or with the window to another.
    callback key-released(KeyEvent);
    callback blurred();

    // Ctrl over a name (`src/editor/link.rs`): the pointer moved over a row,
    // at a point in it and in the window, with Ctrl held or not; it left a
    // row. The row a name is drawn as a link on, where the pointer is a
    // hand, or -1.
    callback link-over(int /* row */, length /* x */, length /* y */, bool /* ctrl */, length /* window x */, length /* window y */);
    callback link-left(int /* row */);
    in property <int> link-row: -1;
    // The mouse's back (true) and forward (false) buttons over the code.
    callback navigate(bool);

    // The hover card: over which line, from where along it, how wide, and
    // what it says — the problems there, the code the server showed, its
    // documentation.
    in property <bool> hover-open;
    in property <int> hover-line;
    in property <length> hover-x;
    in property <length> hover-width: 420px;
    in property <[HoverProblem]> hover-problems;
    // The fixes the server offers for those problems, under them; a click
    // applies one.
    in property <[HoverFix]> hover-fixes;
    callback hover-fix(int);
    in property <[Row]> hover-code;
    in property <bool> hover-has-docs;
    in property <styled-text> hover-docs;
    // The pointer is on the card, which keeps it.
    in-out property <bool> on-card;
    // The pointer moved over a row (or off the rows, at -1), not pressed.
    callback hovered(int /* row */, length /* x */, length /* y */);
    // A click beside a line's number: a breakpoint there, or none.
    callback toggle-breakpoint(int /* row */);
    // A lens's verb on a row: "run" or "debug".
    callback lens(int /* row */, string /* verb */);
    // The chevron beside a row's number: its block collapsed or opened.
    callback fold(int /* row */);
    // The pointer is over the margin, which shows every chevron rather
    // than only the collapsed ones — VS Code's default.
    in-out property <bool> gutter-hover;
    // The view scrolled, was resized or changed theme: what is drawn over
    // the text follows.
    callback view-changed();

    // The lines that open the blocks the top of the view is in, kept at
    // the top; a click moves the view to one.
    in property <[Row]> sticky-rows;
    callback sticky-pick(int);

    // The minimap: its rows painted from `minimap-offset` down, how many,
    // and the slider marking the view; a press or a drag on it centres
    // that part of the file.
    in property <bool> minimap-on;
    in property <image> minimap;
    in property <int> minimap-rows;
    in property <length> minimap-offset;
    in property <length> minimap-slider-top;
    in property <length> minimap-slider-height;
    callback minimap-to(length);

    // The completion popup: under which line, from where along it, the
    // rows drawn and which the keys are on, and how many there are in all.
    in property <bool> completion-open;
    in property <int> completion-line;
    in property <length> completion-x;
    in property <[CompletionRow]> completion-rows;
    in property <int> completion-selected;
    in property <int> completion-count;
    callback completion-pick(int);

    // The signature of the call the caret is in, the parameter it is on
    // apart from the rest.
    in property <bool> signature-open;
    in property <int> signature-line;
    in property <length> signature-x;
    in property <string> signature-before;
    in property <string> signature-param;
    in property <string> signature-after;
}

component CompletionPopup inherits Rectangle {
    width: 460px;
    height: column.preferred-height;
    background: Theme.overlay;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 3px;
    clip: true;
    column := VerticalLayout {
        padding: 3px;
        for row[i] in Code.completion-rows: Rectangle {
            height: 22px;
            border-radius: 4px;
            background: i == Code.completion-selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 8px;
                spacing: 7px;
                Text {
                    width: 12px;
                    text: row.glyph;
                    color: Theme.token(row.kind);
                    font-family: Theme.mono;
                    font-size: Theme.small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    text: row.label;
                    color: Theme.label;
                    font-family: Theme.mono;
                    font-size: Code.font-size;
                    vertical-alignment: center;
                }
                Text {
                    text: row.extra;
                    color: Theme.label-3;
                    font-family: Theme.mono;
                    font-size: Theme.small;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.detail;
                    color: Theme.label-3;
                    font-size: Theme.caption;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            touch := TouchArea {
                clicked => {
                    Code.completion-pick(i);
                }
            }
        }
    }
}

component SignatureCard inherits Rectangle {
    // The row's own width, padding included: any more, and the layout
    // shared the extra out between the three pieces as gaps.
    width: min(row.preferred-width, 640px);
    height: 26px;
    background: Theme.overlay;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000033;
    clip: true;
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 0px;
        alignment: start;
        Text {
            text: Code.signature-before;
            color: Theme.label-2;
            font-family: Theme.mono;
            font-size: Code.font-size;
            vertical-alignment: center;
        }
        Text {
            text: Code.signature-param;
            color: Theme.rust;
            font-weight: 700;
            font-family: Theme.mono;
            font-size: Code.font-size;
            vertical-alignment: center;
        }
        Text {
            text: Code.signature-after;
            color: Theme.label-2;
            font-family: Theme.mono;
            font-size: Code.font-size;
            vertical-alignment: center;
        }
    }
}

// The card itself: problems first and their fixes, then the code and its
// documentation. Everything is inside the card's own touch area, so the
// pointer on a fix is still on the card.
component HoverCard inherits Rectangle {
    width: Code.hover-width;
    height: min(column.preferred-height, 360px);
    background: Theme.overlay;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 3px;
    clip: true;
    touch := TouchArea {
        changed has-hover => {
            Code.on-card = self.has-hover;
            if (!self.has-hover) {
                Code.hovered(-1, 0, 0);
            }
        }
        column := VerticalLayout {
            padding: 10px;
            spacing: 8px;
            for problem in Code.hover-problems: HorizontalLayout {
                spacing: 8px;
                Icon {
                    y: 2px;
                    path: problem.kind == 1 ? Icons.close : problem.kind == 2 ? Icons.warn : Icons.check;
                    size: 14px;
                    color: problem.kind == 1 ? Theme.crimson : problem.kind == 2 ? Theme.amber : Theme.slate;
                }
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: problem.text;
                        color: Theme.label;
                        font-size: Theme.small;
                        wrap: word-wrap;
                    }
                    if problem.detail != "": Text {
                        text: problem.detail;
                        color: Theme.label-3;
                        font-size: Theme.caption;
                    }
                }
            }
            if Code.hover-fixes.length > 0: VerticalLayout {
                spacing: 1px;
                Text {
                    text: @tr("desk.hover-fixes");
                    color: Theme.label-3;
                    font-size: Theme.caption;
                }
                for fix[i] in Code.hover-fixes: Rectangle {
                    height: max(22px, fix-row.preferred-height);
                    border-radius: 4px;
                    background: fix-touch.has-hover ? Theme.hover : transparent;
                    fix-row := HorizontalLayout {
                        padding-left: 2px;
                        padding-right: 6px;
                        spacing: 6px;
                        Rectangle {
                            width: 14px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: Icons.bulb;
                                size: 14px;
                                color: Theme.amber;
                            }
                        }
                        Text {
                            text: fix.title;
                            color: fix-touch.has-hover ? Theme.label : Theme.slate;
                            font-size: Theme.small;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        if fix.detail != "": Text {
                            text: fix.detail;
                            color: Theme.label-3;
                            font-size: Theme.caption;
                            vertical-alignment: center;
                        }
                    }
                    fix-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Code.hover-fix(i);
                        }
                    }
                }
            }
            if Code.hover-problems.length > 0 && (Code.hover-code.length > 0 || Code.hover-has-docs): Rectangle {
                height: 1px;
                background: Theme.line;
            }
            if Code.hover-code.length > 0: VerticalLayout {
                for row in Code.hover-code: Rectangle {
                    height: Code.row-height;
                    for piece in row.pieces: Text {
                        x: piece.x;
                        height: parent.height;
                        text: piece.text;
                        color: Theme.token(piece.kind);
                        font-italic: piece.kind == 4;
                        font-family: Theme.mono;
                        font-size: Code.font-size;
                        vertical-alignment: center;
                    }
                }
            }
            if Code.hover-has-docs: StyledText {
                text: Code.hover-docs;
                default-color: Theme.label-2;
                default-font-size: Theme.small;
                link-color: Theme.slate;
            }
        }
    }
}

// The find bar, filled by `src/editor/` (`find.rs` is its arithmetic).
export global Find {
    in-out property <bool> open;
    in-out property <bool> replacing;
    in-out property <string> query;
    in-out property <string> replacement;
    in property <bool> case;
    in property <bool> word;
    in property <bool> regex;
    in property <bool> scoped;
    // "3 of 12", "No results", or what is wrong with the expression.
    in property <string> count;
    // Nothing found, or a query that does not read: the field says so.
    in property <bool> trouble;
    callback edited(string);
    callback replacement-edited(string);
    // `case`, `word`, `regex` or `scope`.
    callback toggle(string);
    callback step(bool /* forward */);
    callback replace(bool /* all */);
    callback select-all();
    callback close();
}

// An option of the query: a word or two of type, lit while it is on.
component Toggle inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> on;
    callback clicked;
    width: 22px;
    height: 20px;
    border-radius: 4px;
    background: root.on ? Theme.rust-fill : touch.has-hover ? Theme.hover : transparent;
    border-width: root.on ? 1px : 0;
    border-color: Theme.rust;
    Text {
        text: root.text;
        color: root.on ? Theme.rust : Theme.label-2;
        font-size: Theme.caption;
        font-family: Theme.mono;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            Tip.shown = false;
            root.clicked();
        }
        changed has-hover => {
            if (!self.has-hover) {
                Tip.shown = false;
            }
        }
    }
    Timer {
        interval: 600ms;
        running: touch.has-hover && !Tip.shown;
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
}

// What the bar does with a key in either of its fields: Escape closes, F3
// steps, Alt and a letter turns an option, as VS Code's widget does.
component FindField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> trouble;
    in property <length> inset;
    in-out property <string> text;
    callback edited(string);
    callback enter(KeyEvent) -> bool;

    public function focus-all() {
        input.focus();
        input.select-all();
    }

    height: 26px;
    border-radius: 5px;
    background: Theme.sunken;
    border-width: 1px;
    border-color: root.trouble ? Theme.crimson : input.has-focus ? Theme.rust : transparent;
    clip: true;
    input := TextInput {
        x: 8px;
        width: parent.width - 16px - root.inset;
        height: parent.height;
        text <=> root.text;
        color: Theme.label;
        font-size: Theme.small;
        font-family: Theme.mono;
        vertical-alignment: center;
        single-line: true;
        edited => {
            root.edited(self.text);
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                Find.close();
                return accept;
            }
            if (event.text == Key.F3) {
                Find.step(!event.modifiers.shift);
                return accept;
            }
            if (event.modifiers.alt && !event.modifiers.control) {
                if (event.text == "c" || event.text == "C") {
                    Find.toggle("case");
                    return accept;
                }
                if (event.text == "w" || event.text == "W") {
                    Find.toggle("word");
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    Find.toggle("regex");
                    return accept;
                }
                if (event.text == "l" || event.text == "L") {
                    Find.toggle("scope");
                    return accept;
                }
            }
            if (event.text == Key.Return && root.enter(event)) {
                return accept;
            }
            reject
        }
    }
    if root.text == "": Text {
        x: 8px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.label-3;
        font-size: Theme.small;
        vertical-alignment: center;
    }
}

// The bar itself, in the editor's top-right corner: the query and its
// options, where the selection is among the matches, the steps, the scope;
// and under it, while replacing, what a match becomes.
component FindBar inherits Rectangle {
    public function focus-query() {
        query.focus-all();
    }

    public function focus-replacement() {
        replacement.focus-all();
    }

    width: 470px;
    height: column.preferred-height;
    background: Theme.overlay;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 3px;
    TouchArea { }
    column := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        IconButton {
            width: 18px;
            height: Find.replacing ? 56px : 26px;
            glyph: 13px;
            icon: Find.replacing ? Icons.chevron : Icons.chevron-right;
            tip: @tr("desk.find-toggle-replace");
            clicked => {
                Find.replacing = !Find.replacing;
                if (Find.replacing) {
                    replacement.focus-all();
                } else {
                    query.focus-all();
                }
            }
        }
        VerticalLayout {
            spacing: Find.replacing ? 4px : 0px;
            HorizontalLayout {
                spacing: 3px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 26px;
                    query := FindField {
                        width: parent.width;
                        placeholder: @tr("desk.find");
                        trouble: Find.trouble;
                        inset: 72px;
                        text <=> Find.query;
                        edited(text) => {
                            Find.edited(text);
                        }
                        enter(event) => {
                            if (event.modifiers.alt) {
                                Find.select-all();
                            } else {
                                Find.step(!event.modifiers.shift);
                            }
                            true
                        }
                    }
                    HorizontalLayout {
                        x: parent.width - self.preferred-width - 3px;
                        y: 3px;
                        spacing: 1px;
                        Toggle {
                            text: "Aa";
                            tip: @tr("desk.find-case");
                            on: Find.case;
                            clicked => {
                                Find.toggle("case");
                            }
                        }
                        Toggle {
                            text: "ab";
                            tip: @tr("desk.find-word");
                            on: Find.word;
                            clicked => {
                                Find.toggle("word");
                            }
                        }
                        Toggle {
                            text: ".*";
                            tip: @tr("desk.find-regex");
                            on: Find.regex;
                            clicked => {
                                Find.toggle("regex");
                            }
                        }
                    }
                }
                Text {
                    width: 96px;
                    text: Find.count;
                    color: Find.trouble ? Theme.crimson : Theme.label-2;
                    font-size: Theme.caption;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                IconButton {
                    width: 24px;
                    height: 26px;
                    glyph: 14px;
                    icon: Icons.arrow-up;
                    tip: @tr("desk.find-previous");
                    clicked => {
                        Find.step(false);
                    }
                }
                IconButton {
                    width: 24px;
                    height: 26px;
                    glyph: 14px;
                    icon: Icons.arrow-down;
                    tip: @tr("desk.find-next");
                    clicked => {
                        Find.step(true);
                    }
                }
                IconButton {
                    width: 24px;
                    height: 26px;
                    glyph: 14px;
                    icon: Icons.in-selection;
                    active: Find.scoped;
                    tip: @tr("desk.find-scope");
                    clicked => {
                        Find.toggle("scope");
                    }
                }
                IconButton {
                    width: 24px;
                    height: 26px;
                    glyph: 13px;
                    icon: Icons.close;
                    tip: @tr("desk.find-close");
                    clicked => {
                        Find.close();
                    }
                }
            }
            // Always there, so the corner's chevron can put the keys in it.
            HorizontalLayout {
                height: Find.replacing ? 26px : 0px;
                visible: Find.replacing;
                spacing: 3px;
                replacement := FindField {
                    horizontal-stretch: 1;
                    placeholder: @tr("desk.find-replace-with");
                    text <=> Find.replacement;
                    edited(text) => {
                        Find.replacement-edited(text);
                    }
                    enter(event) => {
                        Find.replace(event.modifiers.control && event.modifiers.alt);
                        true
                    }
                }
                IconButton {
                    width: 26px;
                    height: 26px;
                    glyph: 15px;
                    icon: Icons.replace;
                    tip: @tr("desk.find-replace-one");
                    clicked => {
                        Find.replace(false);
                    }
                }
                IconButton {
                    width: 26px;
                    height: 26px;
                    glyph: 15px;
                    icon: Icons.replace-all;
                    tip: @tr("desk.find-replace-all");
                    clicked => {
                        Find.replace(true);
                    }
                }
                Rectangle {
                    width: 48px;
                }
            }
        }
    }
}

// What a code row draws, behind and under any touch: the stop, the marks,
// the breakpoint, the number, the coloured pieces and the hints. The view
// being edited and the other group's view both draw a row with it.
component RowPaint inherits Rectangle {
    in property <Row> line;
    in property <length> gutter;
    // The caret's row: its number is bright.
    in property <bool> current;
    // Where the debugger stopped, the whole line.
    if root.line.stopped: Rectangle {
        background: Theme.amber-fill;
    }
    for mark in root.line.marks: Rectangle {
        x: root.gutter + mark.x;
        // A link's line sits a pixel under the text's baseline, which is
        // a third of the font's size below the middle of the row.
        y: mark.kind == 11 ? round((parent.height / 2 + Code.font-size * 0.35) / 1px) * 1px + 1px : mark.kind == 1 ? 2px : mark.kind >= 5 && mark.kind <= 7 ? parent.height - 4px : mark.kind == 9 ? 1px : 0;
        // A caret, and a match of nothing (`^`), are a bar; an
        // indent guide (8) a hairline.
        width: mark.kind == 1 ? 2px : mark.kind == 8 ? 1px : max(mark.width, 2px);
        height: mark.kind == 11 ? 1px : mark.kind == 1 ? parent.height - 4px : mark.kind >= 5 && mark.kind <= 7 ? 3px : mark.kind == 9 ? parent.height - 2px : parent.height;
        background: mark.kind == 11 ? Theme.link : mark.kind == 1 ? Theme.rust : mark.kind == 2 ? Theme.find-match : mark.kind == 3 ? Theme.find-current : mark.kind == 4 ? Theme.find-scope : mark.kind == 8 ? Theme.line : mark.kind == 9 ? Theme.bracket-fill : mark.kind == 10 ? Theme.occurrence : mark.kind >= 5 ? transparent : Theme.text-selection;
        // The bracket pair is a box round each, as VS Code draws it.
        border-width: mark.kind == 9 ? 1px : 0;
        border-color: Theme.bracket-match;
        border-radius: mark.kind == 9 || mark.kind == 10 ? 2px : 0;
        // Drawn where the commands say: the default fit scales a
        // path into its box less the stroke, and a wave 3 px tall
        // shrank to two thirds of its width, centred.
        if mark.kind >= 5 && mark.kind <= 7: Path {
            width: parent.width;
            height: parent.height;
            fit: preserve;
            commands: mark.path;
            stroke: mark.kind == 5 ? Theme.crimson : mark.kind == 6 ? Theme.amber : Theme.slate;
            stroke-width: 1px;
        }
    }
    // The breakpoint's dot, left of the number; the stop's arrow on
    // it. A click there sets or clears one.
    if root.line.breakpoint > 0: Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: min(10px, parent.height - 4px);
        height: self.width;
        border-radius: self.width / 2;
        background: root.line.breakpoint == 1 ? #e5484d : transparent;
        border-width: root.line.breakpoint == 2 ? 1.5px : 0;
        border-color: #e5484d;
    }
    if root.line.stopped: Path {
        x: 2px;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 2 3 H 7 L 10 6 L 7 9 H 2 Z";
        fill: Theme.amber;
        stroke: transparent;
    }
    Text {
        x: 0;
        width: root.gutter - 20px;
        height: parent.height;
        text: root.line.number;
        color: root.current ? Theme.label : Theme.label-4;
        font-family: Theme.mono;
        font-size: Code.font-size;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    for piece in root.line.pieces: Text {
        x: root.gutter + piece.x;
        height: parent.height;
        text: piece.text;
        color: Theme.token(piece.kind);
        font-italic: piece.kind == 4;
        font-family: Theme.mono;
        font-size: Code.font-size;
        vertical-alignment: center;
    }
    // The hints, in the room the pieces left them.
    for hint in root.line.hints: Rectangle {
        x: root.gutter + hint.x;
        y: 2px;
        width: hint.width;
        height: parent.height - 4px;
        border-radius: 3px;
        background: Theme.hover;
        Text {
            text: hint.text;
            color: Theme.label-3;
            font-family: Theme.mono;
            font-size: Code.font-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The other editor group's file while the keys are in this one, filled by
// `src/editor/shade.rs`: drawn and scrolled, and not edited — a press
// brings its group to front and lands where it was made.
export global Shade {
    in property <[Row]> rows;
    in property <bool> has-document;
    in property <length> content-width: 2000px;
    in-out property <length> scroll-y;
    in-out property <length> scroll-x;
    callback pressed(int /* row */, length /* x */, length /* y */);
}

export component ShadeView inherits Rectangle {
    in property <length> gutter: 64px;
    background: Theme.content;
    shade-list := ListView {
        width: parent.width;
        height: parent.height;
        content-width: max(self.visible-width, Shade.content-width);
        content-y <=> Shade.scroll-y;
        content-x <=> Shade.scroll-x;
        for shaded[index] in Shade.rows: Rectangle {
            height: Code.row-height;
            width: max(shade-list.visible-width, Shade.content-width);
            RowPaint {
                line: shaded;
                gutter: root.gutter;
            }
            TouchArea {
                mouse-cursor: text;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        Shade.pressed(index, self.mouse-x - root.gutter, self.mouse-y);
                    }
                    if (event.kind == PointerEventKind.down && (event.button == PointerEventButton.back || event.button == PointerEventButton.forward)) {
                        Code.navigate(event.button == PointerEventButton.back);
                    }
                }
            }
        }
    }
}

export component CodeView inherits Rectangle {
    in property <length> gutter: 64px;

    background: Theme.content;

    public function focus-input() {
        sink.focus();
    }

    public function focus-find(replace: bool) {
        if (replace) {
            bar.focus-replacement();
        } else {
            bar.focus-query();
        }
    }

    list := ListView {
        width: parent.width;
        height: parent.height;
        content-width: max(self.visible-width, Code.content-width);
        content-y <=> Code.scroll-y;
        content-x <=> Code.scroll-x;
        changed content-y => {
            Code.view-changed();
        }
        changed visible-height => {
            Code.view-height = self.visible-height;
            Code.view-changed();
        }
        changed visible-width => {
            Code.view-width = self.visible-width;
        }
        for row[index] in Code.rows: Rectangle {
            height: Code.row-height;
            width: max(list.visible-width, Code.content-width);
            RowPaint {
                line: row;
                gutter: root.gutter;
                current: index == Code.caret-line;
            }
            TouchArea {
                x: 0;
                width: root.gutter - 20px;
                mouse-cursor: pointer;
                clicked => {
                    Code.toggle-breakpoint(index);
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && (event.button == PointerEventButton.back || event.button == PointerEventButton.forward)) {
                        Code.navigate(event.button == PointerEventButton.back);
                    }
                }
                changed has-hover => {
                    Code.gutter-hover = self.has-hover;
                }
            }
            touch := TouchArea {
                x: root.gutter - 20px;
                width: parent.width - self.x;
                // A hand over a name drawn as a link.
                mouse-cursor: Code.link-row == index ? MouseCursor.pointer : MouseCursor.text;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && (event.button == PointerEventButton.back || event.button == PointerEventButton.forward)) {
                        Code.navigate(event.button == PointerEventButton.back);
                    }
                    if (event.button == PointerEventButton.left) {
                        if (event.kind == PointerEventKind.down) {
                            Code.pointer(0, index, self.mouse-x + self.x - root.gutter, self.mouse-y, event.modifiers);
                            sink.focus();
                        } else if (event.kind == PointerEventKind.up) {
                            Code.pointer(2, index, self.mouse-x + self.x - root.gutter, self.mouse-y, event.modifiers);
                        }
                    } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                        Code.context-menu(index, self.mouse-x + self.x - root.gutter, self.mouse-y, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                    // The pointer resting over the code: `moved` is called
                    // only while a button is held, so a hover is the move
                    // a pointer event reports.
                    if (event.kind == PointerEventKind.move && !self.pressed) {
                        Code.hovered(index, self.mouse-x + self.x - root.gutter, self.mouse-y);
                        Code.link-over(index, self.mouse-x + self.x - root.gutter, self.mouse-y, event.modifiers.control || event.modifiers.meta, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                moved => {
                    if (self.pressed) {
                        Code.pointer(1, index, self.mouse-x + self.x - root.gutter, self.mouse-y, {});
                    }
                }
                changed has-hover => {
                    if (!self.has-hover) {
                        Code.hovered(-1, 0, 0);
                        Code.link-left(index);
                    }
                }
            }
            // The chevron right of the number, hard against the code, as
            // VS Code puts it: shown while the pointer is in the margin, and
            // always where a block is collapsed.
            if row.fold > 0: Rectangle {
                x: root.gutter - 19px;
                width: 16px;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    path: row.fold == 2 ? Icons.chevron-right : Icons.chevron;
                    size: min(12px, Code.row-height - 6px);
                    color: fold-touch.has-hover ? Theme.label : Theme.label-3;
                    visible: row.fold == 2 || Code.gutter-hover || fold-touch.has-hover;
                }
                fold-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Code.fold(index);
                    }
                    changed has-hover => {
                        Code.gutter-hover = self.has-hover;
                    }
                }
            }
            // What a collapsed block hides, as one mark after its header; a
            // click opens it.
            if row.fold == 2: Rectangle {
                x: root.gutter + row.fold-x;
                y: 3px;
                width: dots.preferred-width + 10px;
                height: parent.height - 6px;
                border-radius: 3px;
                background: ellipsis-touch.has-hover ? Theme.hover : Theme.sunken;
                dots := Text {
                    x: 5px;
                    text: "…";
                    color: Theme.label-3;
                    font-family: Theme.mono;
                    font-size: Code.font-size;
                    vertical-alignment: center;
                }
                ellipsis-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Code.fold(index);
                    }
                }
            }
            // ▶ Run Test | Debug beside a test, where VS Code puts it; the
            // last run's verdict before it.
            if row.lens > 0: HorizontalLayout {
                x: root.gutter + row.lens-x;
                // Its own width: given the row's, the layout spread the
                // verbs across the whole line.
                width: self.preferred-width;
                height: parent.height;
                spacing: 4px;
                if row.verdict > 0: Text {
                    text: row.verdict == 1 ? "✓" : "✗";
                    color: row.verdict == 1 ? Theme.patina : Theme.crimson;
                    font-size: Code.font-size * 0.85;
                    vertical-alignment: center;
                }
                Text {
                    text: row.lens == 2 ? @tr("files.lens-run") : row.lens == 3 ? @tr("files.lens-run-tests") : @tr("files.lens-run-test");
                    color: run-touch.has-hover ? Theme.rust : Theme.label-3;
                    font-size: Code.font-size * 0.85;
                    vertical-alignment: center;
                    run-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Code.lens(index, "run");
                        }
                    }
                }
                if row.lens != 2: Text {
                    text: "|";
                    color: Theme.label-4;
                    font-size: Code.font-size * 0.85;
                    vertical-alignment: center;
                }
                if row.lens != 2: Text {
                    text: @tr("files.lens-debug");
                    color: debug-touch.has-hover ? Theme.rust : Theme.label-3;
                    font-size: Code.font-size * 0.85;
                    vertical-alignment: center;
                    debug-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Code.lens(index, "debug");
                        }
                    }
                }
            }
        }
    }

    // Where the next key lands. Drawn here rather than by the TextInput, whose
    // own caret sits after whatever it is composing.
    Rectangle {
        x: root.gutter + Code.caret-x + list.content-x - (Code.block-caret ? 0px : 1px);
        y: Code.caret-line * Code.row-height + list.content-y + 2px;
        width: Code.block-caret ? Code.caret-width : 2px;
        height: Code.row-height - 4px;
        // Translucent, so the character under the block still shows.
        background: Code.block-caret ? Theme.rust.with-alpha(0.45) : Theme.rust;
        visible: Code.has-document && sink.preedit-text == "" && sink.has-focus;
    }

    // Every character arrives here, typed or composed: an input method shows
    // its composition in place, at the caret, and commits it as an edit.
    // Keys that are not text go to `key` first and never reach it.
    sink := TextInput {
        x: root.gutter + Code.caret-x + list.content-x;
        y: Code.caret-line * Code.row-height + list.content-y;
        // No width while nothing is composed: a TextInput takes the
        // pointer over it, so the few pixels at the caret were where a
        // click, a hover and Ctrl over a name never reached the code.
        width: self.preedit-text == "" ? 0px : max(2px, self.preferred-width);
        height: Code.row-height;
        font-family: Theme.mono;
        font-size: Code.font-size;
        color: Theme.label;
        vertical-alignment: center;
        single-line: true;
        text-cursor-width: 0px;
        key-pressed(event) => {
            if (self.preedit-text != "") {
                return reject;
            }
            if (Code.key(event)) {
                return accept;
            }
            reject
        }
        key-released(event) => {
            Code.key-released(event);
            reject
        }
        changed has-focus => {
            if (!self.has-focus) {
                Code.blurred();
            }
        }
        edited => {
            if (self.preedit-text == "" && self.text != "") {
                Code.typed(self.text);
                self.text = "";
            }
        }
    }

    // A theme change recolours the minimap, which is painted in Rust.
    property <bool> dark: Theme.dark;
    changed dark => {
        Code.view-changed();
    }

    // The stuck lines, over the rows they cover, in the margin's own style;
    // sideways with the text.
    if Code.sticky-rows.length > 0: Rectangle {
        x: 0;
        y: 0;
        width: list.visible-width;
        height: Code.sticky-rows.length * Code.row-height + 1px;
        background: Theme.content;
        clip: true;
        for row[i] in Code.sticky-rows: Rectangle {
            y: i * Code.row-height;
            height: Code.row-height;
            background: sticky-touch.has-hover ? Theme.hover : transparent;
            Text {
                x: list.content-x;
                width: root.gutter - 20px;
                height: parent.height;
                text: row.number;
                color: Theme.label-4;
                font-family: Theme.mono;
                font-size: Code.font-size;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            for piece in row.pieces: Text {
                x: root.gutter + piece.x + list.content-x;
                height: parent.height;
                text: piece.text;
                color: Theme.token(piece.kind);
                font-italic: piece.kind == 4;
                font-family: Theme.mono;
                font-size: Code.font-size;
                vertical-alignment: center;
            }
            sticky-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Code.sticky-pick(i);
                }
                scroll-event(event) => {
                    Code.scroll-y = max(min(0px, Code.scroll-y + event.delta-y), min(0px, list.visible-height - list.content-height));
                    accept
                }
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.line;
        }
    }

    // The minimap, left of the scrollbar: the rows it shows, painted, and
    // the slider over the rows the view shows.
    if Code.minimap-on && Code.has-document: Rectangle {
        x: parent.width - self.width - 14px;
        width: 96px;
        height: parent.height;
        background: Theme.content;
        clip: true;
        Image {
            x: 0;
            y: Code.minimap-offset;
            width: 96px;
            height: Code.minimap-rows * 2px;
            source: Code.minimap;
            image-fit: fill;
            image-rendering: pixelated;
        }
        Rectangle {
            y: Code.minimap-slider-top;
            height: Code.minimap-slider-height;
            background: map-touch.pressed ? Theme.line-strong : map-touch.has-hover ? Theme.line : Theme.hover;
        }
        map-touch := TouchArea {
            mouse-cursor: default;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    Code.minimap-to(self.mouse-y);
                }
            }
            moved => {
                if (self.pressed) {
                    Code.minimap-to(self.mouse-y);
                }
            }
            scroll-event(event) => {
                Code.scroll-y = max(min(0px, Code.scroll-y + event.delta-y), min(0px, list.visible-height - list.content-height));
                accept
            }
        }
    }

    // The signature above the caret's line, the popup under it — above the
    // line when there is no room below.
    if Code.signature-open: SignatureCard {
        property <length> line-top: Code.signature-line * Code.row-height + list.content-y;
        x: max(4px, min(root.gutter + Code.signature-x + list.content-x - 10px, root.width - self.width - 12px));
        y: self.line-top - self.height - 2px >= 0 ? self.line-top - self.height - 2px : self.line-top + Code.row-height + 2px;
    }
    if Code.completion-open: CompletionPopup {
        property <length> line-top: Code.completion-line * Code.row-height + list.content-y;
        x: max(4px, min(root.gutter + Code.completion-x + list.content-x - 28px, root.width - self.width - 12px));
        y: self.line-top + Code.row-height + self.height + 2px <= root.height ? self.line-top + Code.row-height + 2px : self.line-top - self.height - 2px;
    }

    // Above the line it is about, or below it when there is no room above;
    // never past the view's right edge.
    if Code.hover-open: HoverCard {
        property <length> line-top: Code.hover-line * Code.row-height + list.content-y;
        x: max(4px, min(root.gutter + Code.hover-x + list.content-x, root.width - self.width - 12px));
        y: self.line-top - self.height - 2px >= 0 ? self.line-top - self.height - 2px : self.line-top + Code.row-height + 2px;
    }

    bar := FindBar {
        x: parent.width - self.width - 22px;
        y: 0;
        visible: Find.open;
    }
}
