// One icon. `filled` for the few drawn as solid shapes.
export component Icon {
    in property <string> path;
    in property <brush> color: Theme.label-2;
    in property <length> size: 16px;
    in property <bool> filled;
    width: root.size;
    height: root.size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: root.path;
        stroke: root.color;
        stroke-width: 1.5px * root.size / 20px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.filled ? root.color : transparent;
    }
}
