// The title bar is the run loop: rusty's mark, which opens the window's
// menu; which project, which branch; the run button, where it runs and
// stop; the palette; the window's own controls. Dragging anywhere empty
// moves the window, and a double-click maximizes it.

import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { IconButton, Tip } from "widgets.slint";
import { Shell } from "shell.slint";

// A word with a chevron that opens a list: the project, the branch, the
// target.
component Chooser inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> strong;
    callback clicked;
    height: 26px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 6px;
        if root.icon != "": Icon {
            path: root.icon;
            size: 14px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.strong ? Theme.label : Theme.label-2;
            font-size: Theme.body;
            font-weight: root.strong ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            path: Icons.chevron;
            size: 12px;
            color: Theme.label-3;
            y: (parent.height - self.height) / 2;
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The run control: the button, where it runs, stop. One verb whose meaning is
// the target — simulate when the simulator is chosen, flash when a board is.
component RunControl inherits Rectangle {
    height: 28px;
    border-radius: 7px;
    background: Theme.sunken;
    border-width: 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 1px;
        spacing: 0;
        IconButton {
            width: 30px;
            height: 26px;
            icon: Shell.running ? Icons.stop : Icons.play;
            tint: Shell.running ? Theme.crimson : Theme.patina;
            tip: Shell.running ? @tr("toolbar.stop") : @tr("desk.run");
            clicked => {
                Shell.act(Shell.running ? "run.stop" : "run.run");
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.line;
        }
        target := Rectangle {
            border-radius: 6px;
            background: target-touch.has-hover ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 4px;
                Icon {
                    path: Shell.target-kind == "simulator" ? Icons.simulate : Shell.target-kind == "board" ? Icons.chip : Icons.warn;
                    size: 15px;
                    color: Shell.target-kind == "" ? Theme.amber : Theme.label;
                    y: (parent.height - self.height) / 2;
                }
                // What is chosen, in words: a value, so it is shown, not
                // only hovered for — bounded, and cut short with an ellipsis.
                if Shell.target-label != "": Text {
                    text: Shell.target-label;
                    color: Shell.target-kind == "" ? Theme.amber : Theme.label;
                    font-size: Theme.body;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 180px;
                }
                Icon {
                    path: Icons.chevron;
                    size: 11px;
                    color: Theme.label-3;
                    y: (parent.height - self.height) / 2;
                }
            }
            target-touch := TouchArea {
                clicked => {
                    Tip.shown = false;
                    Shell.act("run.choose-target");
                }
                changed has-hover => {
                    if (!self.has-hover) {
                        Tip.shown = false;
                    }
                }
            }
            Timer {
                interval: 600ms;
                running: target-touch.has-hover && Shell.target != "" && !Tip.shown;
                triggered => {
                    Tip.text = Shell.target;
                    Tip.x = target.absolute-position.x;
                    Tip.y = target.absolute-position.y + target.height + 4px;
                    Tip.shown = true;
                }
            }
        }
    }
}

// rusty's mark, the window's own icon, at the far left: a click opens the
// window's menu — what ≡ opens — as a Windows app's icon opens its own.
component Logo inherits Rectangle {
    width: 30px;
    height: 28px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    Image {
        source: @image-url("../icons/rusty.png");
        width: 20px;
        height: 20px;
        image-rendering: smooth;
    }
    touch := TouchArea {
        clicked => {
            Tip.shown = false;
            Shell.act("app.menu");
        }
        changed has-hover => {
            if (!self.has-hover) {
                Tip.shown = false;
            }
        }
    }
    Timer {
        interval: 600ms;
        running: touch.has-hover && !Tip.shown;
        triggered => {
            Tip.text = @tr("desk.app-menu");
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.shown = true;
        }
    }
}

// The window's own buttons: full height, square, the close one red on hover,
// as every desktop draws them.
component WindowButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> danger;
    callback clicked;
    width: 46px;
    background: touch.has-hover ? (root.danger ? #c42b1c : Theme.hover) : transparent;
    Icon {
        path: root.icon;
        size: 14px;
        color: touch.has-hover && root.danger ? #ffffff : Theme.label-2;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component TitleBar inherits Rectangle {
    in property <bool> maximized;
    callback minimize();
    callback toggle-maximize();
    callback close();

    height: 40px;
    background: Theme.window;

    WindowMoveArea {
        TouchArea {
            double-clicked => {
                root.toggle-maximize();
            }
        }
    }

    // The middle is the window's middle, whatever the sides hold.
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        RunControl {
            y: (parent.height - self.height) / 2;
        }
    }

    HorizontalLayout {
        // Past the traffic lights on a Mac, which sit over this bar.
        padding-left: Theme.macos ? 78px : 6px;
        spacing: 2px;
        alignment: start;
        Logo {
            y: (parent.height - self.height) / 2;
        }
        Chooser {
            y: (parent.height - self.height) / 2;
            text: Shell.has-project ? Shell.project : @tr("chrome.no-project-title");
            strong: true;
            clicked => {
                Shell.act("project.menu");
            }
        }
        if Shell.branch != "": Chooser {
            y: (parent.height - self.height) / 2;
            text: Shell.branch;
            icon: Icons.branch;
            clicked => {
                Shell.act("git.branches");
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 2px;
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.search;
            tip: @tr("menu.view.quick-open");
            clicked => {
                Shell.act("finder.open");
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.menu;
            tip: @tr("menu.view.palette");
            clicked => {
                Shell.act("app.menu");
            }
        }
        // The window's buttons are the system's on a Mac.
        if !Theme.macos: Rectangle {
            width: 10px;
        }
        if !Theme.macos: WindowButton {
            icon: Icons.minimize;
            tip: @tr("desk.minimize");
            clicked => {
                root.minimize();
            }
        }
        if !Theme.macos: WindowButton {
            icon: root.maximized ? Icons.restore : Icons.maximize;
            tip: root.maximized ? @tr("desk.restore") : @tr("desk.maximize");
            clicked => {
                root.toggle-maximize();
            }
        }
        if !Theme.macos: WindowButton {
            icon: Icons.close;
            tip: @tr("chrome.close");
            danger: true;
            clicked => {
                root.close();
            }
        }
        if Theme.macos: Rectangle {
            width: 6px;
        }
    }
}
