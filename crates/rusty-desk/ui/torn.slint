// A tab moved into a window of its own: VS Code's Move into New Window.
//
// The same code view as the main window's, over the same document — Slint
// gives each window its own `Code` and `Find`, and the editor's Rust half
// (`src/editor/`) drives whichever window's it was made for. One file per
// window: its tab, the code, and a status line with the caret. The window's
// own frame carries its title, the file, the project and rusty.

import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { IconButton } from "widgets.slint";
import { Code, CodeView } from "editor.slint";
import { Tooltip } from "chrome.slint";

export component TornWindow inherits Window {
    // What the task bar calls the window: the file, the project, rusty.
    in property <string> caption: "rusty";
    title: root.caption;
    icon: @image-url("../icons/rusty.png");
    preferred-width: 960px;
    preferred-height: 720px;
    min-width: 360px;
    min-height: 240px;
    background: Theme.window;
    default-font-size: Theme.body;

    // What the editor measures its characters with (`src/editor/metrics.rs`).
    in property <string> probe-text;
    out property <length> probe-width: probe.preferred-width;

    // The file's tab: its name, what tells it from another of the same name,
    // and whether it has changes not saved.
    in property <string> name;
    in property <string> hint;
    in property <bool> dirty;
    // The caret as people number it, Vim's mode when Vim is on, and what the
    // last key here could not do.
    in property <string> caret;
    in property <string> mode;
    in property <string> message;

    // Keys the code view did not take: the bindings get them.
    callback key(KeyEvent) -> bool;
    callback close-tab();
    // The tab back among the main window's.
    callback move-back();
    // The tab carried a few pixels from its press (`begun` the first time),
    // where the pointer is in this window — beyond it, very likely, over
    // the main window — and let go of there: onto the main window's strips
    // or code it goes back in (`src/app/tab_drag.rs`). Escape gives it up.
    callback tab-drag(bool, length, length);
    callback tab-dropped(length, length);
    callback tab-drag-cancel();

    // The window took a new size: made on its display, resized, or moved
    // to a display of another scale — its zoom is worked out again, as the
    // main window's is (`zoom::apply_to`).
    callback resized();
    changed width => {
        root.resized();
    }
    changed height => {
        root.resized();
    }

    public function focus-code() {
        code.focus-input();
    }

    public function focus-find(replace: bool) {
        code.focus-find(replace);
    }

    probe := Text {
        visible: false;
        text: root.probe-text;
        font-family: Theme.mono;
        font-size: Code.font-size;
    }

    FocusScope {
        capture-key-pressed(event) => {
            if (tab-touch.held && tab-touch.carried && event.text == Key.Escape) {
                tab-touch.carried = false;
                tab-touch.held = false;
                root.tab-drag-cancel();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if (root.key(event)) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            Rectangle {
                height: 36px;
                background: Theme.window;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: min(row.preferred-width, 320px);
                        background: Theme.content;
                        opacity: tab-touch.held && tab-touch.carried ? 0.45 : 1.0;
                        // Pressed and carried more than four pixels, the tab
                        // is dragged: the main window draws where it would
                        // land, as its own tabs' drags do.
                        tab-touch := TouchArea {
                            z: -1;
                            property <bool> held;
                            property <bool> carried;
                            property <length> press-x;
                            property <length> press-y;
                            moved => {
                                if (self.held && !self.carried && (abs(self.mouse-x - self.press-x) > 4px || abs(self.mouse-y - self.press-y) > 4px)) {
                                    self.carried = true;
                                    root.tab-drag(true, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                } else if (self.held && self.carried) {
                                    root.tab-drag(false, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    self.held = true;
                                    self.carried = false;
                                    self.press-x = self.mouse-x;
                                    self.press-y = self.mouse-y;
                                }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                    self.held = false;
                                    if (self.carried) {
                                        self.carried = false;
                                        root.tab-dropped(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                        }
                        row := HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            spacing: 6px;
                            Text {
                                text: root.name;
                                color: Theme.label;
                                font-size: Theme.small;
                                vertical-alignment: center;
                            }
                            if root.hint != "": Text {
                                text: root.hint;
                                color: Theme.label-3;
                                font-size: Theme.caption;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 20px;
                                if root.dirty && !close-touch.has-hover: Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 3.5px;
                                    background: Theme.label-2;
                                }
                                if !root.dirty || close-touch.has-hover: Icon {
                                    path: Icons.close;
                                    size: 12px;
                                    color: close-touch.has-hover ? Theme.label : Theme.label-3;
                                }
                                close-touch := TouchArea {
                                    clicked => {
                                        root.close-tab();
                                    }
                                }
                            }
                        }
                        Rectangle {
                            y: 0;
                            height: 2px;
                            background: Theme.rust;
                        }
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: Theme.line;
                        }
                    }
                }
                IconButton {
                    x: parent.width - self.width - 6px;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.restore;
                    tip: @tr("desk.attach");
                    clicked => {
                        root.move-back();
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
            }
            code := CodeView { }
            Rectangle {
                height: 24px;
                background: Theme.window;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 14px;
                    Text {
                        text: root.message;
                        color: Theme.amber;
                        font-size: Theme.caption;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.mode != "": Text {
                        text: root.mode;
                        color: Theme.label-2;
                        font-size: Theme.caption;
                        font-family: Theme.mono;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.caret;
                        color: Theme.label-2;
                        font-size: Theme.caption;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    Tooltip { }
}
