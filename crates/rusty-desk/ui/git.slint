// The repository: the Git panel in the left dock (what is checked out, the
// commit box, the staged and unstaged files, the stashes), the History page
// (every ref, the graph, a commit opened below), the Changes page (one
// file's diff) and the name field. Filled by `src/app/git.rs` and
// `src/app/git_view.rs`; the graph's lines are laid out there, and drawn here.

import { ListView, ScrollView, TextEdit, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { Shell, DiffRow, DiffSel, GitChange, GitCommitRow } from "shell.slint";
import { IconButton, Button, Caption, Field, Segments, Splitter } from "widgets.slint";

// A change's letter colour.
export global GitTone {
    pure public function of(tone: int) -> color {
        return tone == 1 ? Theme.patina : tone == 2 ? Theme.amber : tone == 3 ? Theme.crimson : tone == 4 ? Theme.slate : Theme.label-4;
    }
}

// A row's fill by its kind: added green, removed red, a header sunken, a
// side left blank across from the other's run half sunken.
global DiffTone {
    pure public function fill(kind: int) -> brush {
        return kind == 1 ? Theme.patina-fill : kind == 2 ? Theme.crimson-fill : kind == 3 ? Theme.sunken : kind == 5 ? Theme.sunken.with-alpha(0.5) : transparent;
    }
}

// A line number, right against its column's edge.
component DiffNumber inherits Text {
    x: 0px;
    color: Theme.label-4;
    font-family: Theme.mono;
    font-size: Theme.caption;
    horizontal-alignment: right;
    vertical-alignment: center;
}

// One side's text in a row: a window of its own that clips and scrolls
// sideways, and the part of it selected. `line` is whether the row is a
// line of this side at all — a note, a header or a blank is not, and is
// never selected (`src/diff_select.rs` reads the rows the same way).
component DiffLine inherits Rectangle {
    in property <string> text;
    in property <bool> note;
    in property <bool> line;
    in property <int> side;
    // Which row of the patch: `row` is every element's grid placement.
    in property <int> at;
    in property <DiffSel> selection;
    in property <length> scroll-x;
    in property <length> pad;
    property <bool> selected: root.line && root.selection.active && root.selection.side == root.side && root.at >= root.selection.from-row && root.at <= root.selection.to-row;
    property <length> sel-start: root.at == root.selection.from-row ? root.selection.from-x : 0px;
    // To the end of the line and a little past it — its break — unless the
    // selection ends on this row.
    property <length> sel-end: root.at == root.selection.to-row ? root.selection.to-x : label.preferred-width + 6px;
    clip: true;
    if root.selected: Rectangle {
        x: root.pad + root.scroll-x + root.sel-start;
        width: max(0px, root.sel-end - root.sel-start);
        background: Theme.text-selection;
    }
    label := Text {
        x: root.pad + root.scroll-x;
        width: self.preferred-width;
        text: root.text;
        color: root.note ? Theme.label-3 : Theme.label;
        font-italic: root.note;
        font-family: Theme.mono;
        font-size: Theme.small;
        vertical-alignment: center;
    }
}

// A hunk's header on one side, clipped to it: drawn once per side, as Fork
// draws it, so nothing crosses the line between the columns.
component DiffHeader inherits Rectangle {
    in property <string> text;
    background: Theme.sunken;
    clip: true;
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: Theme.slate;
        font-family: Theme.mono;
        font-size: Theme.caption;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A patch, one column or two, in the editor's font. Each side's text
// clips to its own column and both scroll sideways together, as VS Code's
// side-by-side diff does; the line between the columns is dragged. A drag
// selects lines and characters on the side it started on, and copies that
// side's text alone — no numbers, no `+` or `-` (`src/app/git_select.rs`).
export component DiffView inherits Rectangle {
    in property <[DiffRow]> rows;
    in property <bool> split;
    in property <string> note;
    // Which page's diff, for what a press or a key tells: "history" or
    // "changes".
    in property <string> view;
    in property <DiffSel> selection;
    // The widest line of each side as drawn, for how far the text scrolls
    // sideways; the one column's is the left.
    in property <length> wide-left;
    in property <length> wide-right;
    property <length> row-h: 18px;
    property <length> number-w: 40px;
    // The one column's `+` and `-`: a column of their own, so the text a
    // selection measures starts where it is drawn.
    property <length> mark-w: 14px;
    property <length> pad: 6px;
    property <length> top: root.rows.length > 0 && root.note != "" ? 22px : 0px;
    in-out property <length> scroll-x: 0px;
    // The side the last press was on, which a drag stays on.
    property <int> drag-side;
    property <length> body-w: list.visible-width;
    // Where the columns part: the share the line was left at, each column
    // at least 140 px while there is room for both.
    property <length> left-w: root.split ? Shell.pane-fit(root.body-w * Shell.history-sides, root.body-w - 1px, 140px, 140px) : root.body-w;
    property <length> right-x: root.left-w + 1px;
    property <length> right-w: max(0px, root.body-w - root.right-x);
    // Each side's window onto its text, and where its text starts.
    property <length> left-win-x: root.split ? root.number-w : 2 * root.number-w + root.mark-w;
    property <length> left-win-w: max(0px, root.left-w - root.left-win-x);
    property <length> right-win-w: max(0px, root.right-w - root.number-w);
    property <length> max-scroll: max(0px, (root.split ? max(root.wide-left - root.left-win-w, root.wide-right - root.right-win-w) : root.wide-left - root.left-win-w) + 2 * root.pad);
    background: Theme.content;

    // A new patch starts at its left edge.
    changed rows => {
        root.scroll-x = 0px;
    }

    // The keys back from the menu that took them.
    property <int> focus-asked: Shell.diff-focus;
    changed focus-asked => {
        if (Shell.diff-focus-view == root.view) {
            keys.focus();
        }
    }

    // How far into the side's text a point of a row is.
    pure function text-x(side: int, x: length) -> length {
        return x - (side == 1 ? root.right-x + root.number-w : root.left-win-x) - root.pad - root.scroll-x;
    }

    // The wheel over the rows, taken by them as the code view's is: up and
    // down moves the list at once, sideways — or Shift and the wheel — the
    // text of both sides.
    function wheel(shift: bool, dx: length, dy: length) {
        root.scroll-x = max(min(0px, root.scroll-x + (shift && dx == 0px ? dy : dx)), -root.max-scroll);
        list.content-y = max(min(0px, list.content-y + (shift && dx == 0px ? 0px : dy)), min(0px, list.visible-height - root.rows.length * root.row-h));
    }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt) {
                if (event.text == "c" || event.text == "C" || event.text == Key.Insert) {
                    return Shell.diff-key(root.view, "copy", root.drag-side) ? accept : reject;
                }
                if (event.text == "a" || event.text == "A") {
                    return Shell.diff-key(root.view, "all", root.drag-side) ? accept : reject;
                }
            }
            if (event.text == Key.Escape) {
                return Shell.diff-key(root.view, "clear", root.drag-side) ? accept : reject;
            }
            reject
        }
    }

    if root.rows.length == 0: Text {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        text: root.note;
        color: Theme.label-3;
        font-size: Theme.small;
        wrap: word-wrap;
    }
    if root.rows.length > 0 && root.note != "": Text {
        y: 0px;
        width: parent.width;
        height: root.top;
        text: root.note;
        color: Theme.amber;
        font-size: Theme.caption;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    list := ListView {
        y: root.top;
        width: parent.width;
        height: parent.height - root.top;
        visible: root.rows.length > 0;
        // The rows never widen the view: each side scrolls its own text.
        content-width: self.visible-width;
        for row[index] in root.rows: Rectangle {
            width: root.body-w;
            height: root.row-h;
            // One column: both numbers, the marker, the text.
            if !root.split: Rectangle {
                background: DiffTone.fill(row.kind);
                if row.kind == 3: DiffHeader {
                    text: row.text;
                }
                if row.kind != 3: DiffNumber {
                    width: root.number-w - 6px;
                    text: row.old;
                }
                if row.kind != 3: DiffNumber {
                    x: root.number-w;
                    width: root.number-w - 6px;
                    text: row.new;
                }
                if row.kind != 3: Text {
                    x: 2 * root.number-w + 2px;
                    width: root.mark-w;
                    text: row.kind == 1 ? "+" : row.kind == 2 ? "-" : "";
                    color: row.kind == 1 ? Theme.patina : Theme.crimson;
                    font-family: Theme.mono;
                    font-size: Theme.small;
                    vertical-alignment: center;
                }
                if row.kind != 3: DiffLine {
                    x: root.left-win-x;
                    width: root.left-win-w;
                    text: row.text;
                    note: row.kind == 4;
                    line: row.kind <= 2;
                    side: 0;
                    at: index;
                    selection: root.selection;
                    scroll-x: root.scroll-x;
                    pad: root.pad;
                }
            }
            // Two columns: each side its number and its text, its header
            // its own, clipped to its column.
            if root.split: Rectangle {
                x: 0px;
                width: root.left-w;
                background: DiffTone.fill(row.kind);
                clip: true;
                if row.kind == 3: DiffHeader {
                    text: row.text;
                }
                if row.kind != 3: DiffNumber {
                    width: root.number-w - 6px;
                    text: row.old;
                }
                if row.kind != 3: DiffLine {
                    x: root.number-w;
                    width: root.left-win-w;
                    text: row.text;
                    note: row.kind == 4;
                    line: row.kind <= 2;
                    side: 0;
                    at: index;
                    selection: root.selection;
                    scroll-x: root.scroll-x;
                    pad: root.pad;
                }
            }
            if root.split: Rectangle {
                x: root.right-x;
                width: root.right-w;
                background: DiffTone.fill(row.kind == 3 ? 3 : row.right-kind);
                clip: true;
                if row.kind == 3: DiffHeader {
                    text: row.text;
                }
                if row.kind != 3: DiffNumber {
                    width: root.number-w - 6px;
                    text: row.new;
                }
                if row.kind != 3: DiffLine {
                    x: root.number-w;
                    width: root.right-win-w;
                    text: row.right-text;
                    note: row.right-kind == 4;
                    line: row.right-kind <= 2;
                    side: 1;
                    at: index;
                    selection: root.selection;
                    scroll-x: root.scroll-x;
                    pad: root.pad;
                }
            }
            // Over the row: a press starts a selection on the side it lands
            // on, a drag carries it there whatever row it crosses, a
            // double-click takes a word; the right button opens the menu.
            TouchArea {
                mouse-cursor: MouseCursor.text;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.drag-side = root.split && self.mouse-x >= root.right-x ? 1 : 0;
                        keys.focus();
                        Shell.diff-pointer(root.view, 0, index, root.drag-side, root.text-x(root.drag-side, self.mouse-x), event.modifiers.shift);
                    } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                        root.drag-side = root.split && self.mouse-x >= root.right-x ? 1 : 0;
                        keys.focus();
                        Shell.diff-menu(root.view, root.drag-side, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                moved => {
                    if (self.pressed) {
                        Shell.diff-pointer(root.view, 1, index + floor(self.mouse-y / root.row-h), root.drag-side, root.text-x(root.drag-side, self.mouse-x), false);
                    }
                }
                double-clicked => {
                    Shell.diff-pointer(root.view, 2, index, root.drag-side, root.text-x(root.drag-side, self.mouse-x), false);
                }
                scroll-event(event) => {
                    if (event.modifiers.control) {
                        return reject;
                    }
                    root.wheel(event.modifiers.shift, event.delta-x, event.delta-y);
                    accept
                }
            }
        }
    }
    // The line between the columns, dragged; a double-click puts it back
    // at halves.
    if root.split && root.rows.length > 0: Splitter {
        property <length> start;
        x: root.left-w;
        y: root.top;
        width: 1px;
        height: list.height;
        pressed => {
            self.start = root.left-w;
        }
        dragged(travel) => {
            Shell.history-sides = Shell.pane-fit(self.start + travel, root.body-w - 1px, 140px, 140px) / max(1px, root.body-w);
        }
        released => {
            Shell.history-resized("sides", Shell.history-sides);
        }
        reset => {
            Shell.history-reset("sides");
        }
    }
    // How far the text is scrolled sideways, when it can be: a thumb along
    // the foot, dragged.
    if root.max-scroll > 0px && root.rows.length > 0: bar := Rectangle {
        property <length> track: self.width - 16px;
        property <length> thumb: max(28px, self.track * root.left-win-w / (root.left-win-w + root.max-scroll));
        x: 0px;
        y: parent.height - self.height;
        width: list.visible-width;
        height: 8px;
        Rectangle {
            x: 2px + (-root.scroll-x / root.max-scroll) * (bar.track - bar.thumb);
            y: 2px;
            width: bar.thumb;
            height: 5px;
            border-radius: 2.5px;
            background: thumb-touch.pressed || thumb-touch.has-hover ? Theme.label-3 : Theme.label-4.with-alpha(0.6);
            thumb-touch := TouchArea {
                property <length> from;
                property <length> start;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.from = self.absolute-position.x + self.mouse-x;
                        self.start = root.scroll-x;
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.scroll-x = max(min(0px, self.start - (self.absolute-position.x + self.mouse-x - self.from) * root.max-scroll / max(1px, bar.track - bar.thumb)), -root.max-scroll);
                    }
                }
            }
        }
    }
}

// A small verb on a row, shown while the row is under the pointer.
component RowVerb inherits IconButton {
    width: 22px;
    height: 22px;
    glyph: 14px;
}

// A row of the panel's lists (`src/git_rows.rs`): a group's heading with
// its count, which folds the group away; a folder of the tree, which folds
// what is under it; or a file, with its letter, its name and folder — the
// folder only in a flat list, where nothing else says it — and on hover
// the verbs for it. A file in conflict says how many conflicts are left,
// and its verbs take one side or the other whole, or mark it resolved.
component GitRow inherits Rectangle {
    in property <GitChange> entry;
    height: root.entry.kind == 0 ? 26px : 24px;
    border-radius: 5px;
    background: root.entry.kind == 2 && root.entry.selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            if (root.entry.kind != 2) {
                Shell.git-row("fold", root.entry.group, root.entry.kind == 0 ? "" : root.entry.path);
            } else if (!root.entry.nested) {
                Shell.git-file("diff", root.entry.path, root.entry.staged);
            }
        }
        double-clicked => {
            if (root.entry.kind == 2 && !root.entry.nested) {
                Shell.git-file("open", root.entry.path, root.entry.staged);
            }
        }
        pointer-event(event) => {
            if (root.entry.kind == 2 && event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                Shell.git-file-menu(root.entry.path, root.entry.staged, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 4px + root.entry.depth * 12px + (root.entry.kind == 2 && Shell.git-tree ? 4px : 0px);
        padding-right: 2px;
        spacing: 5px;
        // The fold's chevron, on a heading and a folder.
        if root.entry.kind != 2: Rectangle {
            width: 14px;
            Icon {
                y: (parent.height - self.height) / 2;
                path: root.entry.folded ? Icons.chevron-right : Icons.chevron;
                size: 14px;
                color: Theme.label-3;
            }
        }
        if root.entry.kind == 0: Caption {
            horizontal-stretch: 1;
            text: (root.entry.group == 0 ? @tr("git.conflicts-group") : root.entry.group == 1 ? @tr("git.staged") : @tr("git.changes")) + " · " + root.entry.count;
            color: root.entry.group == 0 && root.entry.count > 0 ? Theme.crimson : Theme.label-3;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.entry.kind == 1: Rectangle {
            width: 14px;
            Icon {
                y: (parent.height - self.height) / 2;
                path: Icons.folder;
                size: 14px;
                color: Theme.label-3;
            }
        }
        if root.entry.kind == 1: Text {
            text: root.entry.name;
            color: Theme.label-2;
            font-size: Theme.small;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.entry.kind == 1: Text {
            horizontal-stretch: 1;
            text: root.entry.count;
            color: Theme.label-4;
            font-size: Theme.caption;
            vertical-alignment: center;
        }
        if root.entry.kind == 2: Text {
            width: 12px;
            text: root.entry.letter;
            color: GitTone.of(root.entry.tone);
            font-family: Theme.mono;
            font-size: Theme.small;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.entry.kind == 2: Text {
            text: root.entry.name;
            color: root.entry.nested ? Theme.label-3 : Theme.label;
            font-size: Theme.small;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.entry.kind == 2: Text {
            horizontal-stretch: 1;
            text: root.entry.nested ? @tr("git.nested") : Shell.git-tree ? "" : root.entry.dir;
            color: Theme.label-3;
            font-size: Theme.caption;
            vertical-alignment: center;
            overflow: elide;
        }
        // What is left to do in a file in conflict.
        if root.entry.kind == 2 && root.entry.conflict && !touch.has-hover: Text {
            text: root.entry.note;
            color: root.entry.resolved ? Theme.patina : Theme.amber;
            font-size: Theme.caption;
            vertical-alignment: center;
        }
        // A heading's verbs, for the whole group.
        if root.entry.kind == 0 && touch.has-hover && root.entry.group == 1 && root.entry.count > 0: RowVerb {
            icon: Icons.minus;
            tip: @tr("git.unstage-all");
            clicked => {
                Shell.git-row("unstage", 1, "");
            }
        }
        if root.entry.kind == 0 && touch.has-hover && root.entry.group == 2 && root.entry.count > 0: RowVerb {
            icon: Icons.undo;
            tip: @tr("git.discard-all");
            clicked => {
                Shell.git-row("discard", 2, "");
            }
        }
        if root.entry.kind == 0 && touch.has-hover && root.entry.group == 2 && root.entry.count > 0: RowVerb {
            icon: Icons.plus;
            tip: @tr("git.stage-all");
            clicked => {
                Shell.git-row("stage", 2, "");
            }
        }
        // A folder's verbs, for what is under it.
        if root.entry.kind == 1 && touch.has-hover && root.entry.group == 1: RowVerb {
            icon: Icons.minus;
            tip: @tr("git.unstage-folder");
            clicked => {
                Shell.git-row("unstage", 1, root.entry.path);
            }
        }
        if root.entry.kind == 1 && touch.has-hover && root.entry.group == 2: RowVerb {
            icon: Icons.undo;
            tip: @tr("git.discard-folder");
            clicked => {
                Shell.git-row("discard", 2, root.entry.path);
            }
        }
        if root.entry.kind == 1 && touch.has-hover && root.entry.group == 2: RowVerb {
            icon: Icons.plus;
            tip: @tr("git.stage-folder");
            clicked => {
                Shell.git-row("stage", 2, root.entry.path);
            }
        }
        // A file's verbs.
        if root.entry.kind == 2 && touch.has-hover && !root.entry.nested: RowVerb {
            icon: Icons.files;
            tip: @tr("git.open-file");
            clicked => {
                Shell.git-file("open", root.entry.path, root.entry.staged);
            }
        }
        if root.entry.kind == 2 && touch.has-hover && root.entry.conflict: RowVerb {
            icon: Icons.take-current;
            tip: root.entry.ours ? @tr("git.take-current") : @tr("git.take-current-gone");
            clicked => {
                Shell.git-file("ours", root.entry.path, false);
            }
        }
        if root.entry.kind == 2 && touch.has-hover && root.entry.conflict: RowVerb {
            icon: Icons.take-incoming;
            tip: root.entry.theirs ? @tr("git.take-incoming") : @tr("git.take-incoming-gone");
            clicked => {
                Shell.git-file("theirs", root.entry.path, false);
            }
        }
        if root.entry.kind == 2 && touch.has-hover && root.entry.conflict: RowVerb {
            icon: Icons.check;
            tip: @tr("git.mark-resolved");
            clicked => {
                Shell.git-file("resolve", root.entry.path, false);
            }
        }
        if root.entry.kind == 2 && touch.has-hover && !root.entry.nested && !root.entry.conflict: RowVerb {
            icon: Icons.undo;
            tip: root.entry.untracked ? @tr("git.delete-untracked") : @tr("git.discard");
            clicked => {
                Shell.git-file("discard", root.entry.path, root.entry.staged);
            }
        }
        if root.entry.kind == 2 && touch.has-hover && !root.entry.nested && !root.entry.conflict: RowVerb {
            icon: root.entry.staged ? Icons.minus : Icons.plus;
            tip: root.entry.staged ? @tr("git.unstage") : @tr("git.stage");
            clicked => {
                Shell.git-file(root.entry.staged ? "unstage" : "stage", root.entry.path, root.entry.staged);
            }
        }
        if root.entry.kind == 2 && touch.has-hover && root.entry.nested: RowVerb {
            icon: Icons.plus;
            tip: @tr("git.include-nested");
            clicked => {
                Shell.git-file("include", root.entry.path, false);
            }
        }
    }
}

// Over the code of a file with merge conflicts, at the top: how many and
// which the caret is in, the way to the one before and after, and every
// block taken one way at once — VS Code's lenses do one block, this does
// the file. With no blocks left in a file git still has unmerged, the one
// thing left: mark it resolved. Floating, so its arrival moves nothing.
export component ConflictBar inherits Rectangle {
    width: bar.preferred-width;
    height: bar.preferred-height;
    border-radius: 8px;
    background: Theme.raised;
    border-width: 1px;
    border-color: Shell.conflict-count > 0 ? Theme.amber : Theme.patina;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000055;
    bar := HorizontalLayout {
        padding: 3px;
        padding-left: 10px;
        spacing: 2px;
        Text {
            text: Shell.conflict-label;
            color: Shell.conflict-count > 0 ? Theme.label : Theme.patina;
            font-size: Theme.small;
            vertical-alignment: center;
        }
        Rectangle {
            width: 6px;
        }
        if Shell.conflict-count > 0: IconButton {
            icon: Icons.arrow-up;
            tip: @tr("desk.conflict-previous");
            clicked => {
                Shell.act("editor.conflict-previous");
            }
        }
        if Shell.conflict-count > 0: IconButton {
            icon: Icons.arrow-down;
            tip: @tr("desk.conflict-next");
            clicked => {
                Shell.act("editor.conflict-next");
            }
        }
        if Shell.conflict-count > 0: Rectangle {
            width: 1px;
            background: Theme.line;
        }
        if Shell.conflict-count > 0: IconButton {
            icon: Icons.take-current;
            tip: @tr("desk.conflicts-current");
            clicked => {
                Shell.act("editor.conflicts-current");
            }
        }
        if Shell.conflict-count > 0: IconButton {
            icon: Icons.take-incoming;
            tip: @tr("desk.conflicts-incoming");
            clicked => {
                Shell.act("editor.conflicts-incoming");
            }
        }
        if Shell.conflict-count > 0: IconButton {
            icon: Icons.take-both;
            tip: @tr("desk.conflicts-both");
            clicked => {
                Shell.act("editor.conflicts-both");
            }
        }
        if Shell.conflict-count == 0 && Shell.conflict-unmerged: Button {
            text: @tr("git.mark-resolved");
            primary: true;
            clicked => {
                Shell.act("git.mark-resolved");
            }
        }
    }
}

// The left dock's panel.
export component GitPanel inherits Rectangle {
    init => {
        Shell.act("git.shown");
    }

    if Shell.git-state == 0: Text {
        x: 12px;
        y: 12px;
        text: @tr("git.loading");
        color: Theme.label-3;
        font-size: Theme.small;
    }
    if Shell.git-state == 2: VerticalLayout {
        padding: 12px;
        spacing: 10px;
        alignment: start;
        Text {
            text: @tr("git.unavailable-title");
            color: Theme.label;
            font-size: Theme.body;
            font-weight: 600;
        }
        Text {
            text: @tr("git.init-hint");
            color: Theme.label-2;
            font-size: Theme.small;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("git.init");
                primary: true;
                clicked => {
                    Shell.act("git.init");
                }
            }
        }
    }
    if Shell.git-state == 3: VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: start;
        Text {
            text: @tr("git.unavailable-title");
            color: Theme.label;
            font-weight: 600;
        }
        Text {
            text: Shell.git-problem;
            color: Theme.crimson;
            font-size: Theme.small;
            wrap: word-wrap;
        }
    }
    if Shell.git-state == 1: VerticalLayout {
        padding: 8px;
        spacing: 6px;
        // What is checked out, and the verbs that move it.
        HorizontalLayout {
            spacing: 2px;
            Icon {
                y: (parent.height - self.height) / 2;
                path: Icons.branch;
                size: 15px;
                color: Theme.rust;
            }
            Text {
                horizontal-stretch: 1;
                text: " " + Shell.git-head;
                color: Theme.label;
                font-size: Theme.small;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            IconButton {
                width: 24px;
                height: 24px;
                glyph: 15px;
                icon: Icons.history;
                tip: @tr("git.history");
                clicked => {
                    Shell.act("git.history");
                }
            }
            IconButton {
                width: 24px;
                height: 24px;
                glyph: 15px;
                icon: Icons.fetch;
                tip: @tr("git.fetch");
                clicked => {
                    Shell.act("git.fetch");
                }
            }
            IconButton {
                width: 24px;
                height: 24px;
                glyph: 15px;
                icon: Icons.pull;
                tip: Shell.git-pull-tip;
                tint: Shell.git-behind > 0 ? Theme.rust : Theme.label-2;
                clicked => {
                    Shell.act("git.pull");
                }
            }
            IconButton {
                width: 24px;
                height: 24px;
                glyph: 15px;
                icon: Icons.push;
                tip: Shell.git-push-tip;
                tint: Shell.git-ahead > 0 ? Theme.rust : Theme.label-2;
                clicked => {
                    Shell.act("git.push");
                }
            }
            IconButton {
                width: 24px;
                height: 24px;
                glyph: 15px;
                icon: Shell.git-tree ? Icons.list-flat : Icons.list-tree;
                tip: Shell.git-tree ? @tr("git.view-list") : @tr("git.view-tree");
                clicked => {
                    Shell.act("git.tree");
                }
            }
            IconButton {
                width: 24px;
                height: 24px;
                glyph: 15px;
                icon: Icons.refresh;
                tip: @tr("git.refresh");
                clicked => {
                    Shell.act("git.refresh");
                }
            }
        }
        Text {
            text: Shell.git-upstream;
            color: Theme.label-3;
            font-size: Theme.caption;
            overflow: elide;
        }
        // A merge or a rebase waiting: the two ways out.
        if Shell.git-operation != "": Rectangle {
            border-radius: 6px;
            background: Theme.amber-fill;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                Text {
                    text: Shell.git-operation;
                    color: Theme.label;
                    font-size: Theme.small;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if Shell.git-operation-message != "": Text {
                    text: Shell.git-operation-message;
                    color: Theme.label-2;
                    font-size: Theme.caption;
                    font-family: Theme.mono;
                    overflow: elide;
                }
                Text {
                    text: Shell.git-operation-detail;
                    color: Theme.label-2;
                    font-size: Theme.caption;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Button {
                        text: @tr("git.op-continue");
                        primary: true;
                        enabled: Shell.git-conflicts == 0;
                        clicked => {
                            Shell.act("git.continue");
                        }
                    }
                    Button {
                        text: @tr("git.op-abort");
                        clicked => {
                            Shell.act("git.abort");
                        }
                    }
                }
            }
        }
        // Who a commit would be signed as, asked before git refuses.
        if Shell.git-identity-needed: Rectangle {
            border-radius: 6px;
            background: Theme.sunken;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                Text {
                    text: @tr("git.identity-title");
                    color: Theme.label;
                    font-size: Theme.small;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: @tr("git.identity-detail");
                    color: Theme.label-2;
                    font-size: Theme.caption;
                    wrap: word-wrap;
                }
                name := Field {
                    placeholder: @tr("git.identity-name");
                }
                email := Field {
                    placeholder: @tr("git.identity-email");
                }
                local := CheckBox {
                    text: @tr("git.identity-local");
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: @tr("git.identity-save");
                        primary: true;
                        enabled: name.text != "" && email.text != "";
                        clicked => {
                            Shell.git-identity-save(name.text, email.text, local.checked);
                        }
                    }
                }
            }
        }
        // The commit box. Ctrl+Enter — Cmd+Enter on a Mac — commits from it,
        // as VS Code's does.
        FocusScope {
            height: 64px;
            capture-key-pressed(event) => {
                if ((event.modifiers.control || event.modifiers.meta) && event.text == Key.Return) {
                    Shell.act("git.commit");
                    return accept;
                }
                reject
            }
            message := TextEdit {
                width: parent.width;
                height: parent.height;
                text <=> Shell.git-message;
                placeholder-text: @tr("git.commit-placeholder");
                font-size: Theme.small;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            IconButton {
                width: 28px;
                icon: Icons.undo;
                tip: Shell.git-amend ? @tr("desk.git-amend-on") : @tr("git.amend");
                active: Shell.git-amend;
                clicked => {
                    Shell.act("git.amend");
                }
            }
            Button {
                horizontal-stretch: 1;
                text: Shell.git-amend ? @tr("git.amend-button") : @tr("git.commit");
                primary: true;
                enabled: !Shell.git-identity-needed && (Shell.git-amend || (Shell.git-staged-count > 0 && Shell.git-message != ""));
                clicked => {
                    Shell.act("git.commit");
                }
            }
        }
        // The lists — the conflicts, the staged, the changes — and the
        // stashes, each folding away under its heading.
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                for each in Shell.git-rows: GitRow {
                    entry: each;
                }
                if Shell.git-clean: Text {
                    height: 26px;
                    text: @tr("git.clean");
                    color: Theme.label-3;
                    font-size: Theme.caption;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 4px;
                    padding-left: 4px;
                    Rectangle {
                        width: 14px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            path: Shell.git-stashes-folded ? Icons.chevron-right : Icons.chevron;
                            size: 14px;
                            color: Theme.label-3;
                        }
                        TouchArea {
                            clicked => {
                                Shell.git-row("fold", 3, "");
                            }
                        }
                    }
                    Caption {
                        text: @tr("git.stashes-tab") + " · " + Shell.git-stashes.length;
                        vertical-alignment: center;
                        TouchArea {
                            clicked => {
                                Shell.git-row("fold", 3, "");
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        y: 4px;
                        width: 22px;
                        height: 22px;
                        glyph: 14px;
                        icon: Icons.stash;
                        tip: @tr("git.stash-save");
                        enabled: !Shell.git-clean;
                        clicked => {
                            Shell.act("git.stash");
                        }
                    }
                }
                if !Shell.git-clean && !Shell.git-stashes-folded: Field {
                    height: 26px;
                    text <=> Shell.git-stash-note;
                    placeholder: @tr("git.stash-placeholder");
                }
                for stash in Shell.git-stashes-folded ? [] : Shell.git-stashes: Rectangle {
                    height: 26px;
                    border-radius: 5px;
                    background: stash-touch.has-hover ? Theme.hover : transparent;
                    stash-touch := TouchArea { }
                    HorizontalLayout {
                        padding-left: 6px;
                        spacing: 4px;
                        Text {
                            horizontal-stretch: 1;
                            text: stash.message;
                            color: Theme.label;
                            font-size: Theme.small;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: stash.when;
                            color: Theme.label-3;
                            font-size: Theme.caption;
                            vertical-alignment: center;
                        }
                        if stash-touch.has-hover: IconButton {
                            width: 22px;
                            height: 22px;
                            glyph: 14px;
                            icon: Icons.check;
                            tip: @tr("git.apply");
                            clicked => {
                                Shell.git-stash("apply", stash.index);
                            }
                        }
                        if stash-touch.has-hover: IconButton {
                            width: 22px;
                            height: 22px;
                            glyph: 14px;
                            icon: Icons.pull;
                            tip: @tr("git.pop");
                            clicked => {
                                Shell.git-stash("pop", stash.index);
                            }
                        }
                        if stash-touch.has-hover: IconButton {
                            width: 22px;
                            height: 22px;
                            glyph: 14px;
                            icon: Icons.trash;
                            tip: @tr("git.drop");
                            clicked => {
                                Shell.git-stash("drop", stash.index);
                            }
                        }
                    }
                }
                if Shell.git-stashes.length == 0 && !Shell.git-stashes-folded: Text {
                    height: 22px;
                    text: @tr("git.no-stashes");
                    color: Theme.label-4;
                    font-size: Theme.caption;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// A piece of the opened commit's message — its subject, who wrote it and
// its hash, its body — as text a drag selects and Ctrl+C copies, never
// edited. The left button is the text's own; the right one, which the text
// leaves alone, opens the commit's text menu with what is selected in it.
component DetailText inherits Rectangle {
    in property <string> text;
    // "summary", "meta" or "body": which piece, for the menu.
    in property <string> which;
    in property <length> size: Theme.small;
    in property <int> weight: 400;
    in property <color> ink: Theme.label;
    height: input.preferred-height;
    // The menu's Select all, asked for this piece.
    property <int> select-all-asked: Shell.git-detail-select-all;
    changed select-all-asked => {
        if (Shell.git-detail-select-which == root.which) {
            input.focus();
            input.select-all();
        }
    }
    TouchArea {
        mouse-cursor: MouseCursor.text;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                Shell.git-detail-text-menu(root.which, input.anchor-position-byte-offset, input.cursor-position-byte-offset, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        input := TextInput {
            text: root.text;
            read-only: true;
            single-line: false;
            wrap: word-wrap;
            color: root.ink;
            font-size: root.size;
            font-weight: root.weight;
            selection-background-color: Theme.text-selection;
            selection-foreground-color: root.ink;
            // Nothing is typed here, so no caret is drawn.
            text-cursor-width: 0px;
        }
    }
}

// One row of the log: its slice of the graph, its labels, its subject, who
// and when, and the hash.
component LogRow inherits Rectangle {
    in property <GitCommitRow> commit;
    in property <length> graph-w;
    // Picked by a click: the page takes the keys back for Up and Down,
    // which a press in the diff or the message had taken.
    callback picked();
    // The graph never takes more than two fifths of a narrow row.
    property <length> graph-shown: min(root.graph-w, max(14px, round(root.width * 0.4 / 1px) * 1px));
    // What is left beside the graph, for the labels, the subject and the
    // columns. As it narrows the subject is elided first, down to a least
    // that leaves room for a label or two beside it; then the author goes,
    // then the date, then the hash, as Fork's columns give way. Decided by
    // the width alone, so every row of the log keeps the same columns.
    property <length> rest: root.width - 14px - root.graph-shown - 8px;
    property <length> subject-least: 200px;
    property <bool> show-hash: root.rest >= root.subject-least + 64px;
    property <bool> show-when: root.rest >= root.subject-least + 64px + 84px;
    property <bool> show-author: root.rest >= root.subject-least + 64px + 84px + 128px;
    height: 26px;
    clip: true;
    background: root.commit.selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    opacity: root.commit.dim ? 0.35 : 1;
    touch := TouchArea {
        clicked => {
            Shell.git-pick(root.commit.index);
            root.picked();
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                Shell.git-commit-menu(root.commit.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;
        // The lines leaving the row above end in this one, and this row's
        // leave it: each half drawn here, clipped to the row, so a filled
        // row below covers nothing.
        Rectangle {
            width: root.graph-shown;
            clip: true;
            for lane in root.commit.above: Path {
                x: -0.75px;
                y: -26px - 0.75px;
                width: root.graph-w + 1.5px;
                height: 52px + 1.5px;
                viewbox-width: root.graph-w / 1px;
                viewbox-height: 52;
                fit: fill;
                commands: lane.commands;
                stroke: lane.color;
                stroke-width: 1.5px;
            }
            for lane in root.commit.edges: Path {
                x: -0.75px;
                y: -0.75px;
                width: root.graph-w + 1.5px;
                height: 52px + 1.5px;
                viewbox-width: root.graph-w / 1px;
                viewbox-height: 52;
                fit: fill;
                commands: lane.commands;
                stroke: lane.color;
                stroke-width: 1.5px;
            }
            Rectangle {
                x: root.commit.lane * 14px + 7px - 4.5px;
                y: 13px - 4.5px;
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: root.commit.merge ? Theme.content : root.commit.dot;
                border-width: 2px;
                border-color: root.commit.dot;
            }
        }
        for label in root.commit.labels: Rectangle {
            y: 4px;
            height: 18px;
            // A long name is elided rather than pushing the row wide.
            width: min(label-text.preferred-width + 14px, 140px);
            border-radius: 9px;
            background: label.kind == 3 ? Theme.amber-fill : label.kind == 2 ? label.color.with-alpha(0.2) : label.color;
            border-width: label.kind == 2 ? 1px : 0;
            border-color: label.color;
            label-text := Text {
                x: 7px;
                width: parent.width - 14px;
                text: label.text;
                color: label.kind == 3 ? Theme.amber : label.kind == 2 ? Theme.label : #15130f;
                font-family: Theme.mono;
                font-size: Theme.caption;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.commit.more > 0: Text {
            text: "+" + root.commit.more;
            color: Theme.label-3;
            font-size: Theme.caption;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.commit.summary;
            color: Theme.label;
            font-size: Theme.small;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.show-author: Text {
            width: 120px;
            text: root.commit.author;
            color: Theme.label-2;
            font-size: Theme.caption;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.show-when: Text {
            width: 76px;
            text: root.commit.when;
            color: Theme.label-3;
            font-size: Theme.caption;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.show-hash: Text {
            width: 56px;
            text: root.commit.short;
            color: Theme.label-3;
            font-family: Theme.mono;
            font-size: Theme.caption;
            vertical-alignment: center;
        }
    }
}

// One column or two: the two words while there is room for them, and an
// icon that says the other way where there is not.
component SplitToggle inherits HorizontalLayout {
    in property <bool> roomy: true;
    if root.roomy: Segments {
        labels: [@tr("git.unified"), @tr("git.split")];
        values: ["unified", "split"];
        value: Shell.git-split ? "split" : "unified";
        picked(value) => {
            if ((value == "split") != Shell.git-split) {
                Shell.act("git.split");
            }
        }
    }
    if !root.roomy: IconButton {
        icon: Shell.git-split ? Icons.rows : Icons.columns;
        tip: Shell.git-split ? @tr("git.unified") : @tr("git.split");
        clicked => {
            Shell.act("git.split");
        }
    }
}

// The History page: the refs, the graph, and the commit opened below it.
export component GitPage inherits Rectangle {
    background: Theme.content;
    // Laid out to whatever width it is given, and nothing drawn past it.
    clip: true;
    init => {
        Shell.act("git.shown");
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                Shell.git-step(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                Shell.git-step(1);
                return accept;
            }
            reject
        }
    }

    if Shell.git-state != 1: Text {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        text: Shell.git-state == 0 ? @tr("git.loading") : Shell.git-state == 2 ? @tr("git.init-hint") : Shell.git-problem;
        color: Theme.label-3;
        font-size: Theme.small;
        wrap: word-wrap;
    }

    if Shell.git-state == 1: page := Rectangle {
        // The refs column at the width its divider was left at, the log
        // beside it at least 360 px. A page with no room for both keeps the
        // log: a refs column squeezed under its least is a column of
        // ellipses.
        property <bool> refs-shown: self.width >= 140px + 1px + 360px;
        property <length> refs-w: Shell.pane-fit(Shell.history-refs, self.width - 1px, 140px, 360px);
        property <length> log-w: self.width - (self.refs-shown ? self.refs-w + 1px : 0px);
        // The toolbar's verbs give way as the log narrows — a new branch
        // and refresh first, then the head's name, then the search's steps,
        // then the head's button — while the search and the filter shrink
        // to their least; what stays is fetch, pull, push and the search.
        property <bool> show-more: self.log-w >= 500px;
        property <bool> show-head: self.log-w >= 440px;
        property <bool> show-steps: self.log-w >= 320px;
        property <bool> show-reveal: self.log-w >= 280px;
        HorizontalLayout {
            // Every ref.
            if page.refs-shown: VerticalLayout {
                width: page.refs-w;
                padding: 6px;
                spacing: 6px;
                Field {
                    height: 26px;
                    placeholder: @tr("git.filter-refs");
                    // Kept outside the column, which goes when the page is
                    // too narrow for it and comes back with the filter in it.
                    text <=> Shell.git-ref-query;
                    edited(text) => {
                        Shell.git-ref-filter(text);
                    }
                }
                ListView {
                    for ref in Shell.git-refs: Rectangle {
                        height: ref.kind == 0 ? 26px : 22px;
                        border-radius: 5px;
                        background: ref.kind != 0 && ref-touch.has-hover ? Theme.hover : transparent;
                        ref-touch := TouchArea {
                            enabled: ref.kind != 0;
                            clicked => {
                                Shell.git-ref(ref.index, false);
                            }
                            double-clicked => {
                                Shell.git-ref(ref.index, true);
                            }
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                    Shell.git-ref-menu(ref.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        if ref.kind == 0: HorizontalLayout {
                            padding-left: 4px;
                            Caption {
                                text: ref.label;
                                vertical-alignment: bottom;
                            }
                            if ref.label == @tr("git.remotes"): IconButton {
                                width: 22px;
                                height: 22px;
                                glyph: 13px;
                                icon: Icons.plus;
                                tip: @tr("git.add-remote");
                                clicked => {
                                    Shell.act("git.remote");
                                }
                            }
                        }
                        if ref.kind != 0: HorizontalLayout {
                            padding-left: ref.kind == 3 ? 22px : 8px;
                            padding-right: 6px;
                            spacing: 6px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: ref.kind == 4 ? Icons.check : ref.kind == 2 ? Icons.fetch : Icons.branch;
                                size: 13px;
                                color: ref.current ? Theme.rust : ref.filtered ? Theme.slate : Theme.label-3;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: ref.label;
                                color: ref.gone ? Theme.label-3 : Theme.label;
                                font-size: Theme.small;
                                font-weight: ref.current ? 700 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: ref.detail;
                                color: Theme.label-3;
                                font-size: Theme.caption;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            if page.refs-shown: Rectangle {
                width: 1px;
                background: Theme.line;
            }
            VerticalLayout {
                // The verbs, the filter in force and the search.
                HorizontalLayout {
                    padding: 6px;
                    spacing: 4px;
                    if page.show-reveal: IconButton {
                        icon: Icons.branch;
                        tip: @tr("git.head-reveal");
                        clicked => {
                            Shell.act("git.head");
                        }
                    }
                    // The head's name keeps its width — up to 160 px, elided
                    // past it — while the search gives way beside it.
                    if page.show-head: Text {
                        width: min(self.preferred-width, 160px);
                        text: Shell.git-head;
                        color: Theme.label;
                        font-size: Theme.small;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    IconButton {
                        icon: Icons.fetch;
                        tip: @tr("git.fetch");
                        clicked => {
                            Shell.act("git.fetch");
                        }
                    }
                    IconButton {
                        icon: Icons.pull;
                        tip: Shell.git-pull-tip;
                        tint: Shell.git-behind > 0 ? Theme.rust : Theme.label-2;
                        clicked => {
                            Shell.act("git.pull");
                        }
                    }
                    IconButton {
                        icon: Icons.push;
                        tip: Shell.git-push-tip;
                        tint: Shell.git-ahead > 0 ? Theme.rust : Theme.label-2;
                        clicked => {
                            Shell.act("git.push");
                        }
                    }
                    if page.show-more: IconButton {
                        icon: Icons.plus;
                        tip: @tr("git.new-branch");
                        clicked => {
                            Shell.act("git.branch");
                        }
                    }
                    if page.show-more: IconButton {
                        icon: Icons.refresh;
                        tip: @tr("git.refresh");
                        clicked => {
                            Shell.act("git.refresh");
                        }
                    }
                    if Shell.git-filter != "": Rectangle {
                        y: 2px;
                        height: 24px;
                        min-width: 40px;
                        preferred-width: filter-row.preferred-width;
                        max-width: 200px;
                        horizontal-stretch: 1;
                        clip: true;
                        border-radius: 12px;
                        background: Theme.slate.with-alpha(0.18);
                        filter-row := HorizontalLayout {
                            padding-left: 10px;
                            spacing: 2px;
                            Text {
                                text: Shell.git-filter;
                                color: Theme.label;
                                font-size: Theme.caption;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            IconButton {
                                width: 24px;
                                height: 24px;
                                glyph: 12px;
                                icon: Icons.close;
                                tip: @tr("git.filter-clear");
                                clicked => {
                                    Shell.act("git.filter-clear");
                                }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Text {
                        max-width: self.preferred-width;
                        horizontal-stretch: 1;
                        text: Shell.git-search-count;
                        color: Theme.label-3;
                        font-size: Theme.caption;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Field {
                        min-width: 48px;
                        preferred-width: 260px;
                        max-width: 260px;
                        horizontal-stretch: 1;
                        placeholder: @tr("git.search-placeholder");
                        edited(text) => {
                            Shell.git-search(text);
                        }
                        accepted => {
                            Shell.git-search-step(true);
                        }
                    }
                    if page.show-steps: IconButton {
                        icon: Icons.arrow-up;
                        tip: "↑";
                        clicked => {
                            Shell.git-search-step(false);
                        }
                    }
                    if page.show-steps: IconButton {
                        icon: Icons.arrow-down;
                        tip: "↓";
                        clicked => {
                            Shell.git-search-step(true);
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                // The log above, the commit opened below it, parted where the
                // divider between them was left.
                below := Rectangle {
                    vertical-stretch: 1;
                    property <length> log-h: Shell.git-detail-open ? Shell.pane-fit(self.height * Shell.history-log, self.height - 1px, 80px, 140px) : self.height;
                    VerticalLayout {
                        y: 0px;
                        height: below.log-h;
                        ListView {
                            // The commit opened, brought into view when it was picked
                            // from somewhere other than its row.
                            property <int> reveal: Shell.git-reveal;
                            changed reveal => {
                                if (Shell.git-selected >= 0) {
                                    self.content-y = min(0px, max(-(self.content-height - self.visible-height), -(Shell.git-selected * 26px - self.visible-height / 2 + 13px)));
                                }
                            }
                            for row in Shell.git-log: LogRow {
                                commit: row;
                                graph-w: Shell.git-lanes * 14px;
                                picked => {
                                    keys.focus();
                                }
                            }
                        }
                        if Shell.git-truncated: HorizontalLayout {
                            height: 30px;
                            alignment: center;
                            Button {
                                y: 2px;
                                height: 26px;
                                text: @tr("git.show-more");
                                clicked => {
                                    Shell.act("git.more");
                                }
                            }
                        }
                    }
                    // The commit opened: its message and files beside the patch.
                    if Shell.git-detail-open: detail := Rectangle {
                        y: below.log-h + 1px;
                        height: below.height - below.log-h - 1px;
                        // The message and files beside the diff at the share
                        // their divider was left at, the diff at least 260 px; a
                        // room too narrow for both puts them above the diff
                        // instead, rather than squeezing either to a column of
                        // single letters.
                        property <bool> stacked: self.width < 180px + 1px + 260px;
                        property <length> details-w: self.stacked ? self.width : Shell.pane-fit(self.width * Shell.history-details, self.width - 1px, 180px, 260px);
                        property <length> details-h: self.stacked ? round(self.height * 0.45 / 1px) * 1px : self.height;
                        property <length> diff-x: self.stacked ? 0px : self.details-w + 1px;
                        property <length> diff-y: self.stacked ? self.details-h + 1px : 0px;
                        property <length> diff-w: self.width - self.diff-x;
                        clip: true;
                        VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: detail.details-w;
                            height: detail.details-h;
                            padding: 8px;
                            spacing: 4px;
                            // The message, its author and hash: text that is
                            // selected and copied, never edited.
                            HorizontalLayout {
                                DetailText {
                                    horizontal-stretch: 1;
                                    which: "summary";
                                    text: Shell.git-detail-summary;
                                    size: Theme.body;
                                    weight: 600;
                                }
                                IconButton {
                                    icon: Icons.close;
                                    tip: @tr("git.detail-hide");
                                    clicked => {
                                        Shell.act("git.detail-close");
                                    }
                                }
                            }
                            DetailText {
                                which: "meta";
                                text: Shell.git-detail-meta;
                                size: Theme.caption;
                                ink: Theme.label-3;
                            }
                            if Shell.git-detail-body != "": body-view := ScrollView {
                                height: min(body-text.height, max(60px, detail.height * 0.4));
                                content-width: self.visible-width;
                                content-height: max(self.visible-height, body-text.height);
                                body-text := DetailText {
                                    width: body-view.visible-width;
                                    which: "body";
                                    text: Shell.git-detail-body;
                                    ink: Theme.label-2;
                                }
                            }
                            ListView {
                                for file in Shell.git-detail-files: Rectangle {
                                    height: 22px;
                                    border-radius: 5px;
                                    background: file.selected ? Theme.selection : file-touch.has-hover ? Theme.hover : transparent;
                                    file-touch := TouchArea {
                                        clicked => {
                                            Shell.git-detail-file(file.index);
                                            keys.focus();
                                        }
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                                Shell.git-detail-file-menu(file.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        Text {
                                            width: 12px;
                                            text: file.letter;
                                            color: GitTone.of(file.tone);
                                            font-family: Theme.mono;
                                            font-size: Theme.small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: file.path;
                                            color: Theme.label;
                                            font-size: Theme.small;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: file.added;
                                            color: Theme.patina;
                                            font-family: Theme.mono;
                                            font-size: Theme.caption;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: file.removed;
                                            color: Theme.crimson;
                                            font-family: Theme.mono;
                                            font-size: Theme.caption;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            x: detail.stacked ? 0px : detail.details-w;
                            y: detail.stacked ? detail.details-h : 0px;
                            width: detail.stacked ? detail.width : 1px;
                            height: detail.stacked ? 1px : detail.height;
                            background: Theme.line;
                        }
                        VerticalLayout {
                            x: detail.diff-x;
                            y: detail.diff-y;
                            width: detail.diff-w;
                            height: detail.height - detail.diff-y;
                            HorizontalLayout {
                                padding: 4px;
                                alignment: end;
                                SplitToggle {
                                    roomy: detail.diff-w >= 200px;
                                }
                            }
                            DiffView {
                                view: "history";
                                rows: Shell.git-detail-rows;
                                split: Shell.git-split;
                                note: Shell.git-detail-note;
                                selection: Shell.git-detail-sel;
                                wide-left: Shell.git-detail-wide-left;
                                wide-right: Shell.git-detail-wide-right;
                            }
                        }
                        // Dragged, the message and files take the width; a
                        // double-click puts them back.
                        if !detail.stacked: Splitter {
                            property <length> start;
                            x: detail.details-w;
                            y: 0px;
                            width: 1px;
                            height: detail.height;
                            pressed => {
                                self.start = detail.details-w;
                            }
                            dragged(travel) => {
                                Shell.history-details = Shell.pane-fit(self.start + travel, detail.width - 1px, 180px, 260px) / max(1px, detail.width);
                            }
                            released => {
                                Shell.history-resized("details", Shell.history-details);
                            }
                            reset => {
                                Shell.history-reset("details");
                            }
                        }
                    }
                    // Dragged, the log takes the height; a double-click puts it
                    // back.
                    if Shell.git-detail-open: Splitter {
                        property <length> start;
                        vertical: false;
                        y: below.log-h;
                        width: parent.width;
                        height: 1px;
                        pressed => {
                            self.start = below.log-h;
                        }
                        dragged(travel) => {
                            Shell.history-log = Shell.pane-fit(self.start + travel, below.height - 1px, 80px, 140px) / max(1px, below.height);
                        }
                        released => {
                            Shell.history-resized("log", Shell.history-log);
                        }
                        reset => {
                            Shell.history-reset("log");
                        }
                    }
                }
            }
        }
        // Dragged, the refs column takes the width; a double-click puts it
        // back.
        if page.refs-shown: Splitter {
            property <length> start;
            x: page.refs-w;
            y: 0px;
            width: 1px;
            height: page.height;
            pressed => {
                self.start = page.refs-w;
            }
            dragged(travel) => {
                Shell.history-refs = Shell.pane-fit(self.start + travel, page.width - 1px, 140px, 360px);
            }
            released => {
                Shell.history-resized("refs", Shell.history-refs / 1px);
            }
            reset => {
                Shell.history-reset("refs");
            }
        }
    }
}

// The Changes page: one working-tree file's diff.
export component GitDiffPage inherits Rectangle {
    background: Theme.content;
    clip: true;
    init => {
        Shell.act("git.shown");
    }
    VerticalLayout {
        HorizontalLayout {
            padding: 6px;
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                text: Shell.git-diff-title;
                color: Theme.label;
                font-size: Theme.small;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            SplitToggle {
                roomy: root.width >= 320px;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        DiffView {
            view: "changes";
            rows: Shell.git-diff-rows;
            split: Shell.git-split;
            note: Shell.git-diff-note;
            selection: Shell.git-diff-sel;
            wide-left: Shell.git-diff-wide-left;
            wide-right: Shell.git-diff-wide-right;
        }
    }
}

// The name field: a new branch, a rename, a tag, a remote.
export component GitPrompt inherits Rectangle {
    width: 400px;
    height: column.preferred-height;
    border-radius: 10px;
    background: Theme.overlay;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000055;
    column := VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: Shell.git-prompt-title;
            color: Theme.label;
            font-size: Theme.body;
            font-weight: 600;
            wrap: word-wrap;
        }
        value := Field {
            text <=> Shell.git-prompt-value;
            mono: true;
            placeholder: Shell.git-prompt-has-url ? @tr("git.remote-name-placeholder") : "";
            trouble: Shell.git-prompt-problem != "";
            edited => {
                Shell.git-prompt-edited();
            }
            accepted => {
                if (Shell.git-prompt-ok) {
                    Shell.git-prompt-done(true);
                }
            }
            init => {
                self.focus-all();
            }
        }
        if Shell.git-prompt-has-url: Field {
            text <=> Shell.git-prompt-url;
            mono: true;
            placeholder: @tr("git.remote-url-placeholder");
            edited => {
                Shell.git-prompt-edited();
            }
            accepted => {
                if (Shell.git-prompt-ok) {
                    Shell.git-prompt-done(true);
                }
            }
        }
        if Shell.git-prompt-problem != "": Text {
            text: Shell.git-prompt-problem;
            color: Theme.crimson;
            font-size: Theme.caption;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: @tr("git.cancel");
                clicked => {
                    Shell.git-prompt-done(false);
                }
            }
            Button {
                text: @tr("git.prompt-ok");
                primary: true;
                enabled: Shell.git-prompt-ok;
                clicked => {
                    Shell.git-prompt-done(true);
                }
            }
        }
    }
}

// Clone a repository: a URL, the folder it goes into, and the directory it
// will make, said before it runs.
export component ClonePrompt inherits Rectangle {
    width: 460px;
    height: column.preferred-height;
    border-radius: 10px;
    background: Theme.overlay;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000055;
    column := VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text {
            text: @tr("git.clone-title");
            color: Theme.label;
            font-size: Theme.body;
            font-weight: 600;
        }
        Caption {
            text: @tr("git.clone-url");
        }
        Field {
            text <=> Shell.clone-url;
            mono: true;
            placeholder: @tr("git.clone-url-placeholder");
            edited => {
                Shell.clone-edited();
            }
            init => {
                self.focus-all();
            }
        }
        Caption {
            text: @tr("git.clone-into");
        }
        HorizontalLayout {
            spacing: 6px;
            Field {
                horizontal-stretch: 1;
                text <=> Shell.clone-into;
                placeholder: @tr("git.clone-into-placeholder");
                edited => {
                    Shell.clone-edited();
                }
            }
            Button {
                text: @tr("git.clone-choose");
                clicked => {
                    Shell.act("clone.choose");
                }
            }
        }
        if Shell.clone-creates != "": Text {
            text: Shell.clone-creates;
            color: Shell.clone-ready ? Theme.label-2 : Theme.crimson;
            font-family: Theme.mono;
            font-size: Theme.caption;
            wrap: word-wrap;
        }
        Text {
            text: @tr("git.clone-hint");
            color: Theme.label-3;
            font-size: Theme.caption;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: @tr("git.cancel");
                clicked => {
                    Shell.act("clone.cancel");
                }
            }
            Button {
                text: @tr("git.clone-run");
                primary: true;
                enabled: Shell.clone-ready;
                clicked => {
                    Shell.act("clone.run");
                }
            }
        }
    }
}
