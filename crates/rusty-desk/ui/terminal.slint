// The Terminal: a shell's screen as runs of same-styled text, a cell grid
// in the editor's font, and the keys typed into it while it has focus.
// Filled by `src/app/terminal.rs`.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Shell } from "shell.slint";
import { IconButton } from "widgets.slint";

export component TerminalPanel inherits Rectangle {
    // One cell of the grid, measured off the font, whose size Ctrl and the
    // wheel choose; a new size is a new count of cells.
    property <length> font-size: Shell.term-font-size;
    property <length> cell-w: measure.preferred-width / 10;
    property <length> cell-h: round(root.font-size * 1.35 / 1px) * 1px;
    changed cell-w => {
        Shell.term-resized(floor(keys.width / root.cell-w), floor(keys.height / root.cell-h));
    }
    changed cell-h => {
        Shell.term-resized(floor(keys.width / root.cell-w), floor(keys.height / root.cell-h));
    }
    measure := Text {
        visible: false;
        text: "MMMMMMMMMM";
        font-family: Theme.mono;
        font-size: root.font-size;
    }

    // The keys back here once its menu is put away.
    property <int> focus-tick: Shell.term-focus;
    changed focus-tick => {
        keys.focus();
    }

    // Shown: a shell if there is none. The theme changed: its colours.
    property <bool> dark: Theme.dark;
    changed dark => {
        Shell.act("terminal.redraw");
    }
    init => {
        Shell.act("terminal.ensure");
        keys.focus();
    }

    keys := FocusScope {
        x: 6px;
        y: 4px;
        width: parent.width - 12px;
        height: parent.height - 8px;
        changed width => {
            Shell.term-resized(floor(self.width / root.cell-w), floor(self.height / root.cell-h));
        }
        changed height => {
            Shell.term-resized(floor(self.width / root.cell-w), floor(self.height / root.cell-h));
        }
        init => {
            Shell.term-resized(floor(self.width / root.cell-w), floor(self.height / root.cell-h));
        }
        key-pressed(event) => {
            if (Shell.term-key(event)) {
                return accept;
            }
            reject
        }
        TouchArea {
            mouse-cursor: text;
            clicked => {
                keys.focus();
            }
            // A press starts a selection and a drag carries it, cell by
            // cell; the right button opens the terminal's menu.
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    Shell.term-select(0, floor(self.mouse-x / root.cell-w + 0.5), floor(self.mouse-y / root.cell-h));
                } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                    keys.focus();
                    Shell.surface-menu("terminal", "", -1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                if (self.pressed) {
                    Shell.term-select(1, floor(self.mouse-x / root.cell-w + 0.5), floor(self.mouse-y / root.cell-h));
                }
            }
            scroll-event(event) => {
                if (event.modifiers.control) {
                    Shell.content-zoom("terminal", event.delta-y);
                    return accept;
                }
                Shell.term-scroll(event.delta-y > 0 ? 3 : -3);
                accept
            }
        }
        for row[index] in Shell.term-rows: Rectangle {
            y: index * root.cell-h;
            height: root.cell-h;
            for span in row.spans: Rectangle {
                x: span.col * root.cell-w;
                width: span.cells * root.cell-w;
                background: span.own-bg ? span.bg : transparent;
                label := Text {
                    x: 0;
                    width: parent.width;
                    text: span.text;
                    color: span.own-fg ? span.fg : Theme.label;
                    font-family: Theme.mono;
                    font-size: root.font-size;
                    font-weight: span.bold ? 700 : 400;
                    font-italic: span.italic;
                    vertical-alignment: center;
                    horizontal-alignment: span.cells == 2 && span.text.character-count == 1 ? center : left;
                }
                if span.underline: Rectangle {
                    y: parent.height - 2px;
                    height: 1px;
                    background: label.color;
                }
            }
            // The selection, over the text and see-through, so a span with
            // a background of its own is selected as visibly as one without.
            if Shell.term-selected && index >= Shell.term-sel-row && index <= Shell.term-sel-end-row: Rectangle {
                x: (index == Shell.term-sel-row ? Shell.term-sel-col : 0) * root.cell-w;
                width: max(0px, index == Shell.term-sel-end-row ? Shell.term-sel-end-col * root.cell-w - self.x : parent.width - self.x);
                background: Theme.text-selection.with-alpha(0.55);
            }
        }
        // The cursor, a block while the terminal has the keyboard.
        if Shell.term-cursor-shown: Rectangle {
            x: Shell.term-cursor-col * root.cell-w;
            y: Shell.term-cursor-row * root.cell-h;
            width: root.cell-w;
            height: root.cell-h;
            background: keys.has-focus ? Theme.rust.with-alpha(0.55) : transparent;
            border-width: keys.has-focus ? 0 : 1px;
            border-color: Theme.rust;
        }
    }

    // The shell exited: say so, and offer another.
    if Shell.term-exited != "": Rectangle {
        x: parent.width - self.width - 10px;
        y: parent.height - self.height - 8px;
        width: exit-row.preferred-width;
        height: exit-row.preferred-height;
        border-radius: 6px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        exit-row := HorizontalLayout {
            padding: 4px;
            padding-left: 10px;
            spacing: 6px;
            Text {
                text: Shell.term-exited;
                color: Theme.label-2;
                font-size: Theme.caption;
                vertical-alignment: center;
            }
            IconButton {
                icon: Icons.refresh;
                tip: @tr("desk.terminal-restart");
                clicked => {
                    Shell.act("terminal.restart");
                }
            }
        }
    }
}
