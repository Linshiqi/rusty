// The window: the title bar, the three docks around the editor area, the
// status bar, and what floats over them. docs/slint.md has the design.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Splitter, Tip } from "widgets.slint";
import { Shell, PanelTab, DocTab, TabGeometry, TabDrag, TreeRow, PickRow, KeyRow, Note, Recent, ProblemRow, OutputLine, EnvRow, WizRow, WizFact, WizNote, PlaygroundCard, BoardWire, BoardWord, BoardLamp, BoardSwitch, BoardShape, BoardScreen, BoardRotor, BoardControl, BoardPart, BoardProp, LibraryRow, PlotCurve, PlotTunable, WaveLane, WaveTick, DrawRow, DrawPiece, FlightAxis, FlightMotor, DebugFrame, DebugVariable, CallLine, RegField, RegRow, SearchRow, TermSpan, TermRow, GitChange, GitStash, GitRef, GitLane, GitLabel, GitCommitRow, GitFile, DiffRow, DiffSel, MenuItem, MemBuild, MemCrate, MemSection, CrateVital, CrateDep, CrateDup, FeatPackage, FeatRow, DiskTree, DiskItemRow, DiskIdle, CodeSpan, CodeLine, MdPiece, MdLine, MdCell, MdRow, MdBlock, AiEntry, MathRow, MathStep, MathLine, LabSource, LabPreset, LabConsole, LabLane, LabRecord, LabTick, LabDot, LabParam } from "shell.slint";
import { Code, Find, Shade, Row, Piece, HoverProblem, HoverFix, CompletionRow } from "editor.slint";
import { TitleBar } from "titlebar.slint";
import { LeftDock, BottomDock, RightDock } from "docks.slint";
import { EditorArea } from "pages.slint";
import { StatusBar, Picker, Notes, Tooltip, ContextMenu } from "chrome.slint";
import { GitPrompt, ClonePrompt } from "git.slint";

// A tab moved into a window of its own (`src/app/torn.rs`).
export { TornWindow } from "torn.slint";

export { Theme, Icons, Shell, Code, Find, Shade, Tip, Row, Piece, HoverProblem, HoverFix, CompletionRow, PanelTab, DocTab, TabGeometry, TabDrag, TreeRow, PickRow, KeyRow, Note, Recent, ProblemRow, OutputLine, EnvRow, WizRow, WizFact, WizNote, PlaygroundCard, BoardWire, BoardWord, BoardLamp, BoardSwitch, BoardShape, BoardScreen, BoardRotor, BoardControl, BoardPart, BoardProp, LibraryRow, PlotCurve, PlotTunable, WaveLane, WaveTick, DrawRow, DrawPiece, FlightAxis, FlightMotor, DebugFrame, DebugVariable, CallLine, RegField, RegRow, SearchRow, TermSpan, TermRow, GitChange, GitStash, GitRef, GitLane, GitLabel, GitCommitRow, GitFile, DiffRow, DiffSel, MenuItem, MemBuild, MemCrate, MemSection, CrateVital, CrateDep, CrateDup, FeatPackage, FeatRow, DiskTree, DiskItemRow, DiskIdle, CodeSpan, CodeLine, MdPiece, MdLine, MdCell, MdRow, MdBlock, AiEntry, MathRow, MathStep, MathLine, LabSource, LabPreset, LabConsole, LabLane, LabRecord, LabTick, LabDot, LabParam }

export component AppWindow inherits Window {
    // What the task bar calls the window: the file, the project, rusty.
    in property <string> caption: "rusty";
    title: root.caption;
    icon: @image-url("../icons/rusty.png");
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.window;
    default-font-size: Theme.body;

    // What the editor measures its characters with (`src/editor/metrics.rs`).
    in property <string> probe-text;
    out property <length> probe-width: probe.preferred-width;
    // The size the window is laid out at, for the probe's pointer: the
    // system's own size is in pixels of a scale the layout may not share.
    out property <length> laid-width: root.width;
    out property <length> laid-height: root.height;

    // The window took a new size: made on its display, resized, or moved
    // to a display of another scale. Its zoom is worked out again against
    // the display's factor, which arrives this way (`zoom::apply`).
    callback resized();
    changed width => {
        root.resized();
    }
    changed height => {
        root.resized();
    }

    // What a page measures its text with, to break a paragraph that holds a
    // formula into lines (`src/app/markdown_view.rs`): the same element the
    // page draws the text with, at the size it draws it.
    in property <styled-text> md-probe-text;
    in property <length> md-probe-size: 13px;
    out property <length> md-probe-width: md-probe.preferred-width;
    out property <length> md-probe-height: md-probe.preferred-height;
    out property <length> md-probe-ascent: md-metrics.font-metrics.ascent;
    out property <length> md-probe-descent: md-metrics.font-metrics.descent;

    public function focus-code() {
        area.focus-code();
    }

    public function focus-find(replace: bool) {
        area.focus-find(replace);
    }

    public function focus-window() {
        scope.focus();
    }

    // Where a dragged tab can land (`EditorArea.tab-geometry`).
    public function tab-geometry() -> TabGeometry {
        return area.tab-geometry();
    }

    // What a tab's name and the hint beside it measure, at the sizes the
    // strip draws them (`src/app/tab_drag.rs`): a tab is as wide as the
    // Rust side makes it from these.
    in property <string> tab-probe-title;
    in property <string> tab-probe-hint;
    out property <length> tab-probe-title-width: tab-title-probe.preferred-width;
    out property <length> tab-probe-hint-width: tab-hint-probe.preferred-width;

    tab-title-probe := Text {
        visible: false;
        text: root.tab-probe-title;
        font-size: Theme.small;
    }

    tab-hint-probe := Text {
        visible: false;
        text: root.tab-probe-hint;
        font-size: Theme.caption;
    }

    probe := Text {
        visible: false;
        text: root.probe-text;
        font-family: Theme.mono;
        font-size: Code.font-size;
    }

    // What a diff on the History page measures its characters with
    // (`src/app/git_select.rs`): its own font, smaller than the editor's.
    in property <string> diff-probe-text;
    out property <length> diff-probe-width: diff-probe.preferred-width;
    diff-probe := Text {
        visible: false;
        text: root.diff-probe-text;
        font-family: Theme.mono;
        font-size: Theme.small;
    }

    md-probe := StyledText {
        visible: false;
        text: root.md-probe-text;
        default-font-size: root.md-probe-size;
    }

    md-metrics := Text {
        visible: false;
        text: "Hg";
        font-size: root.md-probe-size;
    }

    // Keys nothing focused took arrive here, and the bindings get them.
    scope := FocusScope {
        // Escape gives a dragged tab up, wherever the keys are: before the
        // code, which would take it for itself.
        capture-key-pressed(event) => {
            if (Shell.tab-drag.on && event.text == Key.Escape) {
                Shell.tab-drag-cancel();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if (Shell.key(event)) {
                return accept;
            }
            reject
        }
        // Ctrl let go wherever the keys are: a name drawn as a link under a
        // pointer that has not moved is put away with it.
        key-released(event) => {
            Code.key-released(event);
            reject
        }

        VerticalLayout {
            TitleBar {
                maximized: root.maximized;
                minimize => {
                    root.minimized = true;
                }
                toggle-maximize => {
                    root.maximized = !root.maximized;
                }
                close => {
                    root.close();
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                if Shell.left-open: LeftDock {
                    width: Shell.left-size;
                }
                if Shell.left-open: Splitter {
                    property <length> start;
                    pressed => {
                        self.start = Shell.left-size;
                    }
                    dragged(travel) => {
                        Shell.left-size = clamp(self.start + travel, 160px, 640px);
                    }
                    released => {
                        Shell.dock-resized("left", Shell.left-size);
                    }
                }
                VerticalLayout {
                    area := EditorArea { }
                    if Shell.bottom-open: Splitter {
                        property <length> start;
                        vertical: false;
                        pressed => {
                            self.start = Shell.bottom-size;
                        }
                        dragged(travel) => {
                            Shell.bottom-size = clamp(self.start - travel, 100px, 800px);
                        }
                        released => {
                            Shell.dock-resized("bottom", Shell.bottom-size);
                        }
                    }
                    if Shell.bottom-open: BottomDock {
                        height: Shell.bottom-size;
                    }
                }
                if Shell.right-open: Splitter {
                    property <length> start;
                    pressed => {
                        self.start = Shell.right-size;
                    }
                    dragged(travel) => {
                        Shell.right-size = clamp(self.start - travel, 240px, 900px);
                    }
                    released => {
                        Shell.dock-resized("right", Shell.right-size);
                    }
                }
                if Shell.right-open: RightDock {
                    width: Shell.right-size;
                }
            }
            StatusBar { }
        }
    }

    // A tab being dragged (`src/app/tab_drag.rs` places all three): the
    // overlay over the code it would take, the marker in the strip's gap it
    // would go in, and its name beside the pointer.
    if Shell.tab-drag.on && Shell.tab-drag.overlay: Rectangle {
        x: Shell.tab-drag.overlay-x;
        y: Shell.tab-drag.overlay-y;
        width: Shell.tab-drag.overlay-w;
        height: Shell.tab-drag.overlay-h;
        background: Theme.slate-fill;
        border-width: 1px;
        border-color: Theme.slate;
    }
    if Shell.tab-drag.on && Shell.tab-drag.marker: Rectangle {
        x: Shell.tab-drag.marker-x;
        y: Shell.tab-drag.marker-y;
        width: 2px;
        height: Shell.tab-drag.marker-h;
        background: Theme.slate;
    }
    if Shell.tab-drag.on && Shell.tab-drag.inside: Rectangle {
        x: Shell.tab-drag.x + 14px;
        y: Shell.tab-drag.y + 10px;
        width: ghost.preferred-width + 20px;
        height: 24px;
        border-radius: 4px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        opacity: 0.9;
        ghost := Text {
            x: 10px;
            width: self.preferred-width;
            text: Shell.tab-drag.title;
            color: Theme.label;
            font-size: Theme.small;
            vertical-alignment: center;
        }
    }

    Notes {
        y: 40px;
        height: root.height - 40px - 24px;
    }

    if Shell.git-prompt-open: GitPrompt {
        x: (root.width - self.width) / 2;
        y: 64px;
    }

    if Shell.clone-open: ClonePrompt {
        x: (root.width - self.width) / 2;
        y: 64px;
    }

    if Shell.menu-open: ContextMenu { }

    if Shell.picker-open: Picker {
        init => {
            self.focus-field();
        }
    }

    Tooltip { }
}
