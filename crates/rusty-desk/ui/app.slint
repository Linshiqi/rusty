// The window: the title bar, the three docks around the editor area, the
// status bar, and what floats over them. docs/slint.md has the design.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Splitter, Tip } from "widgets.slint";
import { Shell, PanelTab, DocTab, TreeRow, PickRow, KeyRow, Note, Recent, ProblemRow, OutputLine, EnvRow, WizRow, WizFact, WizNote, PlaygroundCard, BoardWire, BoardWord, BoardLamp, BoardSwitch, BoardShape, BoardScreen, BoardRotor, BoardControl, BoardPart, BoardProp, LibraryRow, PlotCurve, PlotTunable, WaveLane, WaveTick, DrawRow, DrawPiece, FlightAxis, FlightMotor, DebugFrame, DebugVariable, CallLine, RegField, RegRow, SearchRow, TermSpan, TermRow, GitChange, GitStash, GitRef, GitLane, GitLabel, GitCommitRow, GitFile, DiffRow, MenuItem, MemBuild, MemCrate, MemSection, CrateVital, CrateDep, CrateDup, FeatPackage, FeatRow, DiskTree, DiskItemRow, DiskIdle, CodeSpan, CodeLine, MdCell, MdRow, MdBlock, AiEntry, MathRow, MathStep, MathLine, LabSource, LabPreset, LabConsole, LabLane, LabRecord, LabTick, LabDot, LabParam } from "shell.slint";
import { Code, Find, Shade, Row, Piece, HoverProblem, HoverFix, CompletionRow } from "editor.slint";
import { TitleBar } from "titlebar.slint";
import { LeftDock, BottomDock, RightDock } from "docks.slint";
import { EditorArea } from "pages.slint";
import { StatusBar, Picker, Notes, Tooltip, ContextMenu } from "chrome.slint";
import { GitPrompt, ClonePrompt } from "git.slint";

export { Theme, Icons, Shell, Code, Find, Shade, Tip, Row, Piece, HoverProblem, HoverFix, CompletionRow, PanelTab, DocTab, TreeRow, PickRow, KeyRow, Note, Recent, ProblemRow, OutputLine, EnvRow, WizRow, WizFact, WizNote, PlaygroundCard, BoardWire, BoardWord, BoardLamp, BoardSwitch, BoardShape, BoardScreen, BoardRotor, BoardControl, BoardPart, BoardProp, LibraryRow, PlotCurve, PlotTunable, WaveLane, WaveTick, DrawRow, DrawPiece, FlightAxis, FlightMotor, DebugFrame, DebugVariable, CallLine, RegField, RegRow, SearchRow, TermSpan, TermRow, GitChange, GitStash, GitRef, GitLane, GitLabel, GitCommitRow, GitFile, DiffRow, MenuItem, MemBuild, MemCrate, MemSection, CrateVital, CrateDep, CrateDup, FeatPackage, FeatRow, DiskTree, DiskItemRow, DiskIdle, CodeSpan, CodeLine, MdCell, MdRow, MdBlock, AiEntry, MathRow, MathStep, MathLine, LabSource, LabPreset, LabConsole, LabLane, LabRecord, LabTick, LabDot, LabParam }

export component AppWindow inherits Window {
    // What the task bar calls the window: the file, the project, rusty.
    in property <string> caption: "rusty";
    title: root.caption;
    icon: @image-url("../icons/rusty.png");
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.window;
    default-font-size: Theme.body;

    // What the editor measures its characters with (`src/editor/metrics.rs`).
    in property <string> probe-text;
    out property <length> probe-width: probe.preferred-width;

    public function focus-code() {
        area.focus-code();
    }

    public function focus-find(replace: bool) {
        area.focus-find(replace);
    }

    public function focus-window() {
        scope.focus();
    }

    probe := Text {
        visible: false;
        text: root.probe-text;
        font-family: Theme.mono;
        font-size: Code.font-size;
    }

    // Keys nothing focused took arrive here, and the bindings get them.
    scope := FocusScope {
        key-pressed(event) => {
            if (Shell.key(event)) {
                return accept;
            }
            reject
        }
        // Ctrl let go wherever the keys are: a name drawn as a link under a
        // pointer that has not moved is put away with it.
        key-released(event) => {
            Code.key-released(event);
            reject
        }

        VerticalLayout {
            TitleBar {
                maximized: root.maximized;
                minimize => {
                    root.minimized = true;
                }
                toggle-maximize => {
                    root.maximized = !root.maximized;
                }
                close => {
                    root.close();
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                if Shell.left-open: LeftDock {
                    width: Shell.left-size;
                }
                if Shell.left-open: Splitter {
                    property <length> start;
                    pressed => {
                        self.start = Shell.left-size;
                    }
                    dragged(travel) => {
                        Shell.left-size = clamp(self.start + travel, 160px, 640px);
                    }
                    released => {
                        Shell.dock-resized("left", Shell.left-size);
                    }
                }
                VerticalLayout {
                    area := EditorArea { }
                    if Shell.bottom-open: Splitter {
                        property <length> start;
                        vertical: false;
                        pressed => {
                            self.start = Shell.bottom-size;
                        }
                        dragged(travel) => {
                            Shell.bottom-size = clamp(self.start - travel, 100px, 800px);
                        }
                        released => {
                            Shell.dock-resized("bottom", Shell.bottom-size);
                        }
                    }
                    if Shell.bottom-open: BottomDock {
                        height: Shell.bottom-size;
                    }
                }
                if Shell.right-open: Splitter {
                    property <length> start;
                    pressed => {
                        self.start = Shell.right-size;
                    }
                    dragged(travel) => {
                        Shell.right-size = clamp(self.start - travel, 240px, 900px);
                    }
                    released => {
                        Shell.dock-resized("right", Shell.right-size);
                    }
                }
                if Shell.right-open: RightDock {
                    width: Shell.right-size;
                }
            }
            StatusBar { }
        }
    }

    Notes {
        y: 40px;
        height: root.height - 40px - 24px;
    }

    if Shell.git-prompt-open: GitPrompt {
        x: (root.width - self.width) / 2;
        y: 64px;
    }

    if Shell.clone-open: ClonePrompt {
        x: (root.width - self.width) / 2;
        y: 64px;
    }

    if Shell.menu-open: ContextMenu { }

    if Shell.picker-open: Picker {
        init => {
            self.focus-field();
        }
    }

    Tooltip { }
}
