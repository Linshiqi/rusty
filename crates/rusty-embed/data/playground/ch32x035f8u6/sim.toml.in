# The playground's board: an LED on PB12 behind the resistor it needs, and
# a push button from PB1 to ground. Change it right here on the sheet —
# drag parts in from the library, wire pin to pin — and the firmware sees
# it on the next Run.
version = 2

[board]
chip = "ch32x035f8u6"
x = 460
y = 96

[[part]]
ref = "R1"
symbol = "Device:R"
value = "220"
x = 680
y = 176
rot = 90

[[part]]
ref = "D1"
symbol = "Device:LED"
value = "red"
x = 776
y = 176
# A red LED drops about two volts, which is what lets the sheet say how
# much current the resistor lets through it.
props = { vf = "2.0" }

[[part]]
ref = "SW1"
symbol = "Device:SW_Push"
x = 360
y = 278
rot = 270

# PB12 is on the right of the header and PB1 on the left, so the LED sits
# to the right and the button to the left, each wired to the GND on its own
# side: the one on the right is row 22, the one on the left is row 11.
[[wire]]
from = "U1.PB12"
to = "R1.1"
[[wire]]
from = "R1.2"
to = "D1.A"
[[wire]]
from = "D1.K"
to = "U1.22"
[[wire]]
from = "U1.PB1"
to = "SW1.2"
[[wire]]
from = "SW1.1"
to = "U1.11"
