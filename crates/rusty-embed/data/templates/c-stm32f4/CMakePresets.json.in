{
  "version": 3,
  "configurePresets": [
    {
      "name": "firmware",
      "displayName": "@PART@",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/rusty-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "firmware",
      "configurePreset": "firmware"
    }
  ]
}
