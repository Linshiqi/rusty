/* @PART@: what runs before main — the vector table the core reads at
   reset, and the copying of .data and clearing of .bss that C expects to
   have happened. It is this project's: change it as you like. */

#include <stdint.h>

extern uint32_t _estack[], _sidata[], _sdata[], _edata[], _sbss[], _ebss[];
extern void (*__preinit_array_start[])(void), (*__preinit_array_end[])(void);
extern void (*__init_array_start[])(void), (*__init_array_end[])(void);
int main(void);

void Reset_Handler(void);
void Default_Handler(void);

/* Every handler the program does not write stops in Default_Handler:
   define one of these names in your own code and it takes its place. */
void NMI_Handler(void) __attribute__((weak, alias("Default_Handler")));
void HardFault_Handler(void) __attribute__((weak, alias("Default_Handler")));
void MemManage_Handler(void) __attribute__((weak, alias("Default_Handler")));
void BusFault_Handler(void) __attribute__((weak, alias("Default_Handler")));
void UsageFault_Handler(void) __attribute__((weak, alias("Default_Handler")));
void SVC_Handler(void) __attribute__((weak, alias("Default_Handler")));
void DebugMon_Handler(void) __attribute__((weak, alias("Default_Handler")));
void PendSV_Handler(void) __attribute__((weak, alias("Default_Handler")));
void SysTick_Handler(void) __attribute__((weak, alias("Default_Handler")));

/* The nRF52840's interrupt positions, after the core's sixteen. An
   interrupt is given its handler by putting the function in its slot. */
#define IRQS 48

__attribute__((section(".vectors"), used))
void (*const vectors[16 + IRQS])(void) = {
    [0] = (void (*)(void))_estack,
    [1] = Reset_Handler,
    [2] = NMI_Handler,
    [3] = HardFault_Handler,
    [4] = MemManage_Handler,
    [5] = BusFault_Handler,
    [6] = UsageFault_Handler,
    [11] = SVC_Handler,
    [12] = DebugMon_Handler,
    [14] = PendSV_Handler,
    [15] = SysTick_Handler,
    [16 ... 16 + IRQS - 1] = Default_Handler,
};

void Reset_Handler(void)
{
    uint32_t *from = _sidata;
    for (uint32_t *to = _sdata; to < _edata;) {
        *to++ = *from++;
    }
    for (uint32_t *to = _sbss; to < _ebss;) {
        *to++ = 0;
    }

    /* The floating-point unit is off at reset, and this project is compiled
       to use it (-mfloat-abi=hard): CPACR gives CP10 and CP11 full access
       before any float runs. */
    *(volatile uint32_t *)0xE000ED88 |= 0xFu << 20;
    __asm volatile("dsb");
    __asm volatile("isb");

    /* Constructors — C++'s, and __attribute__((constructor))'s — as
       newlib's __libc_init_array would run them. Not that function: it
       wants newlib's start-up files, and those bring exit(), stdio's
       clean-up and the system calls a bare part does not have. */
    for (void (**f)(void) = __preinit_array_start; f < __preinit_array_end; f++) {
        (*f)();
    }
    for (void (**f)(void) = __init_array_start; f < __init_array_end; f++) {
        (*f)();
    }

    main();
    for (;;) {
    }
}

/* A fault or an interrupt nobody handles ends here. A debugger stopped in
   this loop shows which in the core's IPSR register. */
void Default_Handler(void)
{
    for (;;) {
    }
}
