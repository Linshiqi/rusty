# The playground's board: an LED on GPIO0 behind the resistor it needs, and
# a push button from GPIO4 to ground. Change it right here on the sheet —
# drag parts in from the library, wire pin to pin — and the firmware sees
# it on the next Run.
version = 2

[board]
chip = "esp32c3"
x = 460
y = 96

[[part]]
ref = "R1"
symbol = "Device:R"
value = "220"
x = 312
y = 176
rot = 90

[[part]]
ref = "D1"
symbol = "Device:LED"
value = "red"
x = 216
y = 176
# A red LED drops about two volts, which is what lets the sheet say how
# much current the resistor lets through it.
props = { vf = "2.0" }

[[part]]
ref = "SW1"
symbol = "Device:SW_Push"
x = 312
y = 256

# GND sits twice on this devkit's header; the one on the left is row 13.
[[wire]]
from = "U1.GPIO0"
to = "R1.1"
[[wire]]
from = "R1.2"
to = "D1.A"
[[wire]]
from = "D1.K"
to = "U1.13"
[[wire]]
from = "U1.GPIO4"
to = "SW1.2"
[[wire]]
from = "SW1.1"
to = "U1.13"
