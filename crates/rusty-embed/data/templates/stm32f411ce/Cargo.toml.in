[package]
edition = "2024"
name = "playground"
version = "0.1.0"

[dependencies]
embassy-stm32 = { version = "0.6.0", features = ["stm32f411ce", "memory-x", "time-driver-any", "exti", "defmt"] }
embassy-executor = { version = "0.10.0", features = ["platform-cortex-m", "executor-thread", "defmt"] }
embassy-time = { version = "0.5.1", features = ["defmt"] }
cortex-m = { version = "0.7.7", features = ["inline-asm", "critical-section-single-core"] }
cortex-m-rt = "0.7.5"
defmt = "1.0.1"
defmt-rtt = "1.0.0"
panic-probe = { version = "1.0.0", features = ["print-defmt"] }

# Made for editing: quick to rebuild, and debuggable on the part.
[profile.release]
debug = 2
lto = false
incremental = true
