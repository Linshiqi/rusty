/* The RP2040 on a Raspberry Pi Pico: 2 MB of external flash, the first
 * 256 bytes of it the second-stage bootloader, and 264 KB of SRAM. */
MEMORY {
    BOOT2 : ORIGIN = 0x10000000, LENGTH = 0x100
    FLASH : ORIGIN = 0x10000100, LENGTH = 2048K - 0x100
    RAM   : ORIGIN = 0x20000000, LENGTH = 256K
    SRAM4 : ORIGIN = 0x20040000, LENGTH = 4K
    SRAM5 : ORIGIN = 0x20041000, LENGTH = 4K
}

/* The second-stage bootloader embassy-rp carries goes in the first 256
 * bytes of flash, where the boot ROM loads it from. */
SECTIONS {
    .boot2 ORIGIN(BOOT2) :
    {
        KEEP(*(.boot2));
    } > BOOT2
} INSERT BEFORE .text;
