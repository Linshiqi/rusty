//! Link scripts for the binary: cortex-m-rt's and defmt's. The second-stage
//! bootloader is placed by memory.x, not by embassy-rp's `link-rp.x`: that
//! script has no `INSERT`, and rust-lld then puts `.boot2` after the code,
//! where the boot ROM never looks. `--nmagic` because the flash and RAM
//! regions are not page aligned.

fn main() {
    println!("cargo:rustc-link-arg-bins=--nmagic");
    println!("cargo:rustc-link-arg-bins=-Tlink.x");
    println!("cargo:rustc-link-arg-bins=-Tdefmt.x");
}
