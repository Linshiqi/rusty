//! Link scripts for the binary: cortex-m-rt's, defmt's, and the HAL's own
//! where it has one. `--nmagic` because the flash and RAM regions are not
//! page aligned.

fn main() {
    println!("cargo:rustc-link-arg-bins=--nmagic");
    println!("cargo:rustc-link-arg-bins=-Tlink.x");
    println!("cargo:rustc-link-arg-bins=-Tdefmt.x");
}
